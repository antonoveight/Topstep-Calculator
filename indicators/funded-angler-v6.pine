plot(earlyResult.hit ? earlyResult.inv : na, "Early C2 locked SL", display=display.data_window)
plot(earlyResult.hit ? earlyResult.cp : na, "Early C2 locked TP", display=display.data_window)
plot(earlyResult.hit ? earlyResult.confirmTime : na, "Early C2 TS open ms", display=display.data_window)



if barstate.islast
    bool hasModel = rangeAvailable
    if showPanel
        string dirText = biasPaused ? "B0!" : biasDir == 1 ? "B+" : biasDir == -1 ? "B-" : "B0"
        string stateText = not hasModel ? "SEARCH" : not focusAvailable ? "WATCH" : sModelAge > 0 ? "TRACK" : alreadyEmitted ? "SIGNAL" : "ENTRY"
        array<string> headings = array.from("TF", "CRT", "BIAS", "REF", "T", "ENTRY", "N", "WHY", "DATA", "EARLY", "MPS")
        array<string> values = array.from(htf + " / " + timeframe.period + (overviewMode ? " VIEW" : ""), (hasModel ? (sDir == 1 ? "BUY" : "SELL") : "-") + " | " + str.tostring(hasModel ? sCount : 0), dirText + " / " + biasTf, hasModel and not na(kCrtKey) and kCrtKey.kind > 0 ? f_keyTag(kCrtKey) : "-", crtTimeText, stateText, "C " + str.tostring(crtSignals) + " H " + str.tostring(higherSignals), lastClosedStatus + (barstate.isconfirmed ? "" : " *"), str.format_time(dataStart, "dd/MM", NY) + "-" + str.format_time(time, "dd/MM", NY), earlyResult.status + " | " + str.tostring(earlySignals), (not na(crtState.mpsAt) ? f_tfName(htf) + ":OK" : f_tfName(htf) + ":WAIT") + " / " + (not na(higherState.mpsAt) ? f_tfName(largerTf) + ":OK" : f_tfName(largerTf) + ":WAIT"))
        for row = 0 to 10
            table.cell(panel, 0, row, " " + array.get(headings, row) + " ", text_color=color.silver, text_size=dashboardFont)
            table.cell(panel, 1, row, " " + array.get(values, row) + " ", text_color=row == 2 ? (biasDir == 1 ? color.teal : biasDir == -1 ? color.orange : color.silver) : color.silver, text_size=dashboardFont, tooltip=row == 0 ? syminfo.tickerid + " | H2/H4 clock: " + (ticker.standard(syminfo.main_tickerid) == "OANDA:XAUUSD" ? htfClock : "Native") + " | 17:00 America/Chicago regular session; OANDA prices remain OANDA. H1/D1 native; holidays may differ." : row == 10 ? "MPS is required for OTE only. TS/FVG can precede it. " + diagnosticSummary : row == 1 ? "Last model end: " + f_endTag(lastSetupEnd) + " | Parent C1 stays until its target is taken. INV ends only this attempt; Only original C3 can replace the raid once, with original key and close inside C1. TRACK after entry window; no automatic C3 expiry. Not fills." : row == 2 ? "Confirmed structure: " + str.tostring(structureBias) + " | Guard H " + str.tostring(autoGuardHigh, format.mintick) + " L " + str.tostring(autoGuardLow, format.mintick) + (biasPaused ? " | paused by closed chart bar; no opposite bias assumed" : "") : row == 9 ? "Experimental C2, not HTF confirmed. Key on same HTF before C2. At most one E per C2; locked reference SL/TP. No Replay certification." : row == 7 ? lastClosedAudit + "\n" + diagnosticSummary + "\nCurrent observation: " + f_barrierNote(crtState) : row == 6 ? "C = main HTF, H = larger HTF. Separate source event counts; a merged marker may count once in each source. Closed LTF in a live CRT attempt; not fills or win-rate." : "")

// Bounded display renderer. Source data and signals are computed above.
f_putVisual(array<ClockCandle> candles, ClockCandle item, int afterTime = na) =>
    if not na(item) and not na(item.t) and not na(item.o) and (na(afterTime) or item.t >= afterTime)
        bool exists = false
        int insertion = array.size(candles)
        if array.size(candles) > 0
            for j = 0 to array.size(candles) - 1
                if array.get(candles, j).t == item.t
                    exists := true
                    break
                if array.get(candles, j).t > item.t
                    insertion := j
                    break
        if not exists
            array.insert(candles, insertion, item)
f_cachedOrigin(int sourceTime, float price) =>
    int found = sourceTime
    int cached = array.indexof(candleTimes, sourceTime)
    if cached >= 0
        if math.abs(price - array.get(candleHighs, cached)) < syminfo.mintick * 0.5
            found := array.get(candleHighTimes, cached)
        else if math.abs(price - array.get(candleLows, cached)) < syminfo.mintick * 0.5
            found := array.get(candleLowTimes, cached)
    found
var float displayHigh = na
var float displayLow = na
if time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
    displayHigh := na(displayHigh) ? high : math.max(displayHigh, high)
    displayLow := na(displayLow) ? low : math.min(displayLow, low)
float displayPad = math.max(nz(displayHigh - displayLow, high - low) * 0.04, nz(ta.atr(14), high - low) * 0.5, syminfo.mintick * 12)
if barstate.islast
    // Five unique prices: TGT is always the opposite C1 boundary.
    array<float> prices = array.from(sHi, sLo, (sHi + sLo) / 2, focusAvailable ? sInv : na, not na(kCrtKey) and kCrtKey.kind > 0 ? (kCrtKey.hi + kCrtKey.lo) / 2 : na)
    array<string> captions = array.from(sDir == 1 ? "CRTH / TGT" : "CRTH", sDir == -1 ? "CRTL / TGT" : "CRTL", sEqTouched ? "EQ*" : "EQ", "INV", "KEY " + f_keyTag(kCrtKey))
    array<color> shades = array.from(sDir == 1 ? color.aqua : color.orange, sDir == -1 ? color.aqua : color.teal, color.gray, color.red, color.purple)
    array<int> starts = array.from(sAT, sAT, sAT, sBT, not na(kCrtKey) ? nz(kCrtKey.leftTime, kCrtKey.born) : na)
    // Merge coincident key/range prices instead of stacking labels.
    for i = 1 to 4
        for j = 0 to i - 1
            if not na(array.get(prices, i)) and not na(array.get(prices, j)) and math.abs(array.get(prices, i) - array.get(prices, j)) < syminfo.mintick * 0.5
                array.set(captions, j, array.get(captions, j) + " · " + array.get(captions, i))
                array.set(prices, i, na)
    int endIndex = math.min(bar_index + drawSpan, drawingClipIndex)
    int endTime = time + int((endIndex - bar_index) * chartSeconds * 1000)
    array<int> rows = array.sort_indices(prices, order.ascending)
    float previousY = na
    for orderIndex = 0 to 4
        int i = array.get(rows, orderIndex)
        float price = array.get(prices, i)
        bool visible = showLevels and rangeAvailable and not na(price) and not na(array.get(starts, i))
        line ln = array.get(levelLines, i)
        label lb = array.get(levelLabels, i)
        line leader = array.get(labelLeaders, i)
        line.set_color(ln, color.new(color.gray, 100))
        line.set_color(leader, color.new(color.gray, 100))
        label.set_text(lb, "")
        if visible
            int startTime = i == 2 or i == 4 ? array.get(starts, i) : f_cachedOrigin(array.get(starts, i), price)
            float labelY = na(previousY) ? price : math.max(price, previousY + displayPad)
            line.set_xy1(ln, startTime, price)
            line.set_xy2(ln, endTime, price)
            line.set_color(ln, array.get(shades, i))
            label.set_xy(lb, endIndex + 2, labelY)
            label.set_text(lb, array.get(captions, i))
            label.set_textcolor(lb, array.get(shades, i))
            label.set_size(lb, chartFont)
            label.set_tooltip(lb, array.get(captions, i) + " · " + str.tostring(price, format.mintick))
            if math.abs(labelY - price) > syminfo.mintick * 0.5
                line.set_xy1(leader, endIndex, price)
                line.set_xy2(leader, endIndex + 1, labelY)
                line.set_color(leader, color.new(chart.fg_color, 45))
            previousY := labelY
    array<ClockCandle> mainVisual = array.new<ClockCandle>()
    array<ClockCandle> archiveVisual = array.new<ClockCandle>()
    array<ClockCandle> largerVisual = array.new<ClockCandle>()
    bool origin = showCluster and rangeAvailable
    if showCluster
        if origin
            f_putVisual(mainVisual, ClockCandle.new(t=sAT, e=sAEnd, o=sAO, h=sAH, l=sAL, c=sAC))
            f_putVisual(mainVisual, ClockCandle.new(t=sBT, e=sBEnd, o=sBO, h=sBH, l=sBL, c=sBC))
            f_putVisual(mainVisual, ClockCandle.new(t=sCT, e=sCEnd, o=sCO, h=sCH, l=sCL, c=sCC), sBEnd)
        if not na(mainPreview)
            f_putVisual(mainVisual, mainPreview.third, origin ? sBEnd : na)
            f_putVisual(mainVisual, mainPreview.second, origin ? sBEnd : na)
            f_putVisual(mainVisual, mainPreview.first, origin ? sBEnd : na)
        if origin and array.size(candleTimes) > 0
            for i = 0 to array.size(candleTimes) - 1
                f_putVisual(mainVisual, ClockCandle.new(t=array.get(candleTimes, i), e=array.get(candleEndTimes, i), o=array.get(candleOpens, i), h=array.get(candleHighs, i), l=array.get(candleLows, i), c=array.get(candleCloses, i)), sBEnd)
        if liveComplete
            f_putVisual(mainVisual, ClockCandle.new(t=liveT, e=liveEnd, o=liveO, h=liveH, l=liveL, c=liveC), origin ? sBEnd : na)
        while origin and array.size(mainVisual) > 2 + clusterFollowCount
            array.remove(mainVisual, 2)
    if showCluster and showArchive and not na(visibleArchive) and not na(visibleArchive.aT)
        f_putVisual(archiveVisual, ClockCandle.new(t=visibleArchive.aT, e=visibleArchive.aEnd, o=visibleArchive.aO, h=visibleArchive.aH, l=visibleArchive.aL, c=visibleArchive.aC))
        f_putVisual(archiveVisual, ClockCandle.new(t=visibleArchive.bT, e=visibleArchive.bEnd, o=visibleArchive.bO, h=visibleArchive.bH, l=visibleArchive.bL, c=visibleArchive.bC))
        f_putVisual(archiveVisual, ClockCandle.new(t=visibleArchive.cT, e=visibleArchive.cEnd, o=visibleArchive.cO, h=visibleArchive.cH, l=visibleArchive.cL, c=visibleArchive.cC))
    if showCluster and showLargerCluster and not na(largerPreview)
        f_putVisual(largerVisual, largerPreview.third)
        f_putVisual(largerVisual, largerPreview.second)
        f_putVisual(largerVisual, largerPreview.first)
        if largerComplete
            f_putVisual(largerVisual, ClockCandle.new(t=largerLiveT, e=largerEnd, o=largerLiveO, h=largerLiveH, l=largerLiveL, c=largerLiveC))
    int countMain = array.size(mainVisual)
    int countArchive = array.size(archiveVisual)
    int countLarger = array.size(largerVisual)
    int total = countMain + countArchive + countLarger
    int groups = (countMain > 0 ? 1 : 0) + (countArchive > 0 ? 1 : 0) + (countLarger > 0 ? 1 : 0)
    int between = math.max(clusterOffset, labelLaneBars + 12)
    int splitGap = origin and countMain > 2 ? 10 : 0
    int room = 480 - (clusterStartIndex - bar_index) - math.max(0, groups - 1) * between - splitGap
    int stride = math.max(3, math.min(clusterWidth + 3, int(math.floor(room / math.max(1, total)))))
    int bodyWidth = math.max(2, int(math.floor(math.min(clusterWidth, stride - 1) / 2)) * 2)
    while array.size(clusterBodies) < total
        array.push(clusterBodies, box.new(bar_index, high, bar_index, low, force_overlay=true))
        array.push(clusterWicks, line.new(bar_index, high, bar_index, low, force_overlay=true, width=1))
    while array.size(clusterBodies) > total
        box.delete(array.pop(clusterBodies))
        line.delete(array.pop(clusterWicks))
    int used = 0
    int cursor = clusterStartIndex
    for group = 0 to 2
        array<ClockCandle> candles = group == 0 ? mainVisual : group == 1 ? archiveVisual : largerVisual
        label heading = array.get(groupLabels, group * 2)
        label clock = array.get(groupLabels, group * 2 + 1)
        label.set_text(heading, "")
        label.set_text(clock, "")
        if array.size(candles) > 0
            float groupHigh = na
            float groupLow = na
            int firstX = cursor
            int lastX = cursor
            for j = 0 to array.size(candles) - 1
                ClockCandle item = array.get(candles, j)
                if group == 0 and origin and j == 2
                    cursor += splitGap
                int center = cursor
                color shade = item.c >= item.o ? color.teal : chart.fg_color
                bool archived = group == 1
                box body = array.get(clusterBodies, used)
                line wick = array.get(clusterWicks, used)
                box.set_lefttop(body, center - int(bodyWidth / 2), math.max(item.o, item.c))
                box.set_rightbottom(body, center + int(bodyWidth / 2), math.min(item.o, item.c))
                box.set_bgcolor(body, color.new(shade, archived ? 75 : 0))
                box.set_border_color(body, color.new(shade, archived ? 65 : 0))
                box.set_text(body, "")
                line.set_xy1(wick, center, item.h)
                line.set_xy2(wick, center, item.l)
                line.set_color(wick, color.new(shade, archived ? 70 : 25))
                line.set_width(wick, 1)
                groupHigh := na(groupHigh) ? item.h : math.max(groupHigh, item.h)
                groupLow := na(groupLow) ? item.l : math.min(groupLow, item.l)
                lastX := center
                cursor += stride
                used += 1
            float headingY = math.min(groupHigh + displayPad, nz(displayHigh, groupHigh))
            int headingX = headingY < groupHigh + displayPad ? firstX - int(bodyWidth / 2) - 2 : int((firstX + lastX) / 2)
            label.set_xy(heading, headingX, headingY)
            label.set_text(heading, group == 1 ? "LAST " + f_tfName(htf) : f_tfName(group == 2 ? largerTf : htf))
            label.set_textcolor(heading, chart.fg_color)
            label.set_size(heading, chartFont)
            ClockCandle firstCandle = array.get(candles, 0)
            ClockCandle latestCandle = array.get(candles, array.size(candles) - 1)
            string sourceTf = group == 2 ? largerTf : htf
            string clockName = (group == 2 ? f_alignedTf(largerTf) : f_alignedTf(htf)) ? "17:00 Chicago" : "Native"
            string headingHint = syminfo.tickerid + " · " + f_tfName(sourceTf) + " · " + clockName + " clock"
            headingHint += "\n" + (group == 0 and origin or group == 1 ? "C1 " : "Recent ") + str.format_time(firstCandle.t, "dd/MM HH:mm", "Asia/Ho_Chi_Minh") + " → " + str.format_time(firstCandle.e, "dd/MM HH:mm", "Asia/Ho_Chi_Minh") + " UTC+7"
            headingHint += "\nLatest " + str.format_time(latestCandle.t, "dd/MM HH:mm", "Asia/Ho_Chi_Minh") + " → " + str.format_time(latestCandle.e, "dd/MM HH:mm", "Asia/Ho_Chi_Minh") + " UTC+7 | O " + str.tostring(latestCandle.o, format.mintick) + " H " + str.tostring(latestCandle.h, format.mintick) + " L " + str.tostring(latestCandle.l, format.mintick) + " C " + str.tostring(latestCandle.c, format.mintick)
            label.set_tooltip(heading, headingHint + (group == 1 ? "\nEnded " + f_endTag(visibleArchive.endReason) : "\nChart prices; not MGC OHLC"))
            bool livePresent = group == 0 ? liveComplete and array.get(candles, array.size(candles) - 1).t == liveT : group == 2 ? largerComplete and array.get(candles, array.size(candles) - 1).t == largerLiveT : false
            if livePresent
                label.set_xy(clock, lastX, groupLow - displayPad * 1.5)
                label.set_text(clock, f_countdown(group == 2 ? largerEnd : liveEnd, timenow))
                label.set_textcolor(clock, chart.fg_color)
                label.set_size(clock, chartFont)
            cursor += between

bool modelEvent = changedModel and focusAvailable and sModelAge == 0 and barstate.isconfirmed
alertcondition(modelEvent, "HTF", "TFA CRT: C2 confirmed; observe C3.")
alertcondition(modelEvent and sPhase == 1, "TS", "TFA CRT: confirmed one-sided HTF sweep and reclaim. Observe C3.")
alertcondition(entryLong, "E+", "TFA CRT Pure TS: confirmed LTF Buy signal in a live CRT setup. See tooltip.")
alertcondition(entryShort, "E-", "TFA CRT Pure TS: confirmed LTF Sell signal in a live CRT setup. See tooltip.")

alertcondition(higherResult.hit and higherResult.dir == 1, "Higher HTF E+", "TFA: independent higher HTF Buy confirmation. See source timeframe tooltip.")
alertcondition(higherResult.hit and higherResult.dir == -1, "Higher HTF E-", "TFA: independent higher HTF Sell confirmation. See source timeframe tooltip.")

alertcondition(earlyResult.hit and earlyResult.dir == 1, "Early C2 E+ · experimental", "TFA Early C2 Buy: provisional C2, not HTF confirmed. See E tooltip.")
alertcondition(earlyResult.hit and earlyResult.dir == -1, "Early C2 E- · experimental", "TFA Early C2 Sell: provisional C2, not HTF confirmed. See E tooltip.")

alertcondition((crtState.mpsEvent and sDir == 1) or (higherState.mpsEvent and higher.dir == 1), "MPS +", "TFA: bullish MPS observed. Start looking for entry; this is not an entry alert. See source tooltip.")
alertcondition((crtState.mpsEvent and sDir == -1) or (higherState.mpsEvent and higher.dir == -1), "MPS -", "TFA: bearish MPS observed. Start looking for entry; this is not an entry alert. See source tooltip.")
