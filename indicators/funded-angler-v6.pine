indicator("The Funded Angler v6 - CRT Pure TS", shorttitle="TFA v6", calc_bars_count=600, overlay=true, scale=scale.none, behind_chart=false, max_bars_back=5000, max_lines_count=500, max_boxes_count=500, max_labels_count=300)

