    largerLiveL := low
    largerLiveC := close
    largerComplete := time == largerBucket
else
    largerLiveH := math.max(largerLiveH, high)
    largerLiveL := math.min(largerLiveL, low)
    largerLiveC := close


// The HTF snapshot is immutable. A chart-side latch retires it on CLOSED LTF
// evidence without waiting for the forming HTF candle to close or rewriting history.
type FocusLifecycle
    int uid = na
    int reason = 0
    int confirmation = na
    bool rangeDone = false
    int endedAt = na
    ModelArchive archived = na

f_stepFocus(FocusLifecycle state, int uid, int direction, int confirmedAt, float invalidation, float targetLevel, int age, int barOpen, int barClose, float barHigh, float barLow, bool closedBar, bool attemptOpen = true) =>
    int endedNow = 0
    if not na(uid) and (na(state.uid) or state.uid != uid)
        state.uid := uid
        state.rangeDone := false
        state.confirmation := na
    if not na(uid) and (na(state.confirmation) or state.confirmation != confirmedAt)
        state.confirmation := confirmedAt
        state.reason := 0
        state.endedAt := na
    if not na(uid) and closedBar and barOpen >= confirmedAt and (direction == 1 ? barHigh >= targetLevel : barLow <= targetLevel)
        state.rangeDone := true
    if not na(uid) and state.reason == 0 and closedBar and attemptOpen
        bool older = barOpen >= confirmedAt
        int reason = f_crtEnd(direction, invalidation, targetLevel, barHigh, barLow, na, older, false, false, false)
        if reason != 0
            state.reason := reason
            state.endedAt := barClose
            endedNow := reason
    endedNow

f_visibleArchive(ModelArchive localArchive, ModelArchive htfArchive) =>
    bool localReady = not na(localArchive) and not na(localArchive.uid)
    bool htfReady = not na(htfArchive) and not na(htfArchive.uid)
    bool preferLocal = localReady and (not htfReady or (localArchive.uid == htfArchive.uid and localArchive.confirmedAt == htfArchive.confirmedAt) or localArchive.endedAt >= htfArchive.endedAt)
    preferLocal ? localArchive : htfArchive

var FocusLifecycle focusLife = FocusLifecycle.new()
int focusEndedNow = f_stepFocus(focusLife, sId, sDir, sConfirmed, sInv, sCp, sModelAge, time, time_close, high, low, barstate.isconfirmed, sPhase == 1)
if focusEndedNow != 0
    // The local event may be mid-HTF: preserve C1/C2, never fabricate a closed C3.
    focusLife.archived := ModelArchive.new(confirmedAt=sConfirmed, aEnd=sAEnd, bEnd=sBEnd, uid=sId, flags=sFlags, kind=sKind, phase=sPhase, aO=sAO, aH=sAH, aL=sAL, aC=sAC, aT=sAT, bO=sBO, bH=sBH, bL=sBL, bC=sBC, bT=sBT, endReason=focusEndedNow, endedAt=time_close)
bool rangeAvailable = not na(sId) and not (focusLife.uid == sId and focusLife.rangeDone)
bool focusAvailable = rangeAvailable and sPhase == 1 and focusLife.uid == sId and focusLife.confirmation == sConfirmed and focusLife.reason == 0
var FocusLifecycle higherLife = FocusLifecycle.new()
int higherEndedNow = f_stepFocus(higherLife, higher.id, higher.dir, higher.confirmed, higher.inv, higher.cp, higher.age, time, time_close, high, low, barstate.isconfirmed, higher.phase == 1)
bool higherAvailable = enableLargerSignals and higherSignalTfValid and not na(higher.id) and higher.phase == 1 and not higherLife.rangeDone and higherLife.uid == higher.id and higherLife.confirmation == higher.confirmed and higherLife.reason == 0

ModelArchive visibleArchive = f_visibleArchive(focusLife.archived, sArchived)
int lastSetupEnd = not na(visibleArchive) and not na(visibleArchive.uid) ? visibleArchive.endReason : sReason


// CRT time follows the actual feed candle boundaries, including session gaps.
// No clock-hour gate: the confirmed-C2 / C3-only lifecycle gates entries.
bool timeAllowed = true
string crtTimeText = na(liveEnd) ? "-" : (rangeAvailable ? (focusAvailable ? "HTF " : "WATCH ") : "HTF ") + str.format_time(liveEnd, "HH:mm", NY) + " NY"

type SignalContext
    int age = 0
    int irlKind = 0
    CrtKey crtKey = na
    int id = na
    int kind = 0
    int flags = 0
    int phase = 0
    int dir = 0
    int confirmed = na
    int resolved = na
    float hi = na
    float lo = na
    float inv = na
    float cp = na
    float irlH = na
    float irlL = na
    int irlT = na
type ReactionState
    string key = ""
    int activatedAt = na
    int phaseAt = na
    int confirmIndex = na
    int confirmTime = na
    float confirmLevel = na
    float localExtreme = na
    bool localStopTaken = false
    bool localTargetTaken = false
    bool sent = false
    bool everSent = false
    int lastSignalBar = na
    int lastSignalTime = na
    float lastSignalHigh = na
    float lastSignalLow = na
type ChannelResult
    bool evaluated = false
    bool legDetected = false
    float referencePrice = na
    int referenceKnownAt = na
    int legKnownAt = na
    int zoneKnownAt = na
    float zoneLow = na
    float zoneHigh = na
    bool tsDetected = false
    bool retestDetected = false
    bool entryDetected = false
    bool counterBias = false
    CrtKey keyRef = na
    bool hit = false
    int dir = 0
    int kind = 0
    int flags = 0
    int phase = 0
    int id = na
    string key = ""
    string tag = ""
    string status = "WAIT"
    float cp = na
    float inv = na
    int confirmTime = na

f_contextKey(int id, int resolved, int direction) =>
    na(id) ? "" : str.tostring(id) + ":" + str.tostring(resolved) + ":" + str.tostring(direction)
f_clearReaction(ReactionState state, int phaseAt, float seedPivot, bool keepRun = false) =>
    state.phaseAt := phaseAt
    state.confirmIndex := na
    state.confirmTime := na
    state.confirmLevel := na
    state.localExtreme := na
    state.sent := false

// Personal CRT execution rule, not an attributed Romeo mechanical entry model.
// Local C1 and C2 must both form in HTF C3. Never backdate a confirmation.
f_stepChannel(SignalContext ctx, ReactionState state, float knownHigh, float knownLow, float pivotHigh, float pivotLow, bool waveAllowed = true, bool forcePullback = false, bool mpsAllowed = true) =>
    ChannelResult result = ChannelResult.new(dir=ctx.dir, kind=ctx.kind, flags=ctx.flags, phase=ctx.phase, id=ctx.id, key=state.key, cp=ctx.cp, inv=ctx.inv)
    float target = ctx.cp
    float executionSl = ctx.inv
    int activatedAt = state.activatedAt
    bool entryWindow = ctx.age == 0
    bool armed = not na(ctx.id) and ctx.kind == 1 and ctx.dir != 0
    result.status := not isLtf ? "VIEW TF" : not armed ? "NO MODEL" : not entryWindow ? "C3 CLOSED" : "WAIT CLOSE"
    if armed and barstate.isconfirmed and isLtf and entryWindow and time >= activatedAt and mpsAllowed
        result.evaluated := true
        bool bullish = ctx.dir == 1
        bool revokedPending = not state.sent and not na(state.confirmIndex) and bar_index > state.confirmIndex and (bullish ? close <= state.confirmLevel or low <= state.localExtreme : close >= state.confirmLevel or high >= state.localExtreme)
        if revokedPending
            f_clearReaction(state, time, na)
        bool sameRange = close > low[1] and close < high[1]
        bool tookLow = low <= low[1] - sweepSize
        bool tookHigh = high >= high[1] + sweepSize
        bool sourceReady = not na(time[1]) and time[1] >= activatedAt
        bool localTs = sourceReady and sameRange and (bullish ? tookLow and not tookHigh : tookHigh and not tookLow)
        bool progress = not state.everSent or (bullish ? low > state.lastSignalLow : high < state.lastSignalHigh)
        bool fresh = state.sent and signalCadence == "Fresh reaction" and time[1] > state.lastSignalTime and progress and waveAllowed
        if fresh and localTs
            f_clearReaction(state, time, na)
        if not na(target) and (bullish ? high >= target : low <= target)
            state.localTargetTaken := true
        if bullish ? low <= executionSl : high >= executionSl
            state.localStopTaken := true
        bool invalidBar = state.localStopTaken
        bool localTargetTaken = state.localTargetTaken
        bool confirmedNow = localTs and na(state.confirmIndex) and not state.sent and not invalidBar and not localTargetTaken
        if confirmedNow
            state.confirmIndex := bar_index
            state.confirmTime := time
            state.confirmLevel := bullish ? low[1] : high[1]
            state.localExtreme := bullish ? low : high
        bool hasConfirmation = not na(state.confirmIndex)
        bool retest = hasConfirmation and bar_index > state.confirmIndex and low <= state.confirmLevel + tolerance and high >= state.confirmLevel - tolerance and (bullish ? close > state.confirmLevel and low > state.localExtreme : close < state.confirmLevel and high < state.localExtreme)
        bool selectedEntry = (signalTiming == "Pullback" or forcePullback) ? retest : confirmedNow
        result.tsDetected := localTs
        result.retestDetected := retest
        result.entryDetected := selectedEntry
        bool opposingBias = biasDir != 0 and biasDir == -ctx.dir
        bool priorKey = not na(ctx.crtKey) and ctx.crtKey.kind == 3 and ctx.crtKey.dir == ctx.dir and not na(ctx.crtKey.knownAt) and ctx.crtKey.knownAt <= ctx.crtKey.beforeTime and ctx.crtKey.beforeTime < ctx.confirmed
        bool keyHeld = priorKey and (bullish ? close > ctx.crtKey.lo : close < ctx.crtKey.hi)
        bool counterContext = allowCrtCounter and opposingBias and priorKey and keyHeld
        bool biasAllowed = not filterBias or biasDir == ctx.dir or counterContext
        float risk = bullish ? close - executionSl : executionSl - close
        float reward = not na(target) ? (bullish ? target - close : close - target) : na
        bool alreadyEmitted = signalCadence == "One per model" ? state.everSent : state.sent
        string pendingStatus = hasConfirmation ? "WAIT RETEST" : revokedPending ? "TS RESET" : "WAIT LTF TS"
        result.status := localTargetTaken ? "CP TAKEN" : invalidBar ? "SL TOUCHED" : alreadyEmitted ? "USED" : not biasAllowed ? (opposingBias ? "NO KEY" : "BIAS") : risk <= 0 ? "INV" : reward <= 0 ? "PATH" : not selectedEntry ? pendingStatus : not waveAllowed ? "WAVE WAIT" : "READY"
        if selectedEntry and risk > 0 and not na(target) and reward > 0 and biasAllowed and timeAllowed and not invalidBar and not localTargetTaken and not alreadyEmitted and waveAllowed
            result.hit := true
            result.counterBias := counterContext
            result.keyRef := counterContext ? ctx.crtKey : na
            result.tag := "TS"
            result.confirmTime := state.confirmTime
            result.status := counterContext ? "CT SIGNAL" : "SIGNAL"
            state.sent := true
            state.everSent := true
            state.lastSignalBar := bar_index
            state.lastSignalTime := time
            state.lastSignalHigh := high
            state.lastSignalLow := low
    result


// R1 personal experiment: first-leg close + manually published reaction zone.
type R1Swing
    int side = 0
    float price = na
    int formedAt = na
    int knownAt = na
    int takenAt = na
type R1State
    string key = ""
    bool raidReady = true
    float reference = na
    int referenceKnownAt = na
    int referenceTime = na
    int raidAt = na
    int windowStart = na
    int windowEnd = na
    int expected = na
    int legStart = na
    int legKnownAt = na
    float legExtreme = na
    bool zoneSet = false
    float zoneLow = na
    float zoneHigh = na
    int zoneKnownAt = na
    string terminal = ""
type R1Bar
    int start = na
    int finish = na
    float o = na
    float h = na
    float l = na
    float c = na
    float previousClose = na
    int previousEnd = na
    bool closed = false
    bool eligible = false
    float tick = na
    int bias = 0
    bool useBias = true
    bool allowCounter = true
    bool allowedTime = true
f_r1Update(array<R1Swing> pool, float ph, float pl) =>
    if array.size(pool) > 0
        for i = 0 to array.size(pool) - 1
            R1Swing item = array.get(pool, i)
            if na(item.takenAt) and (item.side == 1 ? high >= item.price : low <= item.price)
                item.takenAt := time_close
    if not na(ph)
        array.push(pool, R1Swing.new(side=1, price=ph, formedAt=time[pivotLength], knownAt=time_close, takenAt=high >= ph ? time_close : na))
    if not na(pl)
        array.push(pool, R1Swing.new(side=-1, price=pl, formedAt=time[pivotLength], knownAt=time_close, takenAt=low <= pl ? time_close : na))
    while array.size(pool) > 512
        array.shift(pool)
    array.size(pool)
f_r1Reference(array<R1Swing> pool, int direction, int raidAt) =>
    R1Swing found = R1Swing.new()
    if not na(raidAt) and array.size(pool) > 0
        for i = 0 to array.size(pool) - 1
            R1Swing item = array.get(pool, i)
            bool eligible = item.side == direction and item.knownAt <= raidAt and (na(item.takenAt) or item.takenAt > raidAt)
            if eligible and (na(found.formedAt) or item.formedAt > found.formedAt or (item.formedAt == found.formedAt and item.knownAt > found.knownAt))
                found := item.copy()
    found
// Scan only closed LTF bars of the frozen HTF raid candle. Full contiguous source
// coverage is required; the actual first sweep bar, not the final extreme, is used.
f_r1Raid(int sourceStart, int sourceEnd, int direction, float rangeHigh, float rangeLow) =>
    int found = na
    int expected = sourceEnd
    bool gap = false
    if not na(sourceStart) and not na(sourceEnd) and sourceStart >= availableChartStart
        for offset = 0 to math.min(bar_index, 4999)
            if time[offset] < sourceStart
                break
            if time[offset] >= sourceStart and time[offset] < sourceEnd and time_close[offset] <= sourceEnd
                if time_close[offset] != expected
                    gap := true
                expected := time[offset]
                bool swept = direction == 1 ? low[offset] <= rangeLow - sweepSize : high[offset] >= rangeHigh + sweepSize
                if swept
                    found := time[offset]
                if expected == sourceStart
                    break
    bool complete = not gap and not na(expected) and expected == sourceStart
    [found, complete]
f_r1Seed(array<R1Swing> pool, string key, int sourceStart, int sourceEnd, int direction, float rh, float rl, int windowStart, int windowEnd) =>
    [raidAt, complete] = f_r1Raid(sourceStart, sourceEnd, direction, rh, rl)
    R1Swing ref = f_r1Reference(pool, direction, raidAt)
    R1State.new(key=key, raidReady=complete and not na(raidAt), reference=ref.price, referenceKnownAt=ref.knownAt, referenceTime=ref.formedAt, raidAt=raidAt, windowStart=windowStart, windowEnd=windowEnd, expected=windowStart)
// Scalar state machine: mirrored against the 64-case offline R1 specification.
f_stepR1(SignalContext ctx, R1State state, R1Bar candle, float requestedLow, float requestedHigh, int publishedAt, bool waveAllowed = true) =>
    ChannelResult result = ChannelResult.new(dir=ctx.dir, kind=ctx.kind, flags=ctx.flags, phase=ctx.phase, id=ctx.id, key=state.key, cp=ctx.cp, inv=ctx.inv, tag="R1 EXP")
    bool armed = not na(ctx.id) and ctx.kind == 1 and ctx.dir != 0
    bool up = ctx.dir == 1
    result.status := not candle.eligible ? "VIEW TF" : not armed ? "NO MODEL" : not candle.closed ? "WAIT_CLOSE" : "WAIT_LEG"
    result.evaluated := armed and candle.closed and candle.eligible and ctx.age == 0 and candle.start >= state.windowStart and candle.finish <= state.windowEnd
    if armed and candle.closed and candle.eligible
        if candle.finish <= state.windowStart
            result.status := "WAIT_HTF"
        else if state.terminal != ""
            result.status := state.terminal
        else if candle.start < state.windowStart
            state.terminal := "CONTEXT_OVERLAP"
            result.status := state.terminal
        else if ctx.age != 0 or candle.start >= state.windowEnd or candle.finish > state.windowEnd
            state.terminal := "ENTRY_EXPIRED"
            result.status := state.terminal
        else if candle.start != state.expected
            state.terminal := "DATA_GAP"
            result.status := state.terminal
        else
            state.expected := candle.finish
            bool stop = up ? candle.l <= ctx.inv : candle.h >= ctx.inv
            bool reached = up ? candle.h >= ctx.cp : candle.l <= ctx.cp
            if stop or reached
                state.terminal := stop and reached ? "AMB" : stop ? "INV" : "TARGET_TAKEN"
                result.status := state.terminal
            else if not state.raidReady
                state.terminal := "NO_RAID_DATA"
                result.status := state.terminal
            else if na(state.reference)
                state.terminal := "NO_REFERENCE"
                result.status := state.terminal
            else if up ? state.reference <= ctx.inv or state.reference >= ctx.cp : state.reference >= ctx.inv or state.reference <= ctx.cp
                state.terminal := "REFERENCE_NO_PATH"
                result.status := state.terminal
            else if na(state.legKnownAt)
                float previousPrice = candle.previousEnd == candle.start ? candle.previousClose : candle.o
                bool crossed = up ? previousPrice <= state.reference and candle.l <= state.reference and candle.c >= state.reference + candle.tick : previousPrice >= state.reference and candle.h >= state.reference and candle.c <= state.reference - candle.tick
                if crossed
                    state.legStart := candle.start
                    state.legKnownAt := candle.finish
                    state.legExtreme := up ? candle.h : candle.l
                    result.legDetected := true
                    result.status := "LEG_CONFIRMED"
            else
                if not state.zoneSet
                    if publishedAt <= 0 or publishedAt > candle.start
                        result.status := "WAIT_ZONE"
                    else
                        bool inside = not na(requestedLow) and not na(requestedHigh) and requestedLow <= requestedHigh and (up ? requestedLow > ctx.inv and requestedHigh < state.legExtreme : requestedHigh < ctx.inv and requestedLow > state.legExtreme)
                        if publishedAt < state.legKnownAt or publishedAt < state.windowStart or publishedAt >= state.windowEnd or not inside
                            state.terminal := "INVALID_ZONE"
                            result.status := state.terminal
                        else
                            state.zoneSet := true
                            state.zoneLow := requestedLow
                            state.zoneHigh := requestedHigh
                            state.zoneKnownAt := publishedAt
                if state.zoneSet and state.terminal == ""
                    bool lost = up ? candle.c <= state.zoneLow : candle.c >= state.zoneHigh
                    bool touch = candle.l <= state.zoneHigh and candle.h >= state.zoneLow
                    bool reaction = touch and (up ? candle.c > state.zoneHigh : candle.c < state.zoneLow)
                    bool opposingBias = candle.bias != 0 and candle.bias == -ctx.dir
                    bool priorKey = not na(ctx.crtKey) and ctx.crtKey.kind == 3 and ctx.crtKey.dir == ctx.dir and not na(ctx.crtKey.knownAt) and ctx.crtKey.knownAt <= ctx.crtKey.beforeTime and ctx.crtKey.beforeTime < ctx.confirmed
                    bool keyHeld = priorKey and (up ? candle.c > ctx.crtKey.lo : candle.c < ctx.crtKey.hi)
                    bool counterContext = candle.allowCounter and opposingBias and priorKey and keyHeld
                    bool biasAllowed = not candle.useBias or candle.bias == ctx.dir or counterContext
                    result.retestDetected := reaction
                    result.entryDetected := reaction
                    if lost
                        state.terminal := "ZONE_LOST"
                        result.status := state.terminal
                    else if not reaction
                        result.status := touch ? "WAIT_REACTION" : "WAIT_ZONE_TOUCH"
                    else if not biasAllowed
                        result.status := opposingBias ? "KEY_BLOCKED" : "BIAS_BLOCKED"
                    else if not waveAllowed
                        result.status := "WAVE_BLOCKED"
                    else if not candle.allowedTime
                        result.status := "TIME_BLOCKED"
                    else
                        result.hit := true
                        result.status := "SIGNAL"
                        result.counterBias := counterContext
                        result.keyRef := counterContext ? ctx.crtKey : na
                        result.confirmTime := state.legStart
                        result.referencePrice := state.reference
                        result.referenceKnownAt := state.referenceKnownAt
                        result.legKnownAt := state.legKnownAt
                        result.zoneKnownAt := state.zoneKnownAt
                        result.zoneLow := state.zoneLow
                        result.zoneHigh := state.zoneHigh
                        state.terminal := "USED"
    result

// Cache state by source/attempt: returning focus cannot emit the same R1 twice.
f_r1State(map<string, R1State> records, array<R1Swing> pool, string token, int sourceStart, int sourceEnd, int direction, float rh, float rl, int windowStart, int windowEnd) =>
    if barstate.isconfirmed and token != "" and not map.contains(records, token)
        map.put(records, token, f_r1Seed(pool, token, sourceStart, sourceEnd, direction, rh, rl, windowStart, windowEnd))
        if map.size(records) > 128
            map.remove(records, array.get(map.keys(records), 0))
    map.contains(records, token) ? map.get(records, token) : R1State.new()
f_r1Stamp(int stamp) =>
    na(stamp) ? "-" : str.format_time(stamp, "dd/MM HH:mm", NY)
f_r1Debug(R1State state) =>
    "REF " + str.tostring(state.reference, format.mintick) + " | known " + f_r1Stamp(state.referenceKnownAt) + " | raid " + f_r1Stamp(state.raidAt) + " | LEG close " + f_r1Stamp(state.legKnownAt) + " | extreme " + str.tostring(state.legExtreme, format.mintick) + " | ZONE " + str.tostring(state.zoneLow, format.mintick) + "–" + str.tostring(state.zoneHigh, format.mintick) + " | published " + f_r1Stamp(state.zoneKnownAt) + " NY"

// MPS implementation convention: HTF C1 extreme is P1; the final raid wick is P3.
// P2 must be the direct confirmed opposite swing BETWEEN P1 and P3. No fallback.
type MpsState
    float reference = na
    int referenceTime = na
    int referenceKnownAt = na
    int p1At = na
    int p3At = na
    int sourceEnd = na
    int windowStart = na
    int windowEnd = na
    int expected = na
    int activationOpen = na
    int activationAt = na
    float activationExtreme = na
    int availableAt = na
    int observedAt = na
    string terminal = ""
type MpsResult
    bool ready = false
    bool event = false
    string status = "M WAIT"
f_mpsSelect(array<R1Swing> pool, int direction, int p1At, int p3At) =>
    R1Swing found = R1Swing.new()
    if not na(p1At) and not na(p3At) and array.size(pool) > 0
        for i = 0 to array.size(pool) - 1
            R1Swing item = array.get(pool, i)
            bool inLeg = item.side == direction and item.formedAt > p1At and item.formedAt < p3At
            if inLeg and (na(found.formedAt) or item.formedAt > found.formedAt or (item.formedAt == found.formedAt and item.knownAt > found.knownAt))
                found := item.copy()
    found
f_mpsKey(SignalContext ctx, int c1Start) =>
    bool prior = not na(ctx.crtKey) and ctx.crtKey.kind == 3 and ctx.crtKey.dir == ctx.dir and not na(ctx.crtKey.knownAt) and ctx.crtKey.knownAt <= c1Start and ctx.crtKey.beforeTime == c1Start
    prior and (ctx.dir == 1 ? ctx.inv <= ctx.crtKey.lo - sweepSize : ctx.inv >= ctx.crtKey.hi + sweepSize)
f_mpsSeed(array<R1Swing> pool, SignalContext ctx, int aStart, int aEnd, int bStart, int bEnd, int windowStart, int windowEnd) =>
    MpsState state = MpsState.new(sourceEnd=bEnd, windowStart=windowStart, windowEnd=windowEnd, expected=math.max(windowStart, bEnd))
    int expectedA = aEnd
    int expectedB = bEnd
    bool gap = false
    bool up = ctx.dir == 1
    if not na(aStart) and not na(aEnd) and not na(bStart) and not na(bEnd) and aStart >= availableChartStart and f_mpsKey(ctx, aStart)
        for offset = 0 to math.min(bar_index, 4999)
            if time[offset] < aStart
                break
            if time[offset] >= aStart and time[offset] < aEnd and time_close[offset] <= aEnd
                gap := gap or time_close[offset] != expectedA
                expectedA := time[offset]
                if na(state.p1At) and (up ? low[offset] == ctx.lo : high[offset] == ctx.hi)
                    state.p1At := time[offset]
            if time[offset] >= bStart and time[offset] < bEnd and time_close[offset] <= bEnd
                gap := gap or time_close[offset] != expectedB
                expectedB := time[offset]
                if na(state.p3At) and (up ? low[offset] == ctx.inv : high[offset] == ctx.inv)
                    state.p3At := time[offset]
            if expectedA == aStart and expectedB == bStart
                break
    bool coverage = not gap and expectedA == aStart and expectedB == bStart and not na(state.p1At) and not na(state.p3At)
    R1Swing ref = f_mpsSelect(pool, ctx.dir, state.p1At, state.p3At)
    state.reference := ref.price
    state.referenceTime := ref.formedAt
    state.referenceKnownAt := ref.knownAt
    bool path = not na(ref.price) and (up ? ref.price > ctx.inv and ref.price < ctx.cp : ref.price < ctx.inv and ref.price > ctx.cp)
    state.terminal := not f_mpsKey(ctx, aStart) ? "M NO KEY" : not coverage ? "M DATA" : na(ref.price) ? "M NO P2" : ref.knownAt > state.p3At ? "M P2 LATE" : not na(ref.takenAt) and ref.takenAt <= state.p3At ? "M P2 USED" : not path ? "M PATH" : ""
    // Source activation is known only after this provisional/confirmed snapshot.
    // A later extreme replaces P3, so older pre-P3 activations cannot survive.
    if state.terminal == ""
        for offset = 0 to math.min(bar_index, 4999)
            if time[offset] < state.p3At
                break
            if time[offset] >= state.p3At and time[offset] < bEnd and time_close[offset] <= bEnd
                bool through = up ? close[offset] > ref.price : close[offset] < ref.price
                if through
                    state.activationOpen := time[offset]
                    state.activationAt := time_close[offset]
                    state.activationExtreme := up ? high[offset] : low[offset]
            if time[offset] == state.p3At
                break
        if not na(state.activationAt)
            state.availableAt := math.max(ctx.confirmed, bEnd)
    state
f_stepMps(SignalContext ctx, MpsState state, R1Bar candle) =>
    MpsResult result = MpsResult.new()
    bool armed = not na(ctx.id) and ctx.dir != 0
    bool up = ctx.dir == 1
    result.status := not candle.eligible ? "VIEW TF" : not armed ? "M NO CRT" : not candle.closed ? "WAIT CLOSE" : "M WAIT"
    if armed and candle.closed and candle.eligible
        if state.terminal != ""
            result.status := state.terminal
        else if ctx.age != 0 or candle.start >= state.windowEnd or candle.finish > state.windowEnd
            state.terminal := "M EXP"
            result.status := state.terminal
        else
            bool sourceBar = candle.finish <= state.sourceEnd
            bool gap = not sourceBar and candle.start != state.expected
            bool stopped = not sourceBar and (up ? candle.l <= ctx.inv : candle.h >= ctx.inv)
            bool target = not sourceBar and (up ? candle.h >= ctx.cp : candle.l <= ctx.cp)
            bool keyHeld = not na(ctx.crtKey) and (up ? candle.c > ctx.crtKey.hi : candle.c < ctx.crtKey.lo)
            if gap or stopped or target or not keyHeld
                state.terminal := gap ? "M GAP" : stopped and target ? "M AMB" : stopped ? "M INV" : target ? "M TG" : "M KEY LOST"
                result.status := state.terminal
            else
                state.expected := candle.finish
                bool through = up ? candle.c > state.reference : candle.c < state.reference
                if na(state.activationAt) and not sourceBar and through
                    state.activationOpen := candle.start
                    state.activationAt := candle.finish
                    state.activationExtreme := up ? candle.h : candle.l
                    state.availableAt := candle.finish
                result.ready := not na(state.availableAt)
                result.status := result.ready ? "MPS READY" : "M WAIT"
                if result.ready and na(state.observedAt)
                    result.event := true
                    state.observedAt := candle.finish
                    state.availableAt := math.max(state.availableAt, candle.finish)
    result
f_mpsState(map<string, MpsState> records, array<R1Swing> pool, string token, SignalContext ctx, int aStart, int aEnd, int bStart, int bEnd, int windowStart, int windowEnd) =>
    if barstate.isconfirmed and token != "" and not map.contains(records, token)
        map.put(records, token, f_mpsSeed(pool, ctx, aStart, aEnd, bStart, bEnd, windowStart, windowEnd))
        if map.size(records) > 128
            map.remove(records, array.get(map.keys(records), 0))
    map.contains(records, token) ? map.get(records, token) : MpsState.new()
f_mpsHandoff(R1State reaction, MpsState state) =>
    if na(reaction.legKnownAt)
        reaction.raidReady := true
        reaction.reference := state.reference
        reaction.referenceTime := state.referenceTime
        reaction.referenceKnownAt := state.referenceKnownAt
        reaction.raidAt := state.p3At
        reaction.legStart := state.activationOpen
        reaction.legKnownAt := state.availableAt
        reaction.legExtreme := state.activationExtreme
        reaction.expected := time
    reaction
f_mpsDebug(MpsState state) =>
    "P1 " + f_r1Stamp(state.p1At) + " | P2 " + str.tostring(state.reference, format.mintick) + " @ " + f_r1Stamp(state.referenceTime) + " known " + f_r1Stamp(state.referenceKnownAt) + " | P3 " + f_r1Stamp(state.p3At) + " | activation " + f_r1Stamp(state.activationAt) + " | available " + f_r1Stamp(state.availableAt) + " | observed " + f_r1Stamp(state.observedAt) + " NY | key/time interpretation: personal CRT convention; no clock-hour/SMT gate"


var float lastPivotHigh = na
var float lastPivotLow = na
var int lastPivotHighTime = na
var int lastPivotLowTime = na
var int lastBuyTime = na
var int lastSellTime = na
var int lastBuyBar = na
var int lastSellBar = na
float pivotHigh = ta.pivothigh(high, pivotLength, pivotLength)
float pivotLow = ta.pivotlow(low, pivotLength, pivotLength)
if barstate.isconfirmed
    if not na(pivotHigh)
        lastPivotHigh := pivotHigh
        lastPivotHighTime := time[pivotLength]
    if not na(pivotLow)
        lastPivotLow := pivotLow
        lastPivotLowTime := time[pivotLength]
var array<R1Swing> r1Swings = array.new<R1Swing>()
var map<string, R1State> r1States = map.new<string, R1State>()
var map<string, MpsState> mpsStates = map.new<string, MpsState>()
if (r1Mode or requireMps) and isLtf and barstate.isconfirmed
    f_r1Update(r1Swings, pivotHigh, pivotLow)
R1Bar r1Bar = R1Bar.new(start=time, finish=time_close, o=open, h=high, l=low, c=close, previousClose=close[1], previousEnd=time_close[1], closed=barstate.isconfirmed, eligible=isLtf, tick=sweepSize, bias=biasDir, useBias=filterBias, allowCounter=allowCrtCounter, allowedTime=timeAllowed)
var ReactionState crtState = ReactionState.new()
SignalContext ctx = SignalContext.new(age=sModelAge, crtKey=kCrtKey, kind=1, id=focusAvailable ? sId : na, flags=sFlags, phase=sPhase, dir=sDir, confirmed=sConfirmed, resolved=sResolved, hi=sHi, lo=sLo, inv=sInv, cp=sCp, irlH=sIrlH, irlL=sIrlL, irlT=sIrlT)
string modelKey = f_contextKey(focusAvailable ? sId : na, sResolved, sDir)
if barstate.isconfirmed and crtState.key != modelKey
    crtState := ReactionState.new(key=modelKey, activatedAt=sConfirmed, phaseAt=sConfirmed)
bool waveAllowed = sDir == 1 ? na(lastBuyTime) or bar_index == lastBuyBar or (not na(lastPivotLowTime) and lastPivotLowTime > lastBuyTime) : na(lastSellTime) or bar_index == lastSellBar or (not na(lastPivotHighTime) and lastPivotHighTime > lastSellTime)
R1State mainR1 = r1Mode and isLtf and focusAvailable ? f_r1State(r1States, r1Swings, htf + ":" + modelKey, sBT, sBEnd, sDir, sHi, sLo, bucketTime, bucketEnd) : R1State.new()
MpsState mainMps = requireMps and isLtf and focusAvailable ? f_mpsState(mpsStates, r1Swings, htf + ":" + modelKey, ctx, sAT, sAEnd, sBT, sBEnd, bucketTime, bucketEnd) : MpsState.new()
MpsResult mainMpsResult = requireMps ? f_stepMps(ctx, mainMps, r1Bar) : MpsResult.new(status="OFF")
bool mainMpsAllowed = not requireMps or (mainMpsResult.ready and time >= mainMps.availableAt)
if requireMps and mainMpsAllowed
    crtState.activatedAt := math.max(sConfirmed, mainMps.availableAt)
    if r1Mode
        mainR1 := f_mpsHandoff(mainR1, mainMps)
ChannelResult crtResult = r1Mode ? (mainMpsAllowed ? f_stepR1(ctx, mainR1, r1Bar, r1MainLow, r1MainHigh, r1MainAt, waveAllowed) : ChannelResult.new(status=mainMpsResult.status)) : f_stepChannel(ctx, crtState, lastPivotHigh, lastPivotLow, pivotHigh, pivotLow, waveAllowed, false, mainMpsAllowed)
if requireMps and not mainMpsAllowed
    crtResult.status := mainMpsResult.status
if not focusAvailable
    crtResult.status := focusLife.uid == sId and focusLife.reason != 0 ? f_endTag(focusLife.reason) : "WAIT CRT"
if crtResult.hit and crtResult.dir == 1
    lastBuyTime := time
    lastBuyBar := bar_index
if crtResult.hit and crtResult.dir == -1
    lastSellTime := time
    lastSellBar := bar_index
// Independent higher-TF channel: it never writes main/Early wave latches.
var ReactionState higherState = ReactionState.new()
var int higherLastBuyTime = na
var int higherLastSellTime = na
var int higherLastBuyBar = na
var int higherLastSellBar = na
SignalContext higherCtx = SignalContext.new(age=higher.age, crtKey=higher.key, kind=1, id=higherAvailable ? higher.id : na, flags=higher.flags, phase=higher.phase, dir=higher.dir, confirmed=higher.confirmed, resolved=higher.resolved, hi=higher.hi, lo=higher.lo, inv=higher.inv, cp=higher.cp)
string higherModelKey = f_contextKey(higherAvailable ? higher.id : na, higher.resolved, higher.dir)
if barstate.isconfirmed and higherState.key != higherModelKey
    higherState := ReactionState.new(key=higherModelKey, activatedAt=higher.confirmed, phaseAt=higher.confirmed)
bool higherWaveAllowed = higher.dir == 1 ? na(higherLastBuyTime) or bar_index == higherLastBuyBar or (not na(lastPivotLowTime) and lastPivotLowTime > higherLastBuyTime) : na(higherLastSellTime) or bar_index == higherLastSellBar or (not na(lastPivotHighTime) and lastPivotHighTime > higherLastSellTime)
R1State higherR1 = r1Mode and higherAvailable ? f_r1State(r1States, r1Swings, largerTf + ":" + higherModelKey, higher.bT, higher.bEnd, higher.dir, higher.hi, higher.lo, largerBucket, largerEnd) : R1State.new()
MpsState higherMps = requireMps and higherAvailable ? f_mpsState(mpsStates, r1Swings, largerTf + ":" + higherModelKey, higherCtx, higher.aT, higher.aEnd, higher.bT, higher.bEnd, largerBucket, largerEnd) : MpsState.new()
MpsResult higherMpsResult = requireMps ? f_stepMps(higherCtx, higherMps, r1Bar) : MpsResult.new(status="OFF")
bool higherMpsAllowed = not requireMps or (higherMpsResult.ready and time >= higherMps.availableAt)
if requireMps and higherMpsAllowed
    higherState.activatedAt := math.max(higher.confirmed, higherMps.availableAt)
    if r1Mode
        higherR1 := f_mpsHandoff(higherR1, higherMps)
ChannelResult higherResult = r1Mode ? (higherMpsAllowed ? f_stepR1(higherCtx, higherR1, r1Bar, r1HigherLow, r1HigherHigh, r1HigherAt, higherWaveAllowed) : ChannelResult.new(status=higherMpsResult.status)) : f_stepChannel(higherCtx, higherState, lastPivotHigh, lastPivotLow, pivotHigh, pivotLow, higherWaveAllowed, false, higherMpsAllowed)
if requireMps and not higherMpsAllowed
    higherResult.status := higherMpsResult.status
if not higherAvailable
    higherResult.status := not enableLargerSignals ? "OFF" : not higherSignalTfValid ? "TF/Bias" : higherLife.uid == higher.id and higherLife.reason != 0 ? f_endTag(higherLife.reason) : "WAIT CRT"
if higherResult.hit and higherResult.dir == 1
    higherLastBuyTime := time
    higherLastBuyBar := bar_index
if higherResult.hit and higherResult.dir == -1
    higherLastSellTime := time
    higherLastSellBar := bar_index

// Cache by attempt: switching focus and returning during TRACK must not erase
// the evidence collected in that attempt's original C3. No trading gate reads it.
type SignalAudit
    int bars = 0
    int ts = 0
    int legs = 0
    int retests = 0
    int signals = 0
    string blocked = "-"
    string last = "-"
f_getSignalAudit(map<string, SignalAudit> records, string token) =>
    if barstate.isconfirmed and token != "" and not map.contains(records, token)
        map.put(records, token, SignalAudit.new())
        if map.size(records) > 128
            map.remove(records, array.get(map.keys(records), 0))
    map.contains(records, token) ? map.get(records, token) : SignalAudit.new()
f_recordSignalAudit(SignalAudit data, ChannelResult event) =>
    if event.evaluated
        data.bars += 1
        data.ts += event.tsDetected ? 1 : 0
        data.legs += event.legDetected ? 1 : 0
        data.retests += event.retestDetected ? 1 : 0
        data.signals += event.hit ? 1 : 0
        data.last := event.status
        if event.entryDetected and not event.hit
            data.blocked := event.status
    data
f_signalAuditText(SignalAudit data) =>
    "C3 bars " + str.tostring(data.bars) + " | Legs " + str.tostring(data.legs) + " | TS " + str.tostring(data.ts) + " | Retests " + str.tostring(data.retests) + " | Signals " + str.tostring(data.signals) + " | Blocked " + data.blocked + " | Last C3 " + data.last
var map<string, SignalAudit> signalAudits = map.new<string, SignalAudit>()
string diagnosticToken = htf + ":" + f_contextKey(sId, sResolved, sDir)
string higherDiagnosticToken = largerTf + ":" + f_contextKey(higher.id, higher.resolved, higher.dir)
SignalAudit diagnostic = f_getSignalAudit(signalAudits, not na(sId) ? diagnosticToken : "")
SignalAudit higherDiagnostic = f_getSignalAudit(signalAudits, not na(higher.id) ? higherDiagnosticToken : "")
diagnostic := f_recordSignalAudit(diagnostic, crtResult)
higherDiagnostic := f_recordSignalAudit(higherDiagnostic, higherResult)
string diagnosticSummary = "Main HTF " + htf + " | C1 " + (not na(sAT) ? str.format_time(sAT, "dd/MM HH:mm", NY) : "-") + " NY | Confirmed " + (not na(sConfirmed) ? str.format_time(sConfirmed, "dd/MM HH:mm", NY) : "-") + " NY | " + f_signalAuditText(diagnostic) + "\nHigher HTF " + largerTf + " | " + higherResult.status + " | C1 " + (not na(higher.aT) ? str.format_time(higher.aT, "dd/MM HH:mm", NY) : "-") + " NY | " + f_signalAuditText(higherDiagnostic) + " | Last end " + f_endTag(higher.reason)

if requireMps
    diagnosticSummary += "\nMPS Main " + mainMpsResult.status + " | " + f_mpsDebug(mainMps) + "\nMPS Larger " + higherMpsResult.status + " | " + f_mpsDebug(higherMps)
if r1Mode
    diagnosticSummary += "\nR1 Main " + crtResult.status + " | " + f_r1Debug(mainR1) + "\nR1 Larger " + higherResult.status + " | " + f_r1Debug(higherR1)

// Experimental Early C2 uses only completed chart bars; no final C2 OHLC is read.
type EarlyReference
    int c1End = na
    int start = na
    int finish = na
    int c1Time = na
    float c1O = na
    float c1H = na
    float c1L = na
    float c1C = na
type EarlyState
    MpsState mps = na
    int bucket = na
    int lastClose = na
    int dir = 0
    float hi = na
    float lo = na
    bool complete = false
    bool blocked = false
    bool emitted = false
    int attempts = 0
    int reclaimedAt = na
    float attemptSl = na
    float lockedSl = na
    float lockedTp = na
    CrtKey key = na
    ReactionState channel = na
    string status = "WAIT C2"
    string terminalReason = ""
type EarlyResult
    bool hit = false
    int dir = 0
    int bucket = na
    int c1Time = na
    int confirmTime = na
    int reclaimedAt = na
    int attempt = 0
    float inv = na
    float cp = na
    CrtKey keyRef = na
    string status = "WAIT C2"

f_stepEarly(EarlyReference ref, EarlyState state, CrtKey buyKey, CrtKey sellKey, bool buyWave, bool sellWave, bool confirmedHit) =>
    EarlyResult result = EarlyResult.new(bucket=ref.start, c1Time=ref.c1Time)
    if enableEarlyC2 and isLtf and barstate.isconfirmed and not na(ref.c1Time) and time >= ref.start
        bool newWindow = na(state.bucket) or state.bucket != ref.start
        if newWindow
            state.bucket := ref.start
            state.lastClose := ref.start
            state.dir := 0
            state.hi := high
            state.lo := low
            state.complete := time == ref.start
            state.blocked := false
            state.emitted := false
            state.attempts := 0
            state.reclaimedAt := na
            state.attemptSl := na
            state.lockedSl := na
            state.lockedTp := na
            state.key := CrtKey.new()
            state.mps := MpsState.new()
            state.channel := ReactionState.new()
            state.terminalReason := ""
        if not newWindow and time != state.lastClose
            state.complete := false
        state.lastClose := time_close
        bool extended = state.dir == 1 ? low < state.lo : state.dir == -1 ? high > state.hi : false
        state.hi := math.max(state.hi, high)
        state.lo := math.min(state.lo, low)
        bool raidLow = state.lo <= ref.c1L - sweepSize
        bool raidHigh = state.hi >= ref.c1H + sweepSize
        bool both = raidLow and raidHigh
        bool inside = close > ref.c1L and close < ref.c1H
        if state.dir == 0 and not both
            state.dir := raidLow ? 1 : raidHigh ? -1 : 0
        bool bullish = state.dir == 1
        float target = bullish ? ref.c1H : ref.c1L
        bool targetTaken = state.dir != 0 and (bullish ? state.hi >= target : state.lo <= target)
        bool biasOk = biasDir == state.dir or (allowCrtCounter and biasDir == -state.dir and biasDir != 0)
        if not state.complete
            state.status := "E DATA"
        else if state.emitted
            bool stopped = bullish ? low <= state.lockedSl : high >= state.lockedSl
            bool reached = bullish ? high >= state.lockedTp : low <= state.lockedTp
            if not state.blocked and (stopped or reached)
                state.blocked := true
                state.status := stopped and reached ? "E AMB" : stopped ? "E SL REF" : "E TP REF"
                state.terminalReason := state.status
            else if not state.blocked
                state.status := time_close >= ref.finish ? "E C2 ENDED" : "E SENT"
        else if state.blocked
            state.status := state.terminalReason
        else if time_close >= ref.finish
            state.blocked := true
            state.status := both ? "E DOUBLE" : targetTaken ? "E TP TAKEN" : state.dir != 0 and inside ? "E C2 CONFIRMED" : "E C2 REJECTED"
            state.terminalReason := state.status
        else if both or targetTaken
            state.blocked := true
            state.status := both ? "E DOUBLE" : "E TP TAKEN"
            state.terminalReason := state.status
        else if state.dir == 0
            state.status := "E WAIT RAID"
        else if not biasOk
            state.reclaimedAt := na
            state.channel := ReactionState.new()
            state.status := "E BIAS"
        else
            if extended or not inside
                state.reclaimedAt := na
                state.channel := ReactionState.new()
            CrtKey candidate = bullish ? buyKey : sellKey
            if na(state.key) or state.key.kind == 0
                if not na(candidate) and candidate.kind == 3 and candidate.dir == state.dir and not na(candidate.knownAt) and candidate.knownAt <= ref.c1Time and candidate.beforeTime == ref.c1Time
                    state.key := candidate.copy()
            bool hasKey = not na(state.key) and state.key.kind == 3 and state.key.dir == state.dir and state.key.knownAt <= ref.c1Time
            bool keyHeld = hasKey and (bullish ? close > state.key.hi : close < state.key.lo)
            if hasKey and not keyHeld
                state.blocked := true
                state.status := "E KEY LOST"
                state.terminalReason := state.status
            else if not hasKey or not inside
                state.status := not hasKey ? "E NO KEY" : "E WAIT RECLAIM"
            else if na(state.reclaimedAt)
                state.attempts += 1
                state.reclaimedAt := time_close
                state.attemptSl := bullish ? state.lo : state.hi
                state.channel := ReactionState.new(activatedAt=time_close, phaseAt=time_close)
                state.status := requireMps ? "E WAIT MPS" : "E WAIT LTF TS"
                if requireMps
                    SignalContext earlyContext = SignalContext.new(age=0, id=ref.start, kind=1, dir=state.dir, confirmed=time_close, crtKey=state.key, hi=ref.c1H, lo=ref.c1L, inv=state.attemptSl, cp=target)
                    state.mps := f_mpsSeed(r1Swings, earlyContext, ref.c1Time, ref.c1End, ref.start, time_close, ref.start, ref.finish)
                    MpsResult initialMps = f_stepMps(earlyContext, state.mps, r1Bar)
                    state.status := "E " + initialMps.status
            else
                SignalContext local = SignalContext.new(age=0, crtKey=state.key, kind=1, id=ref.start, flags=1, phase=1, dir=state.dir, confirmed=state.reclaimedAt, resolved=state.reclaimedAt, hi=ref.c1H, lo=ref.c1L, inv=state.attemptSl, cp=target)
                MpsResult earlyMps = requireMps ? f_stepMps(local, state.mps, r1Bar) : MpsResult.new(status="OFF")
                bool earlyMpsAllowed = not requireMps or (earlyMps.ready and time >= state.mps.availableAt)
                if requireMps and earlyMpsAllowed
                    state.channel.activatedAt := math.max(state.reclaimedAt, state.mps.availableAt)
                ChannelResult entry = f_stepChannel(local, state.channel, na, na, na, na, (bullish ? buyWave : sellWave) and not confirmedHit, r1Mode, earlyMpsAllowed)
                state.status := confirmedHit ? "E C3 PRIORITY" : requireMps and not earlyMpsAllowed ? "E " + earlyMps.status : "E " + entry.status
                if entry.hit and not confirmedHit
                    state.emitted := true
                    state.lockedSl := state.attemptSl
                    state.lockedTp := target
                    state.status := "E SIGNAL"
                    result.hit := true
                    result.dir := state.dir
                    result.inv := state.lockedSl
                    result.cp := state.lockedTp
                    result.confirmTime := entry.confirmTime
                    result.reclaimedAt := state.reclaimedAt
                    result.attempt := state.attempts
                    result.keyRef := state.key
    result.status := not enableEarlyC2 ? "E OFF" : not isLtf ? "E VIEW TF" : state.status
    result

// Both OHLC and key map come from the completed C1, never the forming C2.
// The key matcher separately excludes keys learned after C1 opened.
f_earlyReference() =>
    KeyMap priorMap = f_higherKeyMap(htf)
    [open[1], high[1], low[1], close[1], time[1], time_close[1], priorMap[1]]
[earlyC1O, earlyC1H, earlyC1L, earlyC1C, earlyC1T, earlyC1End, earlyKeys] = request.security(syminfo.tickerid, htf, f_earlyReference(), lookahead=barmerge.lookahead_on, calc_bars_count=CONTEXT_BARS)
var EarlyState earlyState = EarlyState.new()
var array<string> earlyUnused = array.new<string>()
float earlyHigh = earlyState.bucket == bucketTime ? math.max(earlyState.hi, high) : high
float earlyLow = earlyState.bucket == bucketTime ? math.min(earlyState.lo, low) : low
CrtKey earlyBuyKey = not na(earlyKeys) and not na(earlyKeys.levels) ? f_matchKeyMap(earlyKeys, earlyUnused, earlyC1T, 1, earlyHigh, earlyLow, close) : CrtKey.new()
CrtKey earlySellKey = not na(earlyKeys) and not na(earlyKeys.levels) ? f_matchKeyMap(earlyKeys, earlyUnused, earlyC1T, -1, earlyHigh, earlyLow, close) : CrtKey.new()
bool earlyBuyWave = na(lastBuyTime) or (not na(lastPivotLowTime) and lastPivotLowTime > lastBuyTime)
bool earlySellWave = na(lastSellTime) or (not na(lastPivotHighTime) and lastPivotHighTime > lastSellTime)
EarlyReference earlyRef = EarlyReference.new(start=bucketTime, finish=bucketEnd, c1Time=earlyC1T, c1End=earlyC1End, c1O=earlyC1O, c1H=earlyC1H, c1L=earlyC1L, c1C=earlyC1C)
EarlyResult earlyResult = f_stepEarly(earlyRef, earlyState, earlyBuyKey, earlySellKey, earlyBuyWave, earlySellWave, crtResult.hit)
if earlyResult.hit and earlyResult.dir == 1
    lastBuyTime := time
    lastBuyBar := bar_index
if earlyResult.hit and earlyResult.dir == -1
    lastSellTime := time
    lastSellBar := bar_index


array<ChannelResult> channelResults = array.from(crtResult)
array<ChannelResult> markerResults = array.from(crtResult, higherResult)
bool entryEvent = crtResult.hit
bool entryLong = (entryEvent and crtResult.dir == 1) or (higherResult.hit and higherResult.dir == 1)
bool entryShort = (entryEvent and crtResult.dir == -1) or (higherResult.hit and higherResult.dir == -1)
bool focusSignal = entryEvent
string auditSummary = "CRT: " + crtResult.status + (sEqTouched ? " | EQ touched (not TP)" : "") + " | Entry C3 only | Model " + str.tostring(sId)
string signalStatus = crtResult.status
float target = sCp
float executionSl = sInv
bool localTargetTaken = crtState.localTargetTaken
bool alreadyEmitted = r1Mode ? mainR1.terminal == "USED" : crtState.sent

// Drawing focus and the single signal context always refer to the same CRT.
var string selectedKey = ""
string visualKey = f_contextKey(sId, sResolved, sDir)
bool changedModel = visualKey != selectedKey
var int lastVisualTime = na
var int lastVisualIndex = na
var int lastVisualBucket = na
var string lastVisualKey = ""
var int modelObservedIndex = na
var int modelObservedTime = na
if changedModel
    selectedKey := visualKey
    modelObservedIndex := rangeAvailable ? bar_index : na
    modelObservedTime := rangeAvailable ? time : na
    lastVisualTime := na
    lastVisualIndex := na
    lastVisualBucket := na
    lastVisualKey := ""
if focusSignal
    lastVisualTime := time
    lastVisualIndex := bar_index
    lastVisualBucket := bucketCounter
    lastVisualKey := modelKey
f_sourceIndex(int sourceTime) =>
    int found = na
    if not na(sourceTime)
        for offset = 0 to math.min(bar_index, 4999)
            if time[offset] == sourceTime
                found := bar_index - offset
                break
    found
int modelAnchorTime = not na(sResolved) and sResolved > sConfirmed and not na(sCT) ? sCT : sBT
int modelAnchorIndex = onHtf and barstate.islast and rangeAvailable ? f_sourceIndex(modelAnchorTime) : na
int drawAnchorIndex = onHtf ? modelAnchorIndex : lastVisualKey == modelKey and not na(lastVisualIndex) ? lastVisualIndex : modelObservedIndex
int drawAnchorTime = onHtf ? modelAnchorTime : lastVisualKey == modelKey and not na(lastVisualTime) ? lastVisualTime : modelObservedTime
int drawSpan = int(math.ceil(drawHtfBars * htfSeconds / chartSeconds))
int labelLaneBars = chartTextSize == "Huge" ? 48 : chartTextSize == "Large" ? 36 : chartTextSize == "Small" ? 18 : 26
int clusterStartIndex = bar_index + (showLevels or showConfirm or showIrl ? math.max(clusterOffset, labelLaneBars + 12) : clusterOffset)
int drawingClipIndex = showCluster ? clusterStartIndex - labelLaneBars - 2 : bar_index + 498
int drawEndIndex = not na(drawAnchorIndex) ? math.min(bar_index + drawSpan, drawingClipIndex) : na
bool recentModel = rangeAvailable
bool recentLtfSignal = lastVisualKey == modelKey and not na(lastVisualBucket) and bucketCounter - lastVisualBucket <= drawHtfBars
bool drawActive = rangeAvailable and not na(drawAnchorIndex) and drawAnchorIndex >= bar_index - 9999 and drawEndIndex >= drawAnchorIndex and (not recentOnly or (onHtf ? recentModel : recentModel or recentLtfSignal))
bool clusterActive = rangeAvailable

// Finite drawings use real chart bar indices and real prices, on the main price pane.

var array<line> levelLines = array.new<line>()
var array<label> levelLabels = array.new<label>()
var array<float> renderedPrices = array.new<float>(16, na)
var array<int> renderedPriorities = array.new<int>(16, 0)
var array<int> renderedAnchors = array.new<int>(16, na)
var array<int> renderedEnds = array.new<int>(16, na)
var array<line> labelLeaders = array.new<line>()
var array<label> eventLabels = array.new<label>()
var array<int> eventBuckets = array.new<int>()
var array<box> clusterBodies = array.new<box>()
var array<line> clusterWicks = array.new<line>()
var array<label> clusterLabels = array.new<label>()
var array<label> groupLabels = array.new<label>()
var label clockLabel = label.new(bar_index, high, "", force_overlay=true, style=label.style_label_up, color=color.new(chart.bg_color, 100), textcolor=chart.fg_color, size=chartFont)
var table panel = table.new(position.top_right, 2, 11, bgcolor=color.new(#111820, 12), border_width=0)
if barstate.isfirst
    for i = 0 to 15
        array.push(levelLines, line.new(time, high, time, high, xloc=xloc.bar_time, extend=extend.none, force_overlay=true, color=color.new(color.gray, 100)))
        array.push(levelLabels, label.new(bar_index, high, "", xloc=xloc.bar_index, force_overlay=true, style=label.style_label_left, textalign=text.align_left, size=chartFont, color=color.new(chart.bg_color, 100)))
        array.push(labelLeaders, line.new(bar_index, high, bar_index, high, force_overlay=true, style=line.style_dotted, color=color.new(color.gray, 100)))
    for i = 0 to 3
        array.push(groupLabels, label.new(time, low, "", xloc=xloc.bar_time, force_overlay=true, style=label.style_label_up, color=color.new(chart.bg_color, 100), textcolor=chart.fg_color, size=size.small))
type ClusterCandle
    int t
    float o
    float h
    float l
    float c
// Merge frozen source candles only where chart-derived OHLC is unavailable.
// Keep chronological order, including all intervening CRT follow candles.
f_insertCluster(array<ClusterCandle> candles, int t, float o, float h, float l, float c) =>
    if not na(t) and not na(o)
        int insertion = array.size(candles)
        bool exists = false
        if array.size(candles) > 0
            for j = 0 to array.size(candles) - 1
                int itemTime = array.get(candles, j).t
                if itemTime == t
                    exists := true
                    break
                if itemTime > t
                    insertion := j
                    break
        if not exists
            array.insert(candles, insertion, ClusterCandle.new(t, o, h, l, c))
// MODEL and FOLLOW are disjoint slices of the same chronological candle series.
f_splitCluster(array<ClusterCandle> seriesCandles, int kind, int aT, int bT, int cT, int followLimit, array<ClusterCandle> origin, array<ClusterCandle> follow) =>
    array.clear(origin)
    array.clear(follow)
    int sourceEnd = bT
    int followTotal = 0
    if array.size(seriesCandles) > 0
        for j = 0 to array.size(seriesCandles) - 1
            ClusterCandle item = array.get(seriesCandles, j)
            bool isOrigin = item.t == aT or item.t == bT
            if isOrigin
                array.push(origin, item)
            else if item.t > sourceEnd
                array.push(follow, item)
                followTotal += 1
    while array.size(follow) > followLimit
        array.shift(follow)
    followTotal

f_archiveCandles(ModelArchive ended, array<ClusterCandle> candles) =>
    array.clear(candles)
    if not na(ended) and not na(ended.uid)
        f_insertCluster(candles, ended.aT, ended.aO, ended.aH, ended.aL, ended.aC)
        f_insertCluster(candles, ended.bT, ended.bO, ended.bH, ended.bL, ended.bC)
        if ended.kind == 1
            f_insertCluster(candles, ended.cT, ended.cO, ended.cH, ended.cL, ended.cC)

// Close timestamps come from the feed; never infer them by adding nominal TF seconds.
f_candleEnd(int sourceTime, int aTime, int aClose, int bTime, int bClose, int cTime, int cClose, int liveTime, int liveClose, array<int> cachedTimes, array<int> cachedEnds) =>
    int cached = array.indexof(cachedTimes, sourceTime)
    not na(sourceTime) ? (sourceTime == aTime ? aClose : sourceTime == bTime ? bClose : sourceTime == cTime ? cClose : sourceTime == liveTime ? liveClose : cached >= 0 and cached < array.size(cachedEnds) ? array.get(cachedEnds, cached) : na) : na

f_tfName(string tf) =>
    tf == "60" ? "H1" : tf == "120" ? "H2" : tf == "240" ? "H4" : tf == "1D" ? "D1" : tf == "1W" ? "W1" : tf
f_countdown(int closesAt, int nowAt) =>
    int secondsLeft = na(closesAt) ? 0 : math.max(0, int(math.ceil((closesAt - nowAt) / 1000.0)))
    int daysLeft = int(secondsLeft / 86400)
    int hoursLeft = int(secondsLeft % 86400 / 3600)
    int minutesLeft = int(secondsLeft % 3600 / 60)
    na(closesAt) ? "-" : secondsLeft == 0 ? "Closed" : (daysLeft > 0 ? str.tostring(daysLeft) + "d " : "") + str.tostring(hoursLeft, "00") + ":" + str.tostring(minutesLeft, "00") + ":" + str.tostring(secondsLeft % 60, "00")
f_tag(int flags, int kind, int phase) =>
    "CRT/TS"
f_levelPriority(int slot) =>
    slot == 12 ? 5 : slot == 3 ? 4 : slot == 11 ? 3 : slot == 4 ? 2 : 1
f_extremeTime(int sourceTime, float price) =>
    int found = onHtf ? sourceTime : na
    int cached = array.indexof(candleTimes, sourceTime)
    if not onHtf and cached >= 0
        if math.abs(price - array.get(candleHighs, cached)) < syminfo.mintick * 0.5
            found := array.get(candleHighTimes, cached)
        else if math.abs(price - array.get(candleLows, cached)) < syminfo.mintick * 0.5
            found := array.get(candleLowTimes, cached)
    if not onHtf and na(found) and not na(sourceTime) and sourceTime + int(htfSeconds * 1000) > time[math.min(bar_index, 4999)]
        for offset = 0 to math.min(bar_index, 4999)
            if time[offset] >= sourceTime and time[offset] < sourceTime + int(htfSeconds * 1000) and (math.abs(high[offset] - price) < syminfo.mintick * 0.5 or math.abs(low[offset] - price) < syminfo.mintick * 0.5)
                found := time[offset]
                break
    found
f_indexTime(int index) =>
    int found = na
    if not na(index)
        if index > bar_index
            found := time + int((index - bar_index) * chartSeconds * 1000)
        else if bar_index - index <= 4999
            found := time[bar_index - index]
    found
f_level(int slot, float price, string caption, color shade, bool visible, int sourceTime = na, bool exactTime = false, bool currentProjection = false) =>
    line ln = array.get(levelLines, slot)
    label lb = array.get(levelLabels, slot)
    int anchor = na(sourceTime) ? drawAnchorTime : exactTime ? sourceTime : f_extremeTime(sourceTime, price)
    int endpoint = currentProjection ? math.min(bar_index + drawSpan, drawingClipIndex) : drawEndIndex
    int endTime = f_indexTime(endpoint)
    bool ok = visible and not na(anchor) and not na(endTime) and endTime >= anchor and not na(price)
    int owner = slot
    if ok and slot > 0
        for prior = 0 to slot - 1
            float priorPrice = array.get(renderedPrices, prior)
            if not na(priorPrice) and math.abs(price - priorPrice) < syminfo.mintick * 0.5 and array.get(renderedAnchors, prior) == anchor
                owner := prior
                break
    bool standalone = ok and owner == slot
    if standalone
        array.set(renderedPrices, slot, price)
        array.set(renderedAnchors, slot, anchor)
        array.set(renderedEnds, slot, endpoint)
        array.set(renderedPriorities, slot, f_levelPriority(slot))
        line.set_xy1(ln, anchor, price)
        line.set_xy2(ln, endTime, price)
        label.set_xy(lb, endpoint + 1, price)
    line.set_color(ln, standalone ? shade : color.new(shade, 100))
    label.set_text(lb, standalone ? caption : "")
    label.set_textcolor(lb, shade)
    label.set_tooltip(lb, standalone ? caption + " · " + str.tostring(price, format.mintick) : "")
    if ok and owner != slot
        label ownerLabel = array.get(levelLabels, owner)
        string combinedCaption = label.get_text(ownerLabel) + (caption != "" ? " / " + caption : "")
        label.set_text(ownerLabel, combinedCaption)
        label.set_tooltip(ownerLabel, combinedCaption + " · " + str.tostring(price, format.mintick))
        if f_levelPriority(slot) > array.get(renderedPriorities, owner)
            array.set(renderedPriorities, owner, f_levelPriority(slot))
            line.set_color(array.get(levelLines, owner), shade)
            label.set_textcolor(ownerLabel, shade)
// Only labels move vertically; source price levels and their start bars never move.
var float viewHigh = na
var float viewLow = na
if time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
    viewHigh := na(viewHigh) ? high : math.max(viewHigh, high)
    viewLow := na(viewLow) ? low : math.min(viewLow, low)
float fontSpacing = chartTextSize == "Huge" ? 2.0 : chartTextSize == "Large" ? 1.5 : chartTextSize == "Small" ? 0.85 : 1.0
float visibleLabelGap = math.max(nz(viewHigh - viewLow, high - low) * 0.04 * fontSpacing, nz(ta.atr(14), high - low) * 0.5, syminfo.mintick * 12)
f_layoutLabels() =>
    array<bool> placed = array.new<bool>(16, false)
    float previousY = na
    for slot = 0 to 15
        line.set_color(array.get(labelLeaders, slot), color.new(color.gray, 100))
    for pass = 0 to 15
        int next = na
        float nextPrice = na
        for slot = 0 to 15
            float candidate = array.get(renderedPrices, slot)
            if not array.get(placed, slot) and not na(candidate) and (na(nextPrice) or candidate < nextPrice)
                next := slot
                nextPrice := candidate
        if not na(next)
            array.set(placed, next, true)
            float labelPrice = na(previousY) ? nextPrice : math.max(nextPrice, previousY + visibleLabelGap)
            label lb = array.get(levelLabels, next)
            int endpoint = array.get(renderedEnds, next)
            label.set_xy(lb, endpoint + 2, labelPrice)
            if math.abs(labelPrice - nextPrice) > syminfo.mintick * 0.5
                line leader = array.get(labelLeaders, next)
                line.set_xy1(leader, endpoint, nextPrice)
                line.set_xy2(leader, endpoint + 1, labelPrice)
                line.set_color(leader, color.new(chart.fg_color, 45))
            previousY := labelPrice
// Fixed half-Tiny marker: Tiny label size is approximately 7pt; use 4pt.
f_dropMark(int index) =>
    label.delete(array.remove(eventLabels, index))
    array.remove(eventBuckets, index)

f_note(bool up, string hint) =>
    color markerColor = up ? color.lime : color.red
    string markerLocation = up ? yloc.belowbar : yloc.abovebar
    if markLimit > 0
        array.push(eventLabels, label.new(bar_index, na, "", xloc=xloc.bar_index, yloc=markerLocation, style=up ? label.style_triangleup : label.style_triangledown, color=markerColor, size=4, force_overlay=true, tooltip=hint))
        array.push(eventBuckets, bucketCounter)
    while array.size(eventLabels) > markLimit
        f_dropMark(0)
f_keyTag(CrtKey key) =>
    key.dir == 1 ? "SSL" : "BSL"
string buyHint = ""
string sellHint = ""
// Latest means the latest EVENT BAR: keep both directions if sources conflict.
// Early + one independent higher signal can also share that bar (max two marks).
// MPS text marks the observation bar. It has its own bounded history and no fill.
var array<label> mpsLabels = array.new<label>()
float mpsPadding = math.max(nz(ta.atr(14), high - low), syminfo.mintick * 8)
if requireMps and historyMarks > 0 and (mainMpsResult.event or higherMpsResult.event)
    if not retainHistory
        while array.size(mpsLabels) > 0
            label.delete(array.shift(mpsLabels))
    for pass = 0 to 1
        int direction = pass == 0 ? 1 : -1
        bool mainEvent = mainMpsResult.event and sDir == direction
        bool largerEvent = higherMpsResult.event and higher.dir == direction
        if mainEvent or largerEvent
            string hint = "MPS CONFIRMATION · NOT ENTRY\n" + (mainEvent ? f_tfName(htf) + " | " + f_mpsDebug(mainMps) : "") + (largerEvent ? "\n" + f_tfName(largerTf) + " | " + f_mpsDebug(higherMps) : "")
            array.push(mpsLabels, label.new(bar_index, direction == 1 ? low - mpsPadding : high + mpsPadding, direction == 1 ? "+MPS" : "-MPS", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=direction == 1 ? color.teal : color.red, size=size.small, force_overlay=true, tooltip=hint))
int mpsLimit = historyMarks == 0 ? 0 : retainHistory ? math.min(historyMarks, 40) : 2
while array.size(mpsLabels) > mpsLimit
    label.delete(array.shift(mpsLabels))
if not retainHistory and markLimit > 0 and (entryLong or entryShort or earlyResult.hit)
    while array.size(eventLabels) > 0
        f_dropMark(0)
for i = 0 to 1
    ChannelResult hit = array.get(markerResults, i)
    if hit.hit
        string sourceTf = i == 0 ? htf : largerTf
        string hint = "HTF " + f_tfName(sourceTf) + " | " + f_tag(hit.flags, hit.kind, hit.phase) + " / " + hit.tag + " / " + signalTiming + "\nConfirm bar " + str.format_time(hit.confirmTime, "dd/MM HH:mm", NY) + " NY | Trigger bar " + str.format_time(time, "dd/MM HH:mm", NY) + " NY | Signal CLOSE " + str.format_time(time_close, "dd/MM HH:mm:ss", NY) + " NY | Bias " + str.tostring(biasDir) + " | Close " + str.tostring(close, format.mintick) + " | CP " + str.tostring(hit.cp, format.mintick) + " | INV " + str.tostring(hit.inv, format.mintick)
        if r1Mode
            hint += "\nR1 EXP | REF " + str.tostring(hit.referencePrice, format.mintick) + " | REF known ms " + str.tostring(hit.referenceKnownAt) + " | LEG close ms " + str.tostring(hit.legKnownAt) + " | ZONE " + str.tostring(hit.zoneLow, format.mintick) + "–" + str.tostring(hit.zoneHigh, format.mintick) + " | declared ms " + str.tostring(hit.zoneKnownAt)
        int sourceC1 = i == 0 ? sAT : higher.aT
        int sourceConfirmed = i == 0 ? sConfirmed : higher.confirmed
        hint += "\nCRT #" + str.tostring(hit.id) + " | C1 " + str.format_time(sourceC1, "dd/MM HH:mm", NY) + " NY | HTF confirmed " + str.format_time(sourceConfirmed, "dd/MM HH:mm", NY) + " NY | C3 only; ET is manual"
        if hit.counterBias
            hint += "\nCT | " + hit.keyRef.tf + " " + f_keyTag(hit.keyRef) + " | Key " + str.tostring(hit.keyRef.lo, format.mintick) + "-" + str.tostring(hit.keyRef.hi, format.mintick) + " | Known " + str.format_time(hit.keyRef.knownAt, "dd/MM HH:mm", NY) + " NY | before CRT C1 " + str.format_time(hit.keyRef.beforeTime, "dd/MM HH:mm", NY) + " NY"
        if hit.dir == 1
            buyHint += (buyHint == "" ? "BUY\n" : "\n") + hint
        else
            sellHint += (sellHint == "" ? "SELL\n" : "\n") + hint
if entryLong and showEntryTriangles
    f_note(true, buyHint)
if entryShort and showEntryTriangles
    f_note(false, sellHint)

if earlyResult.hit and showEntryTriangles and markLimit > 0
    string earlyHint = "EARLY C2 · EXPERIMENTAL | Not HTF confirmed\n" + (earlyResult.dir == 1 ? "BUY" : "SELL") + " | C1 " + str.format_time(earlyResult.c1Time, "dd/MM HH:mm", NY) + " NY | C2 " + str.format_time(earlyResult.bucket, "dd/MM HH:mm", NY) + " NY | Attempt " + str.tostring(earlyResult.attempt) + "\nReclaim closed " + str.format_time(earlyResult.reclaimedAt, "HH:mm:ss", NY) + " | LTF TS " + str.format_time(earlyResult.confirmTime, "HH:mm", NY) + " | Signal close " + str.format_time(time_close, "HH:mm:ss", NY) + " NY\nSL ref " + str.tostring(earlyResult.inv, format.mintick) + " | TP ref " + str.tostring(earlyResult.cp, format.mintick) + " | Frozen at this signal; not a fill."
    array.push(eventLabels, label.new(bar_index, na, "E", xloc=xloc.bar_index, yloc=earlyResult.dir == 1 ? yloc.belowbar : yloc.abovebar, style=earlyResult.dir == 1 ? label.style_label_up : label.style_label_down, color=color.new(earlyResult.dir == 1 ? color.lime : color.red, 88), textcolor=earlyResult.dir == 1 ? color.lime : color.red, size=size.small, force_overlay=true, tooltip=earlyHint))
    array.push(eventBuckets, bucketCounter)
    while array.size(eventLabels) > markLimit
        f_dropMark(0)

if not retainHistory and recentOnly and barstate.islast
    int markIndex = array.size(eventLabels) - 1
    while markIndex >= 0
        if bucketCounter - array.get(eventBuckets, markIndex) > drawHtfBars
            f_dropMark(markIndex)
        markIndex -= 1

// Counts use closed chart bars across the loaded dataset, independent of display pruning.
var int dataStart = math.max(time, last_bar_time - int(htfSeconds * 1000) * scanDepth)
var string lastClosedStatus = "WAIT"
var string lastClosedAudit = ""
var int crtSignals = 0
var int higherSignals = 0
var int earlySignals = 0
if earlyResult.hit
    earlySignals += 1
if barstate.isconfirmed
    lastClosedStatus := signalStatus
    lastClosedAudit := auditSummary
if barstate.isconfirmed and entryEvent
    crtSignals += crtResult.hit ? 1 : 0
if barstate.isconfirmed and higherResult.hit
    higherSignals += 1
bool legacyEntryEvent = entryEvent and not r1Mode
plot(legacyEntryEvent ? crtResult.dir : na, "CRT direction +1/-1", display=display.data_window)
plot(legacyEntryEvent ? crtResult.cp : na, "CRT target at signal", display=display.data_window)
plot(legacyEntryEvent ? crtResult.inv : na, "CRT invalidation at signal", display=display.data_window)
plot(legacyEntryEvent ? close : na, "Signal reference close (not fill)", display=display.data_window)
plot(legacyEntryEvent and crtResult.counterBias ? crtResult.dir : na, "CRT counter-bias CT +1/-1", display=display.data_window)
plot(structureBias, "Bias confirmed structure +1/0/-1", display=display.data_window)
plot(biasDir, "Bias effective +1/0/-1", display=display.data_window)
plot(autoGuardHigh, "Bias guard high", display=display.data_window)
plot(autoGuardLow, "Bias guard low", display=display.data_window)

// Export-only evidence for causal Replay review. No drawing, entry or alert changes.
// Numeric plot titles become CSV headers; timestamps are Unix milliseconds.
plot(requireMps ? 3 : r1Mode ? 2 : 1, "TFA audit schema", display=display.data_window)
plot(barstate.isconfirmed ? time_close : na, "TFA audit bar close ms", display=display.data_window)
plot(htfSeconds, "TFA audit HTF seconds", display=display.data_window)
plot(chartSeconds, "TFA audit LTF seconds", display=display.data_window)
plot(signalTiming == "Pullback" ? 1 : 0, "TFA audit Pullback", display=display.data_window)
plot(sweepSize, "TFA audit tick", display=display.data_window)
plot(legacyEntryEvent ? crtResult.id : na, "TFA audit model id", display=display.data_window)
plot(legacyEntryEvent ? crtResult.confirmTime : na, "TFA audit TS open ms", display=display.data_window)
plot(legacyEntryEvent ? sConfirmed : na, "TFA audit HTF confirmed ms", display=display.data_window)
plot(legacyEntryEvent ? liveT : na, "TFA audit C3 open ms", display=display.data_window)
plot(legacyEntryEvent ? liveEnd : na, "TFA audit C3 close ms", display=display.data_window)
plot(legacyEntryEvent ? sModelAge : na, "TFA audit model age", display=display.data_window)
plot(legacyEntryEvent ? crtState.confirmLevel : na, "TFA audit reclaim level", display=display.data_window)
plot(legacyEntryEvent ? crtState.localExtreme : na, "TFA audit TS extreme", display=display.data_window)

// Higher-TF evidence has its own columns; main CSV contracts remain main-only.
plot(higherResult.hit and not r1Mode ? higherResult.dir : na, "Higher CRT direction +1/-1", display=display.data_window)
plot(higherResult.hit and not r1Mode ? higherResult.cp : na, "Higher CRT target at signal", display=display.data_window)
plot(higherResult.hit and not r1Mode ? higherResult.inv : na, "Higher CRT invalidation at signal", display=display.data_window)
plot(higherResult.hit and not r1Mode ? higher.confirmed : na, "Higher CRT confirmed ms", display=display.data_window)
plot(enableLargerSignals and higherSignalTfValid ? timeframe.in_seconds(largerTf) : na, "Higher CRT TF seconds", display=display.data_window)

// R1 has separate evidence; schema 2 intentionally fails the legacy TS CSV auditor.
plot(r1Mode and crtResult.hit ? crtResult.dir : na, "R1 main direction", display=display.data_window)
plot(r1Mode and crtResult.hit ? crtResult.referencePrice : na, "R1 main reference", display=display.data_window)
plot(r1Mode and crtResult.hit ? crtResult.referenceKnownAt : na, "R1 main reference known ms", display=display.data_window)
plot(r1Mode and crtResult.hit ? crtResult.legKnownAt : na, "R1 main leg known ms", display=display.data_window)
plot(r1Mode and crtResult.hit ? crtResult.zoneKnownAt : na, "R1 main zone known ms", display=display.data_window)
plot(r1Mode and higherResult.hit ? higherResult.dir : na, "R1 larger direction", display=display.data_window)
plot(r1Mode and higherResult.hit ? higherResult.referencePrice : na, "R1 larger reference", display=display.data_window)
plot(r1Mode and higherResult.hit ? higherResult.referenceKnownAt : na, "R1 larger reference known ms", display=display.data_window)
plot(r1Mode and higherResult.hit ? higherResult.legKnownAt : na, "R1 larger leg known ms", display=display.data_window)
plot(r1Mode and higherResult.hit ? higherResult.zoneKnownAt : na, "R1 larger zone known ms", display=display.data_window)

// MPS observation is exported on the observation bar, never backdated to C2.
plot(requireMps and mainMpsResult.event ? sDir : na, "MPS main direction", display=display.data_window)
plot(requireMps and mainMpsResult.event ? mainMps.reference : na, "MPS main P2", display=display.data_window)
plot(requireMps and mainMpsResult.event ? mainMps.availableAt : na, "MPS main available ms", display=display.data_window)
plot(requireMps and mainMpsResult.event ? mainMps.activationAt : na, "MPS main activation ms", display=display.data_window)
plot(requireMps and higherMpsResult.event ? higher.dir : na, "MPS larger direction", display=display.data_window)
plot(requireMps and higherMpsResult.event ? higherMps.reference : na, "MPS larger P2", display=display.data_window)
plot(requireMps and higherMpsResult.event ? higherMps.availableAt : na, "MPS larger available ms", display=display.data_window)
plot(requireMps and higherMpsResult.event ? higherMps.activationAt : na, "MPS larger activation ms", display=display.data_window)

// Early events are exported separately and never relabelled as C3 evidence.
plot(enableEarlyC2 ? 1 : 0, "Early C2 enabled", display=display.data_window)
plot(earlyResult.hit ? earlyResult.dir : na, "Early C2 direction +1/-1", display=display.data_window)
plot(earlyResult.hit ? earlyResult.inv : na, "Early C2 locked SL", display=display.data_window)
plot(earlyResult.hit ? earlyResult.cp : na, "Early C2 locked TP", display=display.data_window)
plot(earlyResult.hit ? earlyResult.confirmTime : na, "Early C2 TS open ms", display=display.data_window)
plot(earlyResult.hit ? earlyResult.bucket : na, "Early C2 window open ms", display=display.data_window)
plot(earlyResult.hit ? bucketEnd : na, "Early C2 window close ms", display=display.data_window)

if barstate.islast
    bool hasModel = rangeAvailable
    color primaryColor = sDir == 1 ? color.teal : sDir == -1 ? color.orange : color.silver
    string tag = hasModel ? f_tag(sFlags, sKind, sPhase) : "-"
    array.fill(renderedPrices, na)
    array.fill(renderedPriorities, 0)
    array.fill(renderedAnchors, na)
    array.fill(renderedEnds, na)
    f_level(0, sHi, "RH", primaryColor, showLevels and drawActive, sHiT)
    f_level(1, sLo, "RL", primaryColor, showLevels and drawActive, sLoT)
    f_level(2, (sHi + sLo) / 2, sEqTouched ? "EQ*" : "EQ", color.new(chart.fg_color, 35), showLevels and drawActive)
    f_level(3, sInv, "INV", color.new(color.red, 15), showLevels and drawActive and focusAvailable, sInvT)
    f_level(4, sCp, "CP", color.aqua, showLevels and drawActive, sCpT)
    f_level(5, sErlU, "ERL+", color.new(color.orange, 35), showLevels and drawActive, sErlUT)
    f_level(6, sErlL, "ERL-", color.new(color.teal, 35), showLevels and drawActive, sErlLT)
    bool irlVisible = showIrl and hasModel and drawActive
    f_level(13, sInnerHi, "iBSL" + (sIrlKind == 3 and sDir == -1 ? "*" : ""), color.orange, irlVisible and not na(sInnerHiT), sInnerHiT, false, true)
    f_level(14, sInnerLo, "iSSL" + (sIrlKind == 3 and sDir == 1 ? "*" : ""), color.teal, irlVisible and not na(sInnerLoT), sInnerLoT, false, true)
    bool showCrtKey = showLevels and drawActive and sKind == 1 and not na(kCrtKey) and kCrtKey.kind > 0 and biasDir == -sDir
    f_level(15, showCrtKey ? (kCrtKey.hi + kCrtKey.lo) / 2 : na, showCrtKey ? "K/" + f_keyTag(kCrtKey) : "", color.purple, showCrtKey, showCrtKey ? nz(kCrtKey.leftTime, kCrtKey.born) : na, showCrtKey ? kCrtKey.kind != 3 or kCrtKey.tf != htf : true, true)
    bool hasIrl = not na(sIrlT)
    f_layoutLabels()
    if showPanel
        string dirText = biasPaused ? "B0!" : biasDir == 1 ? "B+" : biasDir == -1 ? "B-" : "B0"
        string stateText = not hasModel ? "SEARCH" : not focusAvailable ? "WATCH" : sModelAge > 0 ? "TRACK" : requireMps and (na(mainMps.availableAt) or mainMps.terminal != "") ? "WAIT MPS" : alreadyEmitted ? "SIGNAL" : "ENTRY"
        array<string> headings = array.from("TF", "CRT", "BIAS", "REF", "T", "ENTRY", "N", "WHY", "DATA", "EARLY", "MPS")
        array<string> values = array.from(htf + " / " + timeframe.period + (overviewMode ? " VIEW" : ""), (hasModel ? (sDir == 1 ? "BUY" : "SELL") : "-") + " | " + str.tostring(hasModel ? sCount : 0), dirText + " / " + biasTf, hasModel and hasIrl ? "IRL" : "-", crtTimeText, stateText, "C " + str.tostring(crtSignals) + " H " + str.tostring(higherSignals), lastClosedStatus + (barstate.isconfirmed ? "" : " *"), str.format_time(dataStart, "dd/MM", NY) + "-" + str.format_time(time, "dd/MM", NY), earlyResult.status + " | " + str.tostring(earlySignals), requireMps ? f_tfName(htf) + ":" + (not focusAvailable ? "-" : mainMps.terminal != "" ? str.replace(mainMps.terminal, "M ", "") : not na(mainMps.availableAt) ? (sDir == 1 ? "+" : "-") : "WAIT") + " " + f_tfName(largerTf) + ":" + (not higherAvailable ? "-" : higherMps.terminal != "" ? str.replace(higherMps.terminal, "M ", "") : not na(higherMps.availableAt) ? (higher.dir == 1 ? "+" : "-") : "WAIT") : "OFF")
        for row = 0 to 10
            table.cell(panel, 0, row, " " + array.get(headings, row) + " ", text_color=color.silver, text_size=dashboardFont)
            table.cell(panel, 1, row, " " + array.get(values, row) + " ", text_color=row == 2 ? (biasDir == 1 ? color.teal : biasDir == -1 ? color.orange : color.silver) : color.silver, text_size=dashboardFont, tooltip=row == 10 ? "MPS = structural confirmation, not entry. Entry begins on a later bar. " + diagnosticSummary : row == 1 ? "Last model end: " + f_endTag(lastSetupEnd) + " | Parent C1 stays until its target is taken. INV ends only this attempt; Only original C3 can replace the raid once, with original key and close inside C1. TRACK after entry window; no automatic C3 expiry. Not fills." : row == 2 ? "Confirmed structure: " + str.tostring(structureBias) + " | Guard H " + str.tostring(autoGuardHigh, format.mintick) + " L " + str.tostring(autoGuardLow, format.mintick) + (biasPaused ? " | paused by closed chart bar; no opposite bias assumed" : "") : row == 9 ? "Experimental C2, not HTF confirmed. Key on same HTF before C1. At most one E per C2; locked reference SL/TP. No Replay certification." : row == 7 ? lastClosedAudit + "\n" + diagnosticSummary : row == 6 ? "C = main HTF, H = larger HTF. Separate source event counts; a merged marker may count once in each source. Closed LTF C3 only; not fills or win-rate." : "")
    array<ClusterCandle> clusterCandles = array.new<ClusterCandle>()
    if showCluster and clusterActive
        if array.size(candleTimes) > 0
            for j = 0 to array.size(candleTimes) - 1
                int t = array.get(candleTimes, j)
                if t >= sAT
                    array.push(clusterCandles, ClusterCandle.new(t, array.get(candleOpens, j), array.get(candleHighs, j), array.get(candleLows, j), array.get(candleCloses, j)))
        f_insertCluster(clusterCandles, sAT, sAO, sAH, sAL, sAC)
        f_insertCluster(clusterCandles, sBT, sBO, sBH, sBL, sBC)
        f_insertCluster(clusterCandles, sCT, sCO, sCH, sCL, sCC)
        if liveComplete and liveT >= sAT
            f_insertCluster(clusterCandles, liveT, liveO, liveH, liveL, liveC)
    int clusterCount = array.size(clusterCandles)
    array<ClusterCandle> originCandles = array.new<ClusterCandle>()
    array<ClusterCandle> followCandles = array.new<ClusterCandle>()
    array<ClusterCandle> endedCandles = array.new<ClusterCandle>()
    array<ClusterCandle> largerCandles = array.new<ClusterCandle>()
    int followTotal = f_splitCluster(clusterCandles, sKind, sAT, sBT, sCT, clusterFollowCount, originCandles, followCandles)
    bool contextOnlyCluster = showCluster and not clusterActive
    if contextOnlyCluster
        int first = math.max(0, array.size(candleTimes) - 3)
        if array.size(candleTimes) > 0
            for j = first to array.size(candleTimes) - 1
                f_insertCluster(originCandles, array.get(candleTimes, j), array.get(candleOpens, j), array.get(candleHighs, j), array.get(candleLows, j), array.get(candleCloses, j))
        if liveComplete
            f_insertCluster(originCandles, liveT, liveO, liveH, liveL, liveC)
    bool archiveActive = showCluster and showArchive and not na(visibleArchive) and not na(visibleArchive.uid)
    if archiveActive
        f_archiveCandles(visibleArchive, endedCandles)
    if showCluster and showLargerCluster
        f_insertCluster(largerCandles, h3T, h3O, h3H, h3L, h3C)
        f_insertCluster(largerCandles, h2T, h2O, h2H, h2L, h2C)
        f_insertCluster(largerCandles, h1T, h1O, h1H, h1L, h1C)
        if largerComplete
            f_insertCluster(largerCandles, largerLiveT, largerLiveO, largerLiveH, largerLiveL, largerLiveC)
    int originCount = array.size(originCandles)
    int followCount = array.size(followCandles)
    int endedCount = array.size(endedCandles)
    int largerCount = array.size(largerCandles)
    int renderCount = originCount + followCount + endedCount + largerCount
    while array.size(clusterBodies) > renderCount
        box.delete(array.pop(clusterBodies))
        line.delete(array.pop(clusterWicks))
        label.delete(array.pop(clusterLabels))
    while array.size(clusterBodies) < renderCount
        array.push(clusterBodies, box.new(time, high, time, low, xloc=xloc.bar_time, force_overlay=true))
        array.push(clusterWicks, line.new(time, high, time, low, xloc=xloc.bar_time, width=1, force_overlay=true))
        array.push(clusterLabels, label.new(time, low, "", xloc=xloc.bar_time, force_overlay=true, style=label.style_label_up, color=color.new(chart.bg_color, 100), textcolor=chart.fg_color, size=chartFont))
    int candleWidth = clusterWidth - clusterWidth % 2
    float clusterStep = candleWidth + 2.0
    float bodyWidth = candleWidth
    float groupGap = math.max(8.0, clusterStep * 1.5)
    float interHtfGap = math.max(clusterOffset, labelLaneBars + 12)
    int clusterStartTime = time + int((clusterStartIndex - bar_index) * chartSeconds * 1000)
    bool currentBucketClosed = barstate.isconfirmed and not na(liveEnd) and time_close >= liveEnd
    bool largerBucketClosed = barstate.isconfirmed and time_close >= largerEnd
    float mainFloor = na
    float mainTop = na
    float largerFloor = na
    float largerTop = na
    for pass = 0 to 3
        array<ClusterCandle> scan = pass == 0 ? originCandles : pass == 1 ? followCandles : pass == 2 ? endedCandles : largerCandles
        if array.size(scan) > 0
            for j = 0 to array.size(scan) - 1
                ClusterCandle item = array.get(scan, j)
                if pass <= 1
                    mainFloor := na(mainFloor) ? item.l : math.min(mainFloor, item.l)
                    mainTop := na(mainTop) ? item.h : math.max(mainTop, item.h)
                if pass == 3
                    largerFloor := na(largerFloor) ? item.l : math.min(largerFloor, item.l)
                    largerTop := na(largerTop) ? item.h : math.max(largerTop, item.h)
    float captionGap = math.max(visibleLabelGap, syminfo.mintick * 12)
    float cursor = 0.0
    int drawSlot = 0
    for group = 0 to 3
        array<ClusterCandle> candles = group == 0 ? originCandles : group == 1 ? followCandles : group == 2 ? endedCandles : largerCandles
        int groupCount = array.size(candles)
        label heading = array.get(groupLabels, group)
        label.set_text(heading, "")
        if group == 3 and groupCount > 0
            cursor += interHtfGap - (cursor > 0 ? groupGap : 0)
        if groupCount > 0
            int groupStartTime = clusterStartTime + int(cursor * chartSeconds * 1000)
            for i = 0 to groupCount - 1
                ClusterCandle item = array.get(candles, i)
                int left = clusterStartTime + int((cursor + i * clusterStep) * chartSeconds * 1000)
                int right = left + int(bodyWidth * chartSeconds * 1000)
                int middle = left + int((right - left) / 2)
                bool archived = group == 2
                color shade = item.c >= item.o ? color.teal : color.new(#161b22, 0)
                box body = array.get(clusterBodies, drawSlot)
                line wick = array.get(clusterWicks, drawSlot)
                label caption = array.get(clusterLabels, drawSlot)
                box.set_lefttop(body, left, math.max(item.o, item.c))
                box.set_rightbottom(body, right, math.min(item.o, item.c))
                box.set_bgcolor(body, color.new(shade, archived ? 75 : 0))
                box.set_border_color(body, color.new(shade, archived ? 65 : 0))
                line.set_xy1(wick, middle, item.h)
                line.set_xy2(wick, middle, item.l)
                line.set_width(wick, 1)
                line.set_color(wick, color.new(shade, archived ? 70 : 25))
                bool rawContext = group == 3 or (group == 0 and contextOnlyCluster)
                bool liveItem = group == 3 ? item.t == largerLiveT : item.t == liveT
                bool sourceClosed = group == 3 ? largerBucketClosed : currentBucketClosed
                string candleCaption = not archived and liveItem ? f_countdown(group == 3 ? largerEnd : liveEnd, timenow) : ""
                float captionBase = nz(group == 3 ? largerFloor : mainFloor, item.l) - captionGap * 0.65
                label.set_xy(caption, middle, captionBase)
                label.set_text(caption, candleCaption)
                label.set_textcolor(caption, archived ? color.gray : chart.fg_color)
                int sourceClose = group == 3 ? (item.t == h3T ? h3End : item.t == h2T ? h2End : item.t == h1T ? h1End : item.t == largerLiveT ? largerEnd : na) : f_candleEnd(item.t, archived ? visibleArchive.aT : sAT, archived ? visibleArchive.aEnd : sAEnd, archived ? visibleArchive.bT : sBT, archived ? visibleArchive.bEnd : sBEnd, archived ? visibleArchive.cT : sCT, archived ? visibleArchive.cEnd : sCEnd, liveT, liveEnd, candleTimes, candleEndTimes)
                string closeCaption = not archived and liveItem and not sourceClosed ? "Scheduled close " : "Close "
                label.set_tooltip(caption, "Open " + str.format_time(item.t, "dd/MM HH:mm", NY) + " NY | " + closeCaption + (not na(sourceClose) ? str.format_time(sourceClose, "dd/MM HH:mm", NY) + " NY" : "-") + " | O " + str.tostring(item.o, format.mintick) + " H " + str.tostring(item.h, format.mintick) + " L " + str.tostring(item.l, format.mintick) + " C " + str.tostring(item.c, format.mintick) + (archived ? " | LAST / " + f_endTag(visibleArchive.endReason) : group == 3 ? " | Larger HTF OHLC; its signal engine is controlled separately; candle colour is not bias" : rawContext ? " | OHLC context; no confirmed parent selected" : " | Parent C1 " + str.format_time(sAT, "dd/MM HH:mm", NY) + " | Attempt confirmed " + str.format_time(sConfirmed, "dd/MM HH:mm", NY)))
                drawSlot += 1
            float headingSpan = group == 0 ? (originCount + followCount) * clusterStep - clusterStep + bodyWidth + (followCount > 0 ? groupGap : 0) : groupCount * clusterStep - clusterStep + bodyWidth
            int headingTime = groupStartTime + int(headingSpan * 0.5 * chartSeconds * 1000)
            label.set_xy(heading, headingTime, nz(group == 3 ? largerTop : mainTop, high) + captionGap * 0.65)
            label.set_style(heading, label.style_label_down)
            string headingText = group == 0 ? f_tfName(htf) : group == 3 ? f_tfName(largerTf) : ""
            label.set_text(heading, headingText)
            label.set_textcolor(heading, group == 2 ? color.gray : chart.fg_color)
            label.set_tooltip(heading, group == 2 ? "Ended attempt only | " + f_endTag(visibleArchive.endReason) + " | End " + str.format_time(visibleArchive.endedAt, "dd/MM HH:mm", NY) + " NY" : group == 3 ? "Larger HTF " + largerTf + " | confirmed candles + live OHLC | signal engine controlled by Larger HTF signals" : contextOnlyCluster ? "Main HTF OHLC context only" : "Parent C1 " + str.format_time(sAT, "dd/MM HH:mm", NY) + " NY | Attempt " + str.tostring(int((sFlags + 1) / 2)) + " confirmed " + str.format_time(sConfirmed, "dd/MM HH:mm", NY) + " NY | entry window only after that confirmation")
            cursor += groupCount * clusterStep + groupGap
    int remaining = not na(liveEnd) ? math.max(0, int((liveEnd - timenow) / 1000)) : 0
    label.set_text(clockLabel, "")


bool modelEvent = changedModel and focusAvailable and sModelAge == 0 and barstate.isconfirmed
alertcondition(modelEvent, "HTF", "TFA CRT: C2 confirmed; observe C3.")
alertcondition(modelEvent and sPhase == 1, "TS", "TFA CRT: confirmed one-sided HTF sweep and reclaim. Observe C3.")
alertcondition(entryLong, "E+", "TFA CRT Pure TS: confirmed LTF Buy signal in C3. See tooltip.")
alertcondition(entryShort, "E-", "TFA CRT Pure TS: confirmed LTF Sell signal in C3. See tooltip.")

alertcondition(higherResult.hit and higherResult.dir == 1, "Higher HTF E+", "TFA: independent higher HTF Buy confirmation. See source timeframe tooltip.")
alertcondition(higherResult.hit and higherResult.dir == -1, "Higher HTF E-", "TFA: independent higher HTF Sell confirmation. See source timeframe tooltip.")

alertcondition(earlyResult.hit and earlyResult.dir == 1, "Early C2 E+ · experimental", "TFA Early C2 Buy: provisional C2, not HTF confirmed. See E tooltip.")
alertcondition(earlyResult.hit and earlyResult.dir == -1, "Early C2 E- · experimental", "TFA Early C2 Sell: provisional C2, not HTF confirmed. See E tooltip.")

alertcondition(requireMps and ((mainMpsResult.event and sDir == 1) or (higherMpsResult.event and higher.dir == 1)), "MPS +", "TFA: bullish MPS observed. Start looking for entry; this is not an entry alert. See source tooltip.")
alertcondition(requireMps and ((mainMpsResult.event and sDir == -1) or (higherMpsResult.event and higher.dir == -1)), "MPS -", "TFA: bearish MPS observed. Start looking for entry; this is not an entry alert. See source tooltip.")
