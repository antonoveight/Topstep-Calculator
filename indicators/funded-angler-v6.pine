int sInnerLoT = na
sArchived = not na(mainSnapshot) ? mainSnapshot.archive : ModelArchive.new()
kCrtKey = mainSelected.crtKey
sEqTouched = mainSelected.eqTouched
sAEnd = mainSelected.aEnd
sCEnd = mainSelected.cEnd
sBEnd = mainSelected.bEnd

// Packed UDT avoids exceeding Pine's combined 127 request tuple elements.
type HigherSnapshot
    int id = na
    int flags = 0
    int phase = 0
    int dir = 0
    float hi = na
    float lo = na
    float inv = na
    float cp = na
    int confirmed = na
    int resolved = na
    int age = 0
    int aT = na
    int aEnd = na
    int bT = na
    int bEnd = na
    int reason = 0
    int cEnd = na
    CrtKey key = na
f_asHigher(RegistrySnapshot prior) =>
    Model m = not na(prior) ? prior.model : Model.new()
    HigherSnapshot.new(id=m.uid, flags=m.flags, phase=m.phase, dir=m.dir, hi=m.hi, lo=m.lo, inv=m.inv, cp=m.cp, confirmed=m.confirmedAt, resolved=m.resolvedAt, age=not na(prior) ? prior.age : na, aT=m.aT, aEnd=m.aEnd, bT=m.bT, bEnd=m.bEnd, cEnd=m.cEnd, reason=not na(prior) ? prior.reason : 0, key=m.crtKey)
f_higherSnapshot(simple string sourceTf) =>
    f_asHigher(f_engine(sourceTf))
f_higherBundle(simple string sourceTf) =>
    SourcePacket source = f_sourcePacket(sourceTf)
    HigherSnapshot model = f_asHigher(f_engineFromSource(sourceTf, source))
    KeyMap keys = f_executionFromSource(source)
    ClockPreview frame = f_sourceFrame(sourceTf)
    [model, keys, frame]
bool higherSignalTfValid = isLtf and timeframe.in_seconds(largerTf) > htfSeconds and timeframe.in_seconds(largerTf) % chartSeconds == 0 and timeframe.in_seconds(biasTf) >= timeframe.in_seconds(largerTf)
[requestedHigher, executionLarger, largerPreview] = request.security(syminfo.tickerid, f_transportTf(largerTf), f_higherBundle(largerTf), lookahead=f_sourceLookahead(largerTf), calc_bars_count=f_sourceDepth(largerTf))
HigherSnapshot requestedBiasModel = request.security(syminfo.tickerid, f_transportTf(biasTf), f_higherSnapshot(biasTf), lookahead=f_sourceLookahead(biasTf), calc_bars_count=f_sourceDepth(biasTf))
HigherSnapshot higher = enableLargerSignals and higherSignalTfValid ? requestedHigher : HigherSnapshot.new()

f_executionKey(int direction, int knownBefore, float peakHigh, float peakLow, float reclaimClose) =>
    CrtKey found = f_rangeReaction(executionH1, knownBefore, direction, peakHigh, peakLow, reclaimClose)
    if found.kind == 0
        found := f_rangeReaction(executionMain, knownBefore, direction, peakHigh, peakLow, reclaimClose)
    if found.kind == 0
        found := f_rangeReaction(executionLarger, knownBefore, direction, peakHigh, peakLow, reclaimClose)
    if found.kind == 0
        found := f_rangeReaction(executionBias, knownBefore, direction, peakHigh, peakLow, reclaimClose)
    if found.kind > 0
        found.beforeTime := knownBefore
    found

// Freeze the nearest opposing HTF key known at the local TS close.
// This is an intermediate objective; it does not replace the CRT range target.
f_nextBarrier(KeyMap references, int beforeTime, int direction, float origin, float targetLevel) =>
    CrtKey found = CrtKey.new()
    float best = na
    if not na(references) and not na(references.levels)
        for k in references.levels
            float level = direction == 1 ? k.lo : k.hi
            float distance = direction == 1 ? level - origin : origin - level
            float room = direction == 1 ? targetLevel - origin : origin - targetLevel
            bool enabled = keyTypes == "All" or keyTypes == "Swing" and k.kind == 3 or keyTypes == "Swing + FVG" and (k.kind == 3 or k.kind == 1) or keyTypes == "Swing + OB" and (k.kind == 3 or k.kind == 2) or keyTypes == "Open / Close" and (k.kind == 4 or k.kind == 5) or keyTypes == "Weekly wick" and k.kind == 6
            bool eligible = enabled and k.kind > 0 and k.dir == -direction and not na(k.knownAt) and k.knownAt <= beforeTime and distance > sweepSize and distance < room
            if eligible and (na(best) or distance < best)
                found := k.copy()
                found.beforeTime := beforeTime
                best := distance
    found

f_forwardKey(int direction, int beforeTime, float origin, float targetLevel) =>
    CrtKey found = f_nextBarrier(executionH1, beforeTime, direction, origin, targetLevel)
    CrtKey nextexecutionMain = f_nextBarrier(executionMain, beforeTime, direction, origin, targetLevel)
    if nextexecutionMain.kind > 0 and (found.kind == 0 or (direction == 1 ? nextexecutionMain.lo < found.lo : nextexecutionMain.hi > found.hi))
        found := nextexecutionMain
    CrtKey nextexecutionLarger = f_nextBarrier(executionLarger, beforeTime, direction, origin, targetLevel)
    if nextexecutionLarger.kind > 0 and (found.kind == 0 or (direction == 1 ? nextexecutionLarger.lo < found.lo : nextexecutionLarger.hi > found.hi))
        found := nextexecutionLarger
    CrtKey nextexecutionBias = f_nextBarrier(executionBias, beforeTime, direction, origin, targetLevel)
    if nextexecutionBias.kind > 0 and (found.kind == 0 or (direction == 1 ? nextexecutionBias.lo < found.lo : nextexecutionBias.hi > found.hi))
        found := nextexecutionBias
    found

f_keyProofValid(CrtKey key, int reactedAt, float sourceClose, int sourceEnd) =>
    bool known = not na(key) and key.kind > 0 and not na(reactedAt) and not na(key.knownAt) and key.knownAt <= key.beforeTime
    bool subsequentClose = not na(sourceEnd) and sourceEnd > reactedAt
    bool broken = known and subsequentClose and (key.dir == 1 ? sourceClose < key.lo : sourceClose > key.hi)
    known and not broken

f_executionProofValid(CrtKey key, int reactedAt) =>
    // Weekly levels stay fixed; subsequent CLOSED H1 prices validate local reclaim.
    KeyMap source = not na(key) and (key.kind == 6 or key.tf == "60") ? executionH1 : not na(key) and key.tf == htf ? executionMain : not na(key) and key.tf == largerTf ? executionLarger : not na(key) and key.tf == biasTf ? executionBias : na
    not na(source) and f_keyProofValid(key, reactedAt, source.sourceClose, source.sourceEnd)


// A separate confirmed CRT hypothesis on Bias TF supplies context, not an order.
HigherSnapshot biasModel = timeframe.in_seconds(biasTf) > timeframe.in_seconds(largerTf) ? requestedBiasModel : HigherSnapshot.new()
// Independent bias from the chosen reference TF: confirmed reclaim or range close-through.
f_clockBiasValues() =>
    if f_alignedTf(biasTf)
        AlignedTape feed = f_alignedTape(biasTf)
        ClockCandle b = f_tapeBar(feed.bars, 0)
        ClockCandle p = f_tapeBar(feed.bars, 1)
        [ph, pl, pivotAt] = f_tapePivots(feed.bars)
        var BiasState state = BiasState.new()
        var int processed = na
        if feed.changed and not na(b.t) and (na(processed) or b.t > processed)
            f_biasStep(state, ph, pl, b.c, p.c)
            processed := b.t
        float guardHigh = state.direction == -1 and not na(state.protectedHigh) ? math.min(b.h, state.protectedHigh) : b.h
        float guardLow = state.direction == 1 and not na(state.protectedLow) ? math.max(b.l, state.protectedLow) : b.l
        [state.direction, state.age, state.swingHigh, state.swingLow, guardHigh, guardLow]
    else
        f_biasSnapshot(true)
[requestedBiasDirection, requestedBiasAge, requestedBiasHigh, requestedBiasLow, requestedGuardHigh, requestedGuardLow] = request.security(syminfo.tickerid, f_transportTf(biasTf), f_clockBiasValues(), lookahead=f_sourceLookahead(biasTf), calc_bars_count=f_sourceDepth(biasTf))
[localBiasDirection, localBiasAge, localBiasHigh, localBiasLow, localGuardHigh, localGuardLow] = f_biasSnapshot(not barstate.isconfirmed)
autoBias = chartSeconds == timeframe.in_seconds(biasTf) and not f_alignedTf(biasTf) ? localBiasDirection : requestedBiasDirection
autoBiasAge = chartSeconds == timeframe.in_seconds(biasTf) and not f_alignedTf(biasTf) ? localBiasAge : requestedBiasAge
autoBiasHigh = chartSeconds == timeframe.in_seconds(biasTf) and not f_alignedTf(biasTf) ? localBiasHigh : requestedBiasHigh
autoBiasLow = chartSeconds == timeframe.in_seconds(biasTf) and not f_alignedTf(biasTf) ? localBiasLow : requestedBiasLow
autoGuardHigh = chartSeconds == timeframe.in_seconds(biasTf) and not f_alignedTf(biasTf) ? localGuardHigh : requestedGuardHigh
autoGuardLow = chartSeconds == timeframe.in_seconds(biasTf) and not f_alignedTf(biasTf) ? localGuardLow : requestedGuardLow
int structureBias = biasMode == "Auto" ? nz(autoBias) : biasMode == "Long" ? 1 : biasMode == "Short" ? -1 : 0
float biasCheckClose = barstate.isconfirmed ? close : close[1]
bool biasPaused = biasMode == "Auto" and chartSeconds < timeframe.in_seconds(biasTf) and (structureBias == 1 ? not na(autoGuardLow) and biasCheckClose < autoGuardLow : structureBias == -1 ? not na(autoGuardHigh) and biasCheckClose > autoGuardHigh : false)
int biasDir = biasPaused ? 0 : structureBias

// Native H2/H4 chart bars straddle the session clock: preview them from H1.
// Closed frame members also supply Early/SMT. Developing OHLC is display-only.
// On charts above H1, lookahead_off selects the last available H1 intrabar.
bool mainUsesPreview = f_alignedTf(htf) and chartSeconds > 3600
bool largerUsesPreview = f_alignedTf(largerTf) and chartSeconds > 3600

// Preview is aggregated from THIS chart's actual bars, including the live bar.
// Incomplete first buckets are not presented as complete OHLC candles.
[alignedBucketTime, alignedBucketEnd] = f_sessionTimes(htf)
int bucketTime = f_alignedTf(htf) ? alignedBucketTime : time(htf)
int bucketEnd = f_alignedTf(htf) ? alignedBucketEnd : time_close(htf)
var float liveO = na
var float liveH = na
var float liveL = na
var float liveC = na
var int liveT = na
var int liveEnd = na
var int liveHighTime = na
var int liveLowTime = na
var bool liveComplete = false
var int bucketCounter = 0
var array<int> candleTimes = array.new<int>()
var array<int> candleEndTimes = array.new<int>()
var array<float> candleOpens = array.new<float>()
var array<float> candleHighs = array.new<float>()
var array<float> candleLows = array.new<float>()
var array<float> candleCloses = array.new<float>()
var array<int> candleHighTimes = array.new<int>()
var array<int> candleLowTimes = array.new<int>()
bool newBucket = not na(bucketTime) and (na(liveT) or bucketTime != liveT)
if not mainUsesPreview
    if newBucket
        if not na(liveT) and liveComplete
            array.push(candleTimes, liveT)
            array.push(candleEndTimes, liveEnd)
            array.push(candleOpens, liveO)
            array.push(candleHighs, liveH)
            array.push(candleLows, liveL)
            array.push(candleCloses, liveC)
            array.push(candleHighTimes, liveHighTime)
            array.push(candleLowTimes, liveLowTime)
            if array.size(candleTimes) > 1000
                array.shift(candleTimes)
                array.shift(candleEndTimes)
                array.shift(candleOpens)
                array.shift(candleHighs)
                array.shift(candleLows)
                array.shift(candleCloses)
                array.shift(candleHighTimes)
                array.shift(candleLowTimes)
        bucketCounter += 1
        liveT := bucketTime
        liveEnd := bucketEnd
        liveO := open
        liveH := high
        liveL := low
        liveC := close
        liveHighTime := time
        liveLowTime := time
        liveComplete := time == bucketTime
    else if not na(bucketTime)
        if high > liveH
            liveHighTime := time
        if low < liveL
            liveLowTime := time
        liveH := math.max(liveH, high)
        liveL := math.min(liveL, low)
        liveC := close

else
    if not na(mainPreview)
        liveT := mainPreview.live.t
        liveEnd := mainPreview.live.e
        liveO := mainPreview.live.o
        liveH := mainPreview.live.h
        liveL := mainPreview.live.l
        liveC := mainPreview.live.c
        liveComplete := mainPreview.complete
        liveHighTime := liveT
        liveLowTime := liveT
        if liveT != liveT[1]
            bucketCounter += 1
        array<ClockCandle> completed = array.from(mainPreview.third, mainPreview.second, mainPreview.first)
        for item in completed
            if not na(item.t) and (array.size(candleTimes) == 0 or item.t > array.last(candleTimes))
                array.push(candleTimes, item.t)
                array.push(candleEndTimes, item.e)
                array.push(candleOpens, item.o)
                array.push(candleHighs, item.h)
                array.push(candleLows, item.l)
                array.push(candleCloses, item.c)
                array.push(candleHighTimes, item.t)
                array.push(candleLowTimes, item.t)

// Confirmed larger-TF bars use explicit history offsets. The forming bar is
// aggregated from this chart only; an incomplete first bucket is omitted.
int h3T = not na(largerPreview) ? largerPreview.third.t : na
float h3O = not na(largerPreview) ? largerPreview.third.o : na
float h3H = not na(largerPreview) ? largerPreview.third.h : na
float h3L = not na(largerPreview) ? largerPreview.third.l : na
float h3C = not na(largerPreview) ? largerPreview.third.c : na
int h3End = not na(largerPreview) ? largerPreview.third.e : na
int h2T = not na(largerPreview) ? largerPreview.second.t : na
float h2O = not na(largerPreview) ? largerPreview.second.o : na
float h2H = not na(largerPreview) ? largerPreview.second.h : na
float h2L = not na(largerPreview) ? largerPreview.second.l : na
float h2C = not na(largerPreview) ? largerPreview.second.c : na
int h2End = not na(largerPreview) ? largerPreview.second.e : na
int h1T = not na(largerPreview) ? largerPreview.first.t : na
float h1O = not na(largerPreview) ? largerPreview.first.o : na
float h1H = not na(largerPreview) ? largerPreview.first.h : na
float h1L = not na(largerPreview) ? largerPreview.first.l : na
float h1C = not na(largerPreview) ? largerPreview.first.c : na
int h1End = not na(largerPreview) ? largerPreview.first.e : na
[alignedLargerTime, alignedLargerEnd] = f_sessionTimes(largerTf)
int largerBucket = f_alignedTf(largerTf) ? alignedLargerTime : time(largerTf)
int largerEnd = f_alignedTf(largerTf) ? alignedLargerEnd : time_close(largerTf)
var int largerLiveT = na
var float largerLiveO = na
var float largerLiveH = na
var float largerLiveL = na
var float largerLiveC = na
var bool largerComplete = false
if not largerUsesPreview
    if not na(largerBucket) and (na(largerLiveT) or largerLiveT != largerBucket)
        largerLiveT := largerBucket
        largerLiveO := open
        largerLiveH := high
        largerLiveL := low
        largerLiveC := close
        largerComplete := time == largerBucket
    else if not na(largerBucket)
        largerLiveH := math.max(largerLiveH, high)
        largerLiveL := math.min(largerLiveL, low)
        largerLiveC := close
else if not na(largerPreview)
    largerLiveT := largerPreview.live.t
    largerEnd := largerPreview.live.e
    largerLiveO := largerPreview.live.o
    largerLiveH := largerPreview.live.h
    largerLiveL := largerPreview.live.l
    largerLiveC := largerPreview.live.c
    largerComplete := largerPreview.complete



// The HTF snapshot is immutable. A chart-side latch retires it on CLOSED LTF
// evidence without waiting for the forming HTF candle to close or rewriting history.
type FocusLifecycle
    int uid = na
    int reason = 0
    int confirmation = na
    bool rangeDone = false
    int endedAt = na
    ModelArchive archived = na

f_stepFocus(FocusLifecycle state, int uid, int direction, int confirmedAt, float invalidation, float targetLevel, int age, int barOpen, int barClose, float barHigh, float barLow, bool closedBar, bool attemptOpen = true) =>
    int endedNow = 0
    if not na(uid) and (na(state.uid) or state.uid != uid)
        state.uid := uid
        state.rangeDone := false
        state.confirmation := na
    if not na(uid) and (na(state.confirmation) or state.confirmation != confirmedAt)
        state.confirmation := confirmedAt
        state.reason := 0
        state.endedAt := na
    if not na(uid) and closedBar and barOpen >= confirmedAt and (direction == 1 ? barHigh >= targetLevel : barLow <= targetLevel)
        state.rangeDone := true
    if not na(uid) and state.reason == 0 and closedBar and attemptOpen
        bool older = barOpen >= confirmedAt
        int reason = f_crtEnd(direction, invalidation, targetLevel, barHigh, barLow, na, older, false, false, false)
        if reason != 0
            state.reason := reason
            state.endedAt := barClose
            endedNow := reason
    endedNow

f_visibleArchive(ModelArchive localArchive, ModelArchive htfArchive) =>
    bool localReady = not na(localArchive) and not na(localArchive.aT)
    bool htfReady = not na(htfArchive) and not na(htfArchive.aT)
    bool preferLocal = localReady and (not htfReady or (localArchive.aT == htfArchive.aT and localArchive.bEnd == htfArchive.bEnd) or localArchive.endedAt >= htfArchive.endedAt)
    preferLocal ? localArchive : htfArchive

var FocusLifecycle focusLife = FocusLifecycle.new()
int focusEndedNow = f_stepFocus(focusLife, sId, sDir, sConfirmed, sInv, sCp, sModelAge, time, time_close, high, low, barstate.isconfirmed, sPhase == 1)
if focusEndedNow != 0
    // The local event may be mid-HTF: preserve C1/C2, never fabricate a closed C3.
    focusLife.archived := ModelArchive.new(aEnd=sAEnd, bEnd=sBEnd, aO=sAO, aH=sAH, aL=sAL, aC=sAC, aT=sAT, bO=sBO, bH=sBH, bL=sBL, bC=sBC, bT=sBT, endReason=focusEndedNow, endedAt=time_close)
bool rangeAvailable = not na(sId) and not (focusLife.uid == sId and focusLife.rangeDone)
bool focusAvailable = rangeAvailable and sPhase == 1 and focusLife.uid == sId and focusLife.confirmation == sConfirmed and focusLife.reason == 0
var FocusLifecycle higherLife = FocusLifecycle.new()
int higherEndedNow = f_stepFocus(higherLife, higher.id, higher.dir, higher.confirmed, higher.inv, higher.cp, higher.age, time, time_close, high, low, barstate.isconfirmed, higher.phase == 1)
bool higherAvailable = enableLargerSignals and higherSignalTfValid and not na(higher.id) and higher.phase == 1 and not higherLife.rangeDone and higherLife.uid == higher.id and higherLife.confirmation == higher.confirmed and higherLife.reason == 0

var FocusLifecycle biasLife = FocusLifecycle.new()
int biasEndedNow = f_stepFocus(biasLife, biasModel.id, biasModel.dir, biasModel.confirmed, biasModel.inv, biasModel.cp, biasModel.age, time, time_close, high, low, barstate.isconfirmed, biasModel.phase == 1)
bool biasModelLive = not na(biasModel.id) and biasModel.phase == 1 and biasLife.uid == biasModel.id and not biasLife.rangeDone and biasLife.reason == 0
bool higherAtKey = higherAvailable and not na(higher.key) and higher.key.kind > 0 and f_executionProofValid(higher.key, higher.confirmed)
bool biasAtKey = biasModelLive and not na(biasModel.key) and biasModel.key.kind > 0 and f_executionProofValid(biasModel.key, biasModel.confirmed)
ModelArchive visibleArchive = f_visibleArchive(focusLife.archived, sArchived)
int lastSetupEnd = not na(visibleArchive) and not na(visibleArchive.aT) ? visibleArchive.endReason : sReason


// CRT time follows the actual feed candle boundaries, including session gaps.
// No clock-hour gate: actual source intervals and attempt INV/TGT govern entries.
bool timeAllowed = true
string crtTimeText = na(liveEnd) ? "-" : (rangeAvailable ? (focusAvailable ? "HTF " : "WATCH ") : "HTF ") + str.format_time(liveEnd, "HH:mm", NY) + " NY"

// Independent M15 structure. Only a closed source snapshot may enter the cache.
// lookahead_off plus the actual source end/closed chart gate handles historical
// last-child availability and ignores provisional realtime source updates.
type StructureBar
    float hi = na
    float lo = na
    int hiAt = na
    int loAt = na
    float closing = na
    float previous = na
    int opened = na
    int closed = na
f_structureSource() =>
    var float sh = na
    var float sl = na
    var int sht = na
    var int slt = na
    float ph = ta.pivothigh(high, pivotLength, pivotLength)
    float pl = ta.pivotlow(low, pivotLength, pivotLength)
    if not na(ph)
        sh := ph
        sht := time[pivotLength]
    if not na(pl)
        sl := pl
        slt := time[pivotLength]
    StructureBar.new(hi=sh, lo=sl, hiAt=sht, loAt=slt, closing=close, previous=close[1], opened=time, closed=time_close)
f_structureReady(int sourceEnd, int chartEnd, int previousEnd) =>
    not na(sourceEnd) and sourceEnd <= chartEnd and (na(previousEnd) or sourceEnd > previousEnd)
bool useM15Structure = structureMode == "M15" and chartSeconds < 900
StructureBar requestedStructure = request.security(syminfo.tickerid, "15", f_structureSource(), lookahead=barmerge.lookahead_off, calc_bars_count=requestDepth)
StructureBar structureRaw = useM15Structure ? requestedStructure : StructureBar.new()
var StructureBar structureClosed = StructureBar.new()
bool structureUpdated = barstate.isconfirmed and useM15Structure and f_structureReady(structureRaw.closed, time_close, structureClosed.closed)
if structureUpdated
    structureClosed := structureRaw.copy()
bool structureBarReady = not useM15Structure or structureUpdated
float structureClosing = useM15Structure ? structureClosed.closing : close
float structurePriorClose = useM15Structure ? structureClosed.previous : close[1]
float structureBeforeClose = useM15Structure ? (not na(structureClosed[1]) ? (structureClosed[1]).closing : na) : close[1]
int structureClosedAt = useM15Structure ? structureClosed.closed : time_close

type SignalContext
    int c1T = na
    int c2T = na
    int c2End = na
    int c3End = na
    int parentDir = 0
    int parentConfirmed = na
    bool parentLive = false
    bool parentAtKey = false
    int age = 0
    CrtKey crtKey = na
    int id = na
    int kind = 0
    int flags = 0
    int phase = 0
    int dir = 0
    int confirmed = na
    int resolved = na
    float hi = na
    float lo = na
    float inv = na
    float cp = na
type ReactionState
    int sourceRoot = na
    int sourceC2 = na
    int sourceEnd = na
    string chainRole = "LOCAL"
    string biasRole = "FLOW"
    CrtKey forwardKey = na
    float nextObjective = na
    bool objectiveReached = false
    int objectiveAt = na
    string key = ""
    int activatedAt = na
    int phaseAt = na
    int confirmIndex = na
    int confirmTime = na
    float confirmLevel = na
    float localExtreme = na
    bool localStopTaken = false
    bool localTargetTaken = false
    bool sent = false
    bool everSent = false
    int branchMask = 0
    float mpsRef = na
    int mpsRefAt = na
    float p1Ref = na
    int p1At = na
    int raidIndex = na
    float raidExtreme = na
    bool raidReclaimed = false
    int raidAt = na
    int p3At = na
    float p3High = na
    float p3Low = na
    CrtKey p3Key = na
    int p3KeyAt = na
    bool p3KeyBroken = false
    int mpsAt = na
    bool mpsEvent = false
    float legExtreme = na
    float gapLow = na
    float gapHigh = na
    int gapAt = na
    int gapOrigin = na
    bool gapBroken = false
    int lastClosedAt = na
    int lastSignalBar = na
    int lastSignalTime = na
    float lastSignalHigh = na
    float lastSignalLow = na
type ChannelResult
    bool evaluated = false
    bool legDetected = false
    float referencePrice = na
    int referenceKnownAt = na
    int legKnownAt = na
    int zoneKnownAt = na
    float zoneLow = na
    float zoneHigh = na
    bool tsDetected = false
    bool retestDetected = false
    bool entryDetected = false
    bool counterBias = false
    CrtKey keyRef = na
    bool hit = false
    int dir = 0
    int kind = 0
    int flags = 0
    int phase = 0
    int id = na
    string key = ""
    string tag = ""
    string status = "WAIT"
    float cp = na
    float inv = na
    int confirmTime = na

f_contextKey(int id, int resolved, int direction) =>
    na(id) ? "" : str.tostring(id) + ":" + str.tostring(resolved) + ":" + str.tostring(direction)
f_clearReaction(ReactionState state, int phaseAt, float seedPivot, bool keepRun = false) =>
    state.phaseAt := phaseAt
    state.confirmIndex := na
    state.confirmTime := na
    state.confirmLevel := na
    state.localExtreme := na
    state.sent := false

// Independent closed-bar branches. Each local TS/P3 must prove its own HTF key;
// MPS confirms only the OTE branch, never the direct TS or FVG branch.
f_stepChannel(SignalContext ctx, ReactionState state, float knownHigh, float knownLow, float pivotHigh, float pivotLow, bool waveAllowed = true, bool forcePullback = false, bool mpsAllowed = true, int knownHighAt = na, int knownLowAt = na) =>
    ChannelResult result = ChannelResult.new(dir=ctx.dir, kind=ctx.kind, flags=ctx.flags, phase=ctx.phase, id=ctx.id, key=state.key, cp=ctx.cp, inv=ctx.inv)
    state.mpsEvent := false
    bool armed = not na(ctx.id) and ctx.kind == 1 and ctx.dir != 0
    result.status := not isLtf ? "VIEW TF" : not armed ? "WAIT CRT" : "WAIT CLOSE"
    if armed and barstate.isconfirmed and isLtf and time >= state.activatedAt and (na(state.lastClosedAt) or state.lastClosedAt != time_close)
        state.lastClosedAt := time_close
        result.evaluated := true
        if na(state.sourceRoot) and not na(ctx.c1T)
            state.sourceRoot := ctx.c1T
            state.sourceC2 := ctx.c2T
            state.sourceEnd := ctx.c2End
        bool chainAllowed = na(ctx.c1T) or (state.sourceRoot == ctx.c1T and state.sourceC2 == ctx.c2T and state.sourceEnd == ctx.c2End )
        bool bullish = ctx.dir == 1
        bool invalidBar = bullish ? low <= ctx.inv : high >= ctx.inv
        bool targetBar = bullish ? high >= ctx.cp : low <= ctx.cp
        state.localStopTaken := state.localStopTaken or invalidBar
        state.localTargetTaken := state.localTargetTaken or targetBar
        bool ended = state.localStopTaken or state.localTargetTaken
        bool priorKey = not na(ctx.crtKey) and ctx.crtKey.kind > 0 and ctx.crtKey.dir == ctx.dir and not na(ctx.crtKey.knownAt) and ctx.crtKey.knownAt <= ctx.crtKey.beforeTime and ctx.crtKey.beforeTime < ctx.confirmed
        bool keyHeld = priorKey and (bullish ? close > ctx.crtKey.lo : close < ctx.crtKey.hi)
        bool opposingBias = biasDir == -ctx.dir and biasDir != 0
        bool oppositeClose = bullish ? close > open : close < open
        // P1 -> P2 must exist BEFORE the raid. A candle engulfing its immediate
        // predecessor can still reclaim P1; that predecessor is not the CRT range.
        bool orderedPair = not na(knownHigh) and not na(knownLow) and knownHigh > knownLow and not na(knownHighAt) and not na(knownLowAt) and (bullish ? knownLowAt < knownHighAt and knownHighAt < time : knownHighAt < knownLowAt and knownLowAt < time)
        float candidateP1 = bullish ? knownLow : knownHigh
        int candidateP1At = bullish ? knownLowAt : knownHighAt
        float candidateP2 = bullish ? knownHigh : knownLow
        int candidateP2At = bullish ? knownHighAt : knownLowAt
        bool candidateRaid = orderedPair and (bullish ? low <= candidateP1 - sweepSize : high >= candidateP1 + sweepSize)
        bool candidateUnspent = bullish ? structureBeforeClose <= candidateP2 : structureBeforeClose >= candidateP2
        float candidateSpan = math.abs(candidateP1 - candidateP2)
        bool candidateAccepted = orderedPair and (bullish ? close < candidateP1 - candidateSpan : close > candidateP1 + candidateSpan)
        bool inside = close > low[1] and close < high[1]
        bool lowRaid = low <= low[1] - sweepSize
        bool highRaid = high >= high[1] + sweepSize
        bool sourceReady = not na(time[1]) and time[1] >= state.activatedAt
        bool adjacentTs = sourceReady and inside and oppositeClose and (bullish ? lowRaid and not highRaid : highRaid and not lowRaid)
        bool pendingLost = not na(state.confirmIndex) and (bullish ? low <= state.localExtreme : high >= state.localExtreme)
        bool expired = not na(state.confirmIndex) and bar_index - state.confirmIndex > 36
        bool raidExpired = not na(state.raidIndex) and bar_index - state.raidIndex > 36
        // A close a full P1-P2 range beyond P1 is an accepted expansion, not a
        // small renewed raid. Release that old parent so a new wave can form.
        float parentSpan = math.abs(state.p1Ref - state.mpsRef)
        bool rangeAccepted = not na(state.p1At) and parentSpan > sweepSize and (bullish ? close < state.p1Ref - parentSpan : close > state.p1Ref + parentSpan)
        if raidExpired or expired or rangeAccepted or (pendingLost and not na(state.mpsAt))
            state.p1Ref := na
            state.p1At := na
            state.raidIndex := na
            state.raidExtreme := na
            state.raidReclaimed := false
            state.mpsRef := na
            state.mpsRefAt := na
            state.raidAt := na
            state.p3At := na
            state.p3Key := na
            state.p3KeyAt := na
            state.p3KeyBroken := false
        if pendingLost or expired or raidExpired or rangeAccepted
            state.confirmIndex := na
            state.confirmTime := na
            state.mpsAt := na
            state.gapAt := na
        // An unreclaimed candidate can advance to a newer completed P1/P2 pair.
        // After the FIRST reclaim, freeze that parent through further raid wicks.
        bool replaceCandidate = na(state.p1At) or (not state.raidReclaimed and candidateP1At > state.p1At)
        if candidateRaid and candidateUnspent and not candidateAccepted and replaceCandidate and not ended
            state.p1Ref := candidateP1
            state.p1At := candidateP1At
            state.mpsRef := candidateP2
            state.mpsRefAt := candidateP2At
            state.raidIndex := bar_index
            state.raidExtreme := bullish ? low : high
            state.raidReclaimed := false
            state.raidAt := time
            state.p3At := time
            state.p3High := high
            state.p3Low := low
            // Capture at the peak, before a later HTF close can consume the key.
            // This is only a candidate; the actual TS close must still reclaim it.
            state.p3Key := f_executionKey(ctx.dir, time, high, low, bullish ? high : low)
            state.p3KeyAt := na
            state.p3KeyBroken := false
        bool hasRaid = not na(state.p1At)
        if hasRaid
            bool newPeak = bullish ? low < state.raidExtreme : high > state.raidExtreme
            if newPeak
                state.p3At := time
                state.p3High := high
                state.p3Low := low
                state.p3Key := f_executionKey(ctx.dir, state.raidAt, high, low, bullish ? high : low)
                state.p3KeyAt := na
                state.p3KeyBroken := false
            state.raidExtreme := bullish ? math.min(state.raidExtreme, low) : math.max(state.raidExtreme, high)
        bool freshRaid = na(state.confirmIndex) or (bullish ? low <= state.p1Ref - sweepSize : high >= state.p1Ref + sweepSize)
        bool structuralTs = hasRaid and freshRaid and oppositeClose and (bullish ? close > state.p1Ref : close < state.p1Ref)
        bool localTs = structuralTs or (not hasRaid and adjacentTs)
        // A fresh TS starts its own branch budget. No global direction latch.
        bool newTs = localTs and not ended and (na(state.confirmIndex) or state.branchMask == 7)
        if newTs
            state.forwardKey := f_forwardKey(ctx.dir, time, close, ctx.cp)
            state.nextObjective := state.forwardKey.kind > 0 ? (bullish ? state.forwardKey.lo : state.forwardKey.hi) : na
            state.objectiveReached := false
            state.objectiveAt := na
            state.confirmIndex := bar_index
            state.confirmTime := time
            state.confirmLevel := hasRaid ? state.p1Ref : bullish ? low[1] : high[1]
            state.localExtreme := hasRaid ? state.raidExtreme : bullish ? low : high
            bool retainedPeakKey = hasRaid and not na(state.p3Key) and f_keyReact(state.p3Key, state.raidAt, ctx.dir, state.p3High, state.p3Low, close)
            state.p3Key := retainedPeakKey ? state.p3Key : f_executionKey(ctx.dir, hasRaid ? state.raidAt : time, hasRaid ? state.p3High : high, hasRaid ? state.p3Low : low, close)
            state.p3KeyBroken := false
            state.p3KeyAt := state.p3Key.kind > 0 ? time_close : na
            state.branchMask := 0
            if hasRaid
                state.raidReclaimed := true
            else
                state.mpsRef := na
                state.mpsRefAt := na
            state.mpsAt := na
            state.legExtreme := bullish ? high : low
            state.gapAt := na
            state.gapOrigin := na
            state.gapBroken := false
            state.sent := false
        bool hasTs = not na(state.confirmIndex)
        chainAllowed := chainAllowed and (na(ctx.c2T) or na(state.p3At) or state.p3At >= ctx.c2T)
        state.chainRole := not chainAllowed ? "SOURCE LOST" : na(ctx.c2End) or na(state.p3At) ? "LOCAL" : state.p3At < ctx.c2End ? "FROM C2" : not na(ctx.c3End) and state.p3At < ctx.c3End ? "LOCAL C3" : "LOCAL TRACK"
        bool later = hasTs and bar_index > state.confirmIndex
        // A nearby key is an observation, not the CRT target or a trade exit.
        // Count touches only AFTER the TS close; OHLC cannot order its own wick.
        bool reachedForward = later and not na(state.nextObjective) and (bullish ? high >= state.nextObjective : low <= state.nextObjective)
        if reachedForward and not state.objectiveReached
            state.objectiveReached := true
            state.objectiveAt := time_close
        if hasTs and not na(state.p3KeyAt) and not f_executionProofValid(state.p3Key, state.p3KeyAt)
            state.p3KeyBroken := true
        bool localKeyGood = not state.p3KeyBroken and not na(state.p3Key) and state.p3Key.dir == ctx.dir and f_executionProofValid(state.p3Key, state.p3KeyAt)
        bool keyAllowed = not requireKey or localKeyGood
        bool counterStructure = not na(state.p1At) and not na(state.mpsRefAt) and not na(state.p3At) and state.p1At < state.mpsRefAt and state.mpsRefAt < state.p3At and state.p3At <= state.confirmTime and (bullish ? state.localExtreme <= state.p1Ref - sweepSize and close > state.p1Ref : state.localExtreme >= state.p1Ref + sweepSize and close < state.p1Ref)
        bool counterContext = allowCrtCounter and opposingBias and keyHeld and localKeyGood and counterStructure
        bool parentKnown = ctx.parentLive and ctx.parentAtKey and ctx.parentDir != 0 and not na(ctx.parentConfirmed) and ctx.parentConfirmed <= time
        bool againstParent = parentKnown and ctx.parentDir != ctx.dir
        bool parentReversal = allowCrtCounter and keyHeld and localKeyGood and counterStructure
        bool contextAllowed = not againstParent or parentReversal
        bool biasAllowed = (not filterBias or biasDir == ctx.dir or counterContext) and contextAllowed
        state.biasRole := not biasAllowed ? (biasDir == 0 ? "B0" : againstParent ? "HTF CONFLICT" : "BIAS") : againstParent ? "COUNTER SWING" : counterContext ? (parentKnown ? "HTF KEY REV" : "KEY REV") : parentKnown and ctx.confirmed >= ctx.parentConfirmed and localKeyGood ? "CONT" : "FLOW"
        // The source extreme must follow P2, including evidence inherited from
        // Early C2. A whole-C2 high/low from BEFORE P2 cannot become its P3.
        bool mpsOrder = not na(state.p1At) and not na(state.mpsRefAt) and not na(state.p3At) and state.p1At < state.mpsRefAt and state.mpsRefAt < state.p3At and state.p3At <= state.confirmTime
        bool mpsSweep = not na(state.p1Ref) and not na(state.localExtreme) and (bullish ? state.localExtreme <= state.p1Ref - sweepSize : state.localExtreme >= state.p1Ref + sweepSize)
        bool mpsNow = mpsAllowed and structureBarReady and hasTs and chainAllowed and mpsOrder and mpsSweep and localKeyGood and na(state.mpsAt) and not na(state.mpsRef) and (bullish ? structureClosing > state.mpsRef and structurePriorClose <= state.mpsRef : structureClosing < state.mpsRef and structurePriorClose >= state.mpsRef)
        if mpsNow and not ended
            state.mpsAt := structureClosedAt
            state.mpsEvent := true
        // OTE is calculated from the PREVIOUSLY KNOWN first-leg endpoint.
        // A bar extending the endpoint cannot also retrospectively use that zone.
        float legBefore = state.legExtreme
        float span = hasTs ? math.abs(legBefore - state.localExtreme) : na
        float oteLow = bullish ? legBefore - span * 0.8 : legBefore + span * 0.5
        float oteHigh = bullish ? legBefore - span * 0.5 : legBefore + span * 0.8
        bool extendsLeg = hasTs and (bullish ? high > legBefore : low < legBefore)
        bool ote = later and not na(state.mpsAt) and time >= state.mpsAt and span > sweepSize and not extendsLeg and low <= oteHigh and high >= oteLow and oppositeClose and (bullish ? close > oteLow : close < oteHigh)
        // Test an EXISTING gap before discovering a new one on this close.
        bool gapReady = later and not na(state.gapAt) and time >= state.gapAt and not state.gapBroken
        bool gapInvalid = gapReady and (bullish ? close < state.gapLow : close > state.gapHigh)
        bool fvg = gapReady and not gapInvalid and low <= state.gapHigh and high >= state.gapLow and oppositeClose and (bullish ? close > state.gapHigh : close < state.gapLow)
        if gapInvalid
            state.gapBroken := true
        bool canEmit = not ended and chainAllowed and keyAllowed and biasAllowed and timeAllowed and waveAllowed and (signalCadence != "One per model" or not state.everSent)
        bool direct = newTs and entryBranches != "FVG / OTE"
        bool fvgEntry = fvg and entryBranches != "TS close" and not f_has(state.branchMask, 2)
        bool oteEntry = ote and entryBranches != "TS close" and not f_has(state.branchMask, 4)
        int emitted = (direct ? 1 : 0) + (fvgEntry ? 2 : 0) + (oteEntry ? 4 : 0)
        result.tsDetected := localTs
        result.retestDetected := fvg or ote
        result.legDetected := state.mpsEvent
        result.entryDetected := emitted > 0
        result.status := ended ? (state.localStopTaken ? "INV" : "TGT") : not hasTs ? "WAIT TS" : not keyAllowed ? "WAIT P3 KEY" : not biasAllowed ? ((opposingBias or againstParent) and not counterStructure ? "WAIT CT SWING" : "BIAS") : signalCadence == "One per model" and state.everSent ? "USED" : not na(state.mpsAt) ? "WAIT OTE/FVG" : not localKeyGood ? "MPS NO KEY" : "WAIT FVG/MPS"
        if canEmit and emitted > 0
            result.hit := true
            result.tag := (direct ? "TS_CLOSE" : "") + (fvgEntry ? (direct ? "+FVG" : "TS_FVG") : "") + (oteEntry ? (direct or fvgEntry ? "+OTE" : "MPS_OTE") : "")
            result.confirmTime := state.confirmTime
            result.counterBias := counterContext
            result.keyRef := state.p3Key
            result.status := "SIGNAL"
            result.zoneLow := fvgEntry ? state.gapLow : oteEntry ? oteLow : na
            result.zoneHigh := fvgEntry ? state.gapHigh : oteEntry ? oteHigh : na
            result.zoneKnownAt := fvgEntry ? state.gapAt : oteEntry ? time : na
            result.referencePrice := state.mpsRef
            result.legKnownAt := state.mpsAt
            state.branchMask += emitted
            state.sent := true
            state.everSent := true
            state.lastSignalTime := time
            state.lastSignalBar := bar_index
            state.lastSignalHigh := high
            state.lastSignalLow := low
        // Freeze the first leg once the OTE branch is consumed.
        if hasTs and not f_has(state.branchMask, 4)
            state.legExtreme := bullish ? math.max(legBefore, high) : math.min(legBefore, low)
        bool gapSource = later and time[1] >= state.confirmTime
        bool newGap = gapSource and (bullish ? low > high[2] : high < low[2])
        if newGap and not f_has(state.branchMask, 2) and na(state.gapAt)
            state.gapLow := bullish ? high[2] : high
            state.gapHigh := bullish ? low : low[2]
            state.gapAt := time_close
            state.gapOrigin := time[2]
            state.gapBroken := false
    result




var float lastPivotHigh = na
var float lastPivotLow = na
var int lastPivotHighTime = na
var int lastPivotLowTime = na
var int lastBuyTime = na
var int lastSellTime = na
var int lastBuyBar = na
var int lastSellBar = na
float pivotHigh = ta.pivothigh(high, pivotLength, pivotLength)
float pivotLow = ta.pivotlow(low, pivotLength, pivotLength)
if barstate.isconfirmed
    if not useM15Structure and not na(pivotHigh)
        lastPivotHigh := pivotHigh
        lastPivotHighTime := time[pivotLength]
    if not useM15Structure and not na(pivotLow)
        lastPivotLow := pivotLow
        lastPivotLowTime := time[pivotLength]
if structureUpdated
    lastPivotHigh := structureClosed.hi
    lastPivotLow := structureClosed.lo
    lastPivotHighTime := structureClosed.hiAt
    lastPivotLowTime := structureClosed.loAt
// SMT is paired evidence, not a price key or an independent entry trigger.
type SmtBars
    int first = na
    int firstEnd = na
    int second = na
    int secondEnd = na
    float firstHigh = na
    float firstLow = na
    float secondHigh = na
    float secondLow = na
f_smtBars() =>
    SmtBars.new(first=time[2], firstEnd=time_close[2], second=time[1], secondEnd=time_close[1], firstHigh=high[2], firstLow=low[2], secondHigh=high[1], secondLow=low[1])
f_smtFromFrame(ClockPreview frame) =>
    SmtBars result = SmtBars.new()
    if not na(frame) and not na(frame.first) and not na(frame.second)
        result := SmtBars.new(first=frame.second.t, firstEnd=frame.second.e, second=frame.first.t, secondEnd=frame.first.e, firstHigh=frame.second.h, firstLow=frame.second.l, secondHigh=frame.first.h, secondLow=frame.first.l)
    result
f_clockSmtBars(simple string sourceTf) =>
    if f_alignedTf(sourceTf)
        AlignedTape feed = f_alignedTape(sourceTf)
        ClockCandle b = f_tapeBar(feed.bars, 0)
        ClockCandle p = f_tapeBar(feed.bars, 1)
        SmtBars.new(first=p.t, firstEnd=p.e, second=b.t, secondEnd=b.e, firstHigh=p.h, firstLow=p.l, secondHigh=b.h, secondLow=b.l)
    else
        f_smtBars()
f_smtDirection(SmtBars own, SmtBars peer, bool inverse) =>
    bool synchronized = not na(own.first) and not na(peer.first) and own.first == peer.first and own.second == peer.second and own.firstEnd == peer.firstEnd and own.secondEnd == peer.secondEnd
    bool ownHigh = own.secondHigh > own.firstHigh
    bool ownLow = own.secondLow < own.firstLow
    bool peerHigh = peer.secondHigh > peer.firstHigh
    bool peerLow = peer.secondLow < peer.firstLow
    bool buy = synchronized and ownLow and not (inverse ? peerHigh : peerLow)
    bool sell = synchronized and ownHigh and not (inverse ? peerLow : peerHigh)
    buy and not sell ? 1 : sell and not buy ? -1 : 0
bool smtEnabled = smtSymbol != "" and smtSymbol != ticker.standard(syminfo.tickerid)
string peerSymbol = smtEnabled ? smtSymbol : ticker.standard(syminfo.tickerid)
SmtBars ownMainSmt = f_smtFromFrame(mainPreview)
SmtBars peerMainSmt = request.security(peerSymbol, f_transportTf(htf), f_clockSmtBars(htf), lookahead=f_sourceLookahead(htf), ignore_invalid_symbol=true, calc_bars_count=smtEnabled ? f_sourceDepth(htf) : 1)
SmtBars ownHigherSmt = f_smtFromFrame(largerPreview)
SmtBars peerHigherSmt = request.security(peerSymbol, f_transportTf(largerTf), f_clockSmtBars(largerTf), lookahead=f_sourceLookahead(largerTf), ignore_invalid_symbol=true, calc_bars_count=smtEnabled ? f_sourceDepth(largerTf) : 1)
int mainSmt = smtEnabled and not na(peerMainSmt) ? f_smtDirection(ownMainSmt, peerMainSmt, smtRelation == "Inverse") : 0
int higherSmt = smtEnabled and not na(peerHigherSmt) ? f_smtDirection(ownHigherSmt, peerHigherSmt, smtRelation == "Inverse") : 0

// Experimental Early C2 uses only completed chart bars; no final C2 OHLC is read.
type EarlyReference
    int c1End = na
    int start = na
    int finish = na
    int c1Time = na
    float c1O = na
    float c1H = na
    float c1L = na
    float c1C = na
type EarlyState
    int root = na
    int bucket = na
    int lastClose = na
    int dir = 0
    float hi = na
    float lo = na
    int hiAt = na
    int loAt = na
    float highCandleLow = na
    float lowCandleHigh = na
    float setupP1 = na
    int setupP1At = na
    float setupP2 = na
    int setupP2At = na
    bool complete = false
    bool blocked = false
    bool emitted = false
    int attempts = 0
    int reclaimedAt = na
    float attemptSl = na
    float lockedSl = na
    float lockedTp = na
    CrtKey key = na
    ReactionState channel = na
    string status = "WAIT C2"
    string terminalReason = ""
type EarlyResult
    bool hit = false
    int dir = 0
    int bucket = na
    int c1Time = na
    int confirmTime = na
    int reclaimedAt = na
    int attempt = 0
    float inv = na
    float cp = na
    CrtKey keyRef = na
    string status = "WAIT C2"

f_stepEarly(EarlyReference ref, EarlyState state, CrtKey buyKey, CrtKey sellKey, bool buyWave, bool sellWave, bool confirmedHit, bool permitEntry = true, int parentDirection = 0, bool qualifiedParent = false, int parentKnownAt = na) =>
    EarlyResult result = EarlyResult.new(bucket=ref.start, c1Time=ref.c1Time)
    SignalContext deferred = na
    bool deferredTracking = false
    float deferredTarget = na
    if isLtf and barstate.isconfirmed and not na(ref.c1Time) and time >= ref.start
        bool newWindow = na(state.bucket) or state.bucket != ref.start
        if newWindow
            state.root := ref.c1Time
            state.bucket := ref.start
            state.lastClose := ref.start
            state.dir := 0
            state.hi := high
            state.lo := low
            state.hiAt := time
            state.loAt := time
            state.highCandleLow := low
            state.lowCandleHigh := high
            state.setupP1 := na
            state.setupP1At := na
            state.setupP2 := na
            state.setupP2At := na
            state.complete := time == ref.start
            state.blocked := false
            state.emitted := false
            state.attempts := 0
            state.reclaimedAt := na
            state.attemptSl := na
            state.lockedSl := na
            state.lockedTp := na
            state.key := CrtKey.new()
            state.channel := ReactionState.new()
            state.terminalReason := ""
        if not newWindow and time != state.lastClose
            state.complete := false
        state.lastClose := time_close
        bool extended = state.dir == 1 ? low < state.lo : state.dir == -1 ? high > state.hi : false
        // Keep the latest actual touch when an equal extreme is revisited.
        // The companion wick must belong to that same candle.
        if high >= state.hi
            state.hiAt := time
            state.highCandleLow := low
        if low <= state.lo
            state.loAt := time
            state.lowCandleHigh := high
        state.hi := math.max(state.hi, high)
        state.lo := math.min(state.lo, low)
        bool raidLow = state.lo <= ref.c1L - sweepSize
        bool raidHigh = state.hi >= ref.c1H + sweepSize
        bool both = raidLow and raidHigh
        bool inside = close > ref.c1L and close < ref.c1H
        if state.dir == 0 and not both
            state.dir := raidLow ? 1 : raidHigh ? -1 : 0
        bool bullish = state.dir == 1
        // Capture the pre-raid pair while it is known, rather than selecting
        // the new P3 itself as P1 after its pivot becomes confirmed.
        float knownP1 = bullish ? lastPivotLow[1] : lastPivotHigh[1]
        float knownP2 = bullish ? lastPivotHigh[1] : lastPivotLow[1]
        int knownP1At = bullish ? lastPivotLowTime[1] : lastPivotHighTime[1]
        int knownP2At = bullish ? lastPivotHighTime[1] : lastPivotLowTime[1]
        bool orderedSeed = state.dir != 0 and not na(knownP1At) and not na(knownP2At) and knownP1At >= ref.c1Time and knownP1At < knownP2At and knownP2At < time and (bullish ? knownP1 < knownP2 : knownP1 > knownP2)
        bool seedRaid = orderedSeed and (bullish ? low <= knownP1 - sweepSize : high >= knownP1 + sweepSize)
        if seedRaid and (na(state.setupP1At) or na(state.reclaimedAt) and knownP1At > state.setupP1At)
            state.setupP1 := knownP1
            state.setupP1At := knownP1At
            state.setupP2 := knownP2
            state.setupP2At := knownP2At
        float target = bullish ? ref.c1H : ref.c1L
        bool targetTaken = state.dir != 0 and (bullish ? state.hi >= target : state.lo <= target)
        bool biasOk = biasDir == state.dir or (allowCrtCounter and biasDir == -state.dir and biasDir != 0)
        bool parentActive = qualifiedParent and parentDirection != 0 and not na(parentKnownAt) and parentKnownAt <= time
        if not state.complete
            state.status := "E DATA"
        else if not na(state.reclaimedAt) and not na(state.channel) and not na(state.channel.confirmIndex)
            bool stopped = bullish ? low <= state.attemptSl : high >= state.attemptSl
            bool reached = bullish ? high >= target : low <= target
            if not state.blocked and (stopped or reached)
                state.status := stopped and reached ? "E AMB" : stopped ? "E SL REF" : "E TP REF"
                state.terminalReason := state.status
                if reached
                    state.blocked := true
                else
                    // A stopped provisional trade stays stopped. Observation may
                    // still find a new raid before this HTF C2 has finished.
                    state.reclaimedAt := na
                    state.channel := ReactionState.new()
                    state.key := CrtKey.new()
                    state.status := "OBS NEW RAID"
            else if not state.blocked
                state.status := time_close >= ref.finish ? "C2 CLOSED" : state.emitted ? "E SENT" : "TRACK TS"
            // Observe later closed bars even after the one Early marker was sent.
            // No additional Early alert; confirmed parent can inherit this evidence.
            if not state.blocked and not na(state.channel) and not na(state.channel.confirmIndex)
                SignalContext tracking = SignalContext.new(c1T=ref.c1Time, c2T=ref.start, c2End=ref.finish, parentDir=parentDirection, parentAtKey=qualifiedParent, parentLive=qualifiedParent, parentConfirmed=parentKnownAt, age=0, crtKey=state.key, kind=1, id=ref.c1Time, dir=state.dir, confirmed=state.reclaimedAt, hi=ref.c1H, lo=ref.c1L, inv=state.attemptSl, cp=target)
                deferred := tracking
                deferredTracking := true
                deferredTarget := target
        else if state.blocked
            state.status := state.terminalReason
        else if both or targetTaken
            state.blocked := true
            state.status := both ? "E DOUBLE" : "E TP TAKEN"
            state.terminalReason := state.status
        else if state.dir == 0
            state.status := "E WAIT RAID"
        else
            if extended or not inside
                state.reclaimedAt := na
                state.channel := ReactionState.new()
            CrtKey candidate = bullish ? buyKey : sellKey
            if na(state.key) or state.key.kind == 0
                if not na(candidate) and candidate.kind > 0 and candidate.dir == state.dir and not na(candidate.knownAt) and candidate.knownAt <= ref.start and candidate.beforeTime == ref.start
                    state.key := candidate.copy()
            bool hasKey = not na(state.key) and state.key.kind > 0 and state.key.dir == state.dir and state.key.knownAt <= ref.start
            bool keyHeld = hasKey and (bullish ? close > state.key.hi : close < state.key.lo)
            if hasKey and not keyHeld
                state.blocked := true
                state.status := "E KEY LOST"
                state.terminalReason := state.status
            else if not hasKey or not inside
                state.status := not hasKey ? "E NO KEY" : "E WAIT RECLAIM"
            else if na(state.reclaimedAt)
                state.attempts += 1
                state.reclaimedAt := time_close
                state.attemptSl := bullish ? state.lo : state.hi
                state.channel := ReactionState.new(sourceRoot=ref.c1Time, sourceC2=ref.start, sourceEnd=ref.finish, activatedAt=time_close, phaseAt=time_close)
                state.status := "E TS CLOSED"
                bool oppositeClose = bullish ? close > open : close < open
                if oppositeClose
                    state.channel.confirmIndex := bar_index
                    state.channel.confirmTime := time
                    state.channel.confirmLevel := bullish ? ref.c1L : ref.c1H
                    state.channel.localExtreme := state.attemptSl
                    state.channel.raidAt := ref.start
                    state.channel.p3At := bullish ? state.loAt : state.hiAt
                    state.channel.p3High := bullish ? state.lowCandleHigh : state.hi
                    state.channel.p3Low := bullish ? state.lo : state.highCandleLow
                    state.channel.p3Key := f_executionKey(state.dir, ref.start, state.channel.p3High, state.channel.p3Low, close)
                    state.channel.p3KeyAt := state.channel.p3Key.kind > 0 ? time_close : na
                    state.channel.legExtreme := bullish ? high : low
                    bool storedPair = not na(state.setupP1At) and not na(state.setupP2At)
                    float sourceP1 = storedPair ? state.setupP1 : knownP1
                    int sourceP1At = storedPair ? state.setupP1At : knownP1At
                    state.channel.mpsRef := storedPair ? state.setupP2 : not na(knownP2At) and knownP2At >= ref.c1Time ? knownP2 : na
                    state.channel.mpsRefAt := storedPair ? state.setupP2At : knownP2At
                    bool earlyPair = not na(state.channel.mpsRef) and not na(sourceP1At) and sourceP1At < state.channel.mpsRefAt and (bullish ? sourceP1 < state.channel.mpsRef : sourceP1 > state.channel.mpsRef)
                    bool earlyRaid = earlyPair and not na(state.channel.p3At) and state.channel.mpsRefAt < state.channel.p3At and state.channel.p3At <= time and (bullish ? state.lo <= sourceP1 - sweepSize : state.hi >= sourceP1 + sweepSize)
                    if earlyRaid
                        state.channel.p1Ref := sourceP1
                        state.channel.p1At := sourceP1At
                        state.channel.raidIndex := bar_index
                        state.channel.raidExtreme := state.attemptSl
                        state.channel.raidReclaimed := true
                    else
                        state.channel.mpsRef := na
                        state.channel.mpsRefAt := na
                    bool spentP2 = not na(state.channel.mpsRef) and (bullish ? structureBeforeClose > state.channel.mpsRef : structureBeforeClose < state.channel.mpsRef)
                    if spentP2
                        state.channel.mpsRef := na
                    bool initialMps = structureBarReady and state.channel.p3Key.kind > 0 and not na(state.channel.mpsRef) and (bullish ? structureClosing > state.channel.mpsRef and structurePriorClose <= state.channel.mpsRef : structureClosing < state.channel.mpsRef and structurePriorClose >= state.channel.mpsRef)
                    state.channel.mpsAt := initialMps ? structureClosedAt : na
                    state.channel.lastClosedAt := time_close
                state.channel.forwardKey := f_forwardKey(state.dir, time, close, target)
                state.channel.nextObjective := state.channel.forwardKey.kind > 0 ? (bullish ? state.channel.forwardKey.lo : state.channel.forwardKey.hi) : na
                state.channel.objectiveReached := false
                state.channel.objectiveAt := na
                bool freshEarlyKey = not na(state.channel.p3Key) and state.channel.p3Key.kind > 0 and f_executionProofValid(state.channel.p3Key, state.channel.p3KeyAt)
                if oppositeClose and not freshEarlyKey
                    state.status := "E WAIT P3 KEY"
                bool earlyCounter = biasDir == -state.dir or parentActive and parentDirection != state.dir
                bool earlyCounterSwing = not na(state.channel.p1At) and not na(state.channel.mpsRefAt) and not na(state.channel.p3At) and state.channel.p1At < state.channel.mpsRefAt and state.channel.mpsRefAt < state.channel.p3At and state.channel.p3At <= time and (bullish ? state.lo <= state.channel.p1Ref - sweepSize and close > state.channel.p1Ref : state.hi >= state.channel.p1Ref + sweepSize and close < state.channel.p1Ref)
                if oppositeClose and earlyCounter and not earlyCounterSwing
                    state.status := "E WAIT CT SWING"
                if oppositeClose and not state.emitted and (not earlyCounter or earlyCounterSwing) and (not parentActive or parentDirection == state.dir or allowCrtCounter and hasKey) and freshEarlyKey and enableEarlyC2 and permitEntry and biasOk and time_close < ref.finish and not confirmedHit and entryBranches != "FVG / OTE"
                    state.channel.branchMask := 1
                    state.channel.everSent := true
                    state.emitted := true
                    state.lockedSl := state.attemptSl
                    state.lockedTp := target
                    state.status := "E SIGNAL"
                    result.hit := true
                    result.dir := state.dir
                    result.inv := state.lockedSl
                    result.cp := state.lockedTp
                    result.confirmTime := time
                    result.reclaimedAt := state.reclaimedAt
                    result.attempt := state.attempts
                    result.keyRef := state.channel.p3Key
            else
                SignalContext local = SignalContext.new(age=0, crtKey=state.key, kind=1, id=ref.start, flags=1, phase=1, dir=state.dir, confirmed=state.reclaimedAt, resolved=state.reclaimedAt, hi=ref.c1H, lo=ref.c1L, inv=state.attemptSl, cp=target)
                deferred := local
                deferredTarget := target
    // One call site, with the same branch-specific context and signal budget.
    if not na(deferred)
        ChannelResult entry = f_stepChannel(deferred, state.channel, lastPivotHigh[1], lastPivotLow[1], na, na, enableEarlyC2 and permitEntry and (not deferredTracking or not state.emitted) and not confirmedHit and time_close < ref.finish, knownHighAt=lastPivotHighTime[1], knownLowAt=lastPivotLowTime[1])
        if not deferredTracking
            state.status := confirmedHit ? "E C3 PRIORITY" : "E " + entry.status
        if entry.hit and (deferredTracking ? not state.emitted : not confirmedHit)
            state.emitted := true
            state.lockedSl := state.attemptSl
            state.lockedTp := deferredTarget
            state.status := "E SIGNAL"
            result.hit := true
            result.dir := state.dir
            result.inv := state.lockedSl
            result.cp := state.lockedTp
            result.confirmTime := entry.confirmTime
            result.reclaimedAt := state.reclaimedAt
            result.attempt := state.attempts
            result.keyRef := entry.keyRef
    result.status := not isLtf ? "E VIEW TF" : not enableEarlyC2 or not permitEntry ? "OBS | " + state.status : state.status
    result

// Both OHLC and key map come from the completed C1, never the forming C2.
// The key matcher separately excludes keys learned after C2 opened.
float earlyC1O = not na(mainPreview) ? mainPreview.first.o : na
float earlyC1H = not na(mainPreview) ? mainPreview.first.h : na
float earlyC1L = not na(mainPreview) ? mainPreview.first.l : na
float earlyC1C = not na(mainPreview) ? mainPreview.first.c : na
int earlyC1T = not na(mainPreview) ? mainPreview.first.t : na
int earlyC1End = not na(mainPreview) ? mainPreview.first.e : na
KeyMap earlyKeys = executionMain
var EarlyState earlyState = EarlyState.new()
var array<string> earlyUnused = array.new<string>()
float earlyHigh = earlyState.bucket == bucketTime ? math.max(earlyState.hi, high) : high
float earlyLow = earlyState.bucket == bucketTime ? math.min(earlyState.lo, low) : low
CrtKey earlyBuyKey = not na(earlyKeys) and not na(earlyKeys.levels) ? f_matchKeyMap(earlyKeys, earlyUnused, bucketTime, 1, earlyHigh, earlyLow, close) : CrtKey.new()
CrtKey earlySellKey = not na(earlyKeys) and not na(earlyKeys.levels) ? f_matchKeyMap(earlyKeys, earlyUnused, bucketTime, -1, earlyHigh, earlyLow, close) : CrtKey.new()
bool earlyBuyWave = na(lastBuyTime) or (not na(lastPivotLowTime) and lastPivotLowTime > lastBuyTime)
bool earlySellWave = na(lastSellTime) or (not na(lastPivotHighTime) and lastPivotHighTime > lastSellTime)
EarlyReference earlyRef = EarlyReference.new(start=bucketTime, finish=bucketEnd, c1Time=earlyC1T, c1End=earlyC1End, c1O=earlyC1O, c1H=earlyC1H, c1L=earlyC1L, c1C=earlyC1C)
// Larger has its own observation channel even when provisional entries are off.
float hEarlyO = not na(largerPreview) ? largerPreview.first.o : na
float hEarlyH = not na(largerPreview) ? largerPreview.first.h : na
float hEarlyL = not na(largerPreview) ? largerPreview.first.l : na
float hEarlyC = not na(largerPreview) ? largerPreview.first.c : na
int hEarlyT = not na(largerPreview) ? largerPreview.first.t : na
int hEarlyEnd = not na(largerPreview) ? largerPreview.first.e : na
KeyMap hEarlyKeys = executionLarger
var EarlyState higherEarlyState = EarlyState.new()
var array<string> higherEarlyUnused = array.new<string>()
float hEarlyHigh = higherEarlyState.bucket == largerBucket ? math.max(higherEarlyState.hi, high) : high
float hEarlyLow = higherEarlyState.bucket == largerBucket ? math.min(higherEarlyState.lo, low) : low
CrtKey hEarlyBuyKey = not na(hEarlyKeys) ? f_matchKeyMap(hEarlyKeys, higherEarlyUnused, largerBucket, 1, hEarlyHigh, hEarlyLow, close) : CrtKey.new()
CrtKey hEarlySellKey = not na(hEarlyKeys) ? f_matchKeyMap(hEarlyKeys, higherEarlyUnused, largerBucket, -1, hEarlyHigh, hEarlyLow, close) : CrtKey.new()
EarlyReference higherEarlyRef = EarlyReference.new(start=largerBucket, finish=largerEnd, c1Time=higherSignalTfValid and enableLargerSignals ? hEarlyT : na, c1End=hEarlyEnd, c1O=hEarlyO, c1H=hEarlyH, c1L=hEarlyL, c1C=hEarlyC)
// Per-attempt state survives a focus switch; Main and Larger never share state.
f_channelState(map<string, ReactionState> records, string token, int activatedAt) =>
    if barstate.isconfirmed and token != "" and not map.contains(records, token)
        map.put(records, token, ReactionState.new(key=token, activatedAt=activatedAt, phaseAt=activatedAt))
        if map.size(records) > 128
            map.remove(records, array.get(map.keys(records), 0))
    map.contains(records, token) ? map.get(records, token) : ReactionState.new()
var map<string, ReactionState> channelStates = map.new<string, ReactionState>()
SignalContext ctx = SignalContext.new(age=sModelAge, c1T=sAT, c2T=sBT, c2End=sBEnd, c3End=not na(sCEnd) ? sCEnd : sModelAge == 0 ? bucketEnd : na, parentDir=higherAtKey ? higher.dir : biasModel.dir, parentConfirmed=higherAtKey ? higher.confirmed : biasModel.confirmed, parentLive=higherAtKey or biasAtKey, parentAtKey=higherAtKey or biasAtKey, crtKey=kCrtKey, kind=1, id=focusAvailable ? sId : na, flags=sFlags, phase=sPhase, dir=sDir, confirmed=sConfirmed, resolved=sResolved, hi=sHi, lo=sLo, inv=sInv, cp=sCp)
string modelKey = f_contextKey(focusAvailable ? sId : na, sResolved, sDir)
ReactionState crtState = f_channelState(channelStates, htf + ":" + modelKey, sConfirmed)
if barstate.isconfirmed and focusAvailable and na(crtState.confirmIndex) and earlyState.root == sAT and earlyState.dir == sDir and earlyState.bucket == sBT and not earlyState.blocked and not na(earlyState.channel) and earlyState.channel.sourceEnd == sConfirmed and earlyState.channel.localExtreme == sInv and not na(earlyState.channel.confirmIndex)
    crtState := earlyState.channel.copy()
    crtState.key := htf + ":" + modelKey
    crtState.activatedAt := sConfirmed
    map.put(channelStates, htf + ":" + modelKey, crtState)
SignalContext higherCtx = SignalContext.new(age=higher.age, c1T=higher.aT, c2T=higher.bT, c2End=higher.bEnd, c3End=not na(higher.cEnd) ? higher.cEnd : higher.age == 0 ? largerEnd : na, parentDir=biasModel.dir, parentConfirmed=biasModel.confirmed, parentLive=biasAtKey, parentAtKey=biasAtKey, crtKey=higher.key, kind=1, id=higherAvailable ? higher.id : na, flags=higher.flags, phase=higher.phase, dir=higher.dir, confirmed=higher.confirmed, resolved=higher.resolved, hi=higher.hi, lo=higher.lo, inv=higher.inv, cp=higher.cp)
string higherModelKey = f_contextKey(higherAvailable ? higher.id : na, higher.resolved, higher.dir)
ReactionState higherState = f_channelState(channelStates, largerTf + ":" + higherModelKey, higher.confirmed)
if barstate.isconfirmed and higherAvailable and na(higherState.confirmIndex) and higherEarlyState.root == higher.aT and higherEarlyState.dir == higher.dir and higherEarlyState.bucket == higher.bT and not higherEarlyState.blocked and not na(higherEarlyState.channel) and higherEarlyState.channel.sourceEnd == higher.confirmed and higherEarlyState.channel.localExtreme == higher.inv and not na(higherEarlyState.channel.confirmIndex)
    higherState := higherEarlyState.channel.copy()
    higherState.key := largerTf + ":" + higherModelKey
    higherState.activatedAt := higher.confirmed
    map.put(channelStates, largerTf + ":" + higherModelKey, higherState)
array<SignalContext> contextsToStep = array.from(ctx, higherCtx)
array<ReactionState> statesToStep = array.from(crtState, higherState)
array<ChannelResult> steppedChannels = array.new<ChannelResult>()
for channel = 0 to 1
    SignalContext context = array.get(contextsToStep, channel)
    ReactionState state = array.get(statesToStep, channel)
    float knownHigh = not na(lastPivotHighTime[1]) and lastPivotHighTime[1] >= context.c1T ? lastPivotHigh[1] : na
    float knownLow = not na(lastPivotLowTime[1]) and lastPivotLowTime[1] >= context.c1T ? lastPivotLow[1] : na
    array.push(steppedChannels, f_stepChannel(context, state, knownHigh, knownLow, pivotHigh, pivotLow, knownHighAt=lastPivotHighTime[1], knownLowAt=lastPivotLowTime[1]))
ChannelResult crtResult = array.get(steppedChannels, 0)
ChannelResult higherResult = array.get(steppedChannels, 1)
if not focusAvailable
    crtResult.status := focusLife.uid == sId and focusLife.reason != 0 ? f_endTag(focusLife.reason) : "WAIT CRT"
if not higherAvailable
    higherResult.status := not enableLargerSignals ? "OFF" : not higherSignalTfValid ? "TF/Bias" : higherLife.uid == higher.id and higherLife.reason != 0 ? f_endTag(higherLife.reason) : "WAIT CRT"


// Cache by attempt: switching focus and returning during TRACK must not erase
// the evidence collected in that attempt's original C3. No trading gate reads it.
type SignalAudit
    int bars = 0
    int ts = 0
    int legs = 0
    int retests = 0
    int signals = 0
    string blocked = "-"
    string last = "-"
f_getSignalAudit(map<string, SignalAudit> records, string token) =>
    if barstate.isconfirmed and token != "" and not map.contains(records, token)
        map.put(records, token, SignalAudit.new())
        if map.size(records) > 128
            map.remove(records, array.get(map.keys(records), 0))
    map.contains(records, token) ? map.get(records, token) : SignalAudit.new()
f_recordSignalAudit(SignalAudit data, ChannelResult event) =>
    if event.evaluated
        data.bars += 1
        data.ts += event.tsDetected ? 1 : 0
        data.legs += event.legDetected ? 1 : 0
        data.retests += event.retestDetected ? 1 : 0
        data.signals += event.hit ? 1 : 0
        data.last := event.status
        if event.entryDetected and not event.hit
            data.blocked := event.status
    data
f_signalAuditText(SignalAudit data) =>
    "Closed bars " + str.tostring(data.bars) + " | Legs " + str.tostring(data.legs) + " | TS " + str.tostring(data.ts) + " | Retests " + str.tostring(data.retests) + " | Signals " + str.tostring(data.signals) + " | Blocked " + data.blocked + " | Last " + data.last
var map<string, SignalAudit> signalAudits = map.new<string, SignalAudit>()
string diagnosticToken = htf + ":" + f_contextKey(sId, sResolved, sDir)
string higherDiagnosticToken = largerTf + ":" + f_contextKey(higher.id, higher.resolved, higher.dir)
SignalAudit diagnostic = f_getSignalAudit(signalAudits, not na(sId) ? diagnosticToken : "")
SignalAudit higherDiagnostic = f_getSignalAudit(signalAudits, not na(higher.id) ? higherDiagnosticToken : "")
diagnostic := f_recordSignalAudit(diagnostic, crtResult)
higherDiagnostic := f_recordSignalAudit(higherDiagnostic, higherResult)
string diagnosticSummary = "Main HTF " + htf + " | C1 " + (not na(sAT) ? str.format_time(sAT, "dd/MM HH:mm", NY) : "-") + " NY | Confirmed " + (not na(sConfirmed) ? str.format_time(sConfirmed, "dd/MM HH:mm", NY) : "-") + " NY | " + f_signalAuditText(diagnostic) + "\nHigher HTF " + largerTf + " | " + higherResult.status + " | C1 " + (not na(higher.aT) ? str.format_time(higher.aT, "dd/MM HH:mm", NY) : "-") + " NY | " + f_signalAuditText(higherDiagnostic) + " | Last end " + f_endTag(higher.reason)


array<EarlyReference> earlyReferences = array.from(earlyRef, higherEarlyRef)
array<EarlyState> earlyStates = array.from(earlyState, higherEarlyState)
array<CrtKey> earlyBuyKeys = array.from(earlyBuyKey, hEarlyBuyKey)
array<CrtKey> earlySellKeys = array.from(earlySellKey, hEarlySellKey)
array<EarlyResult> earlyOutputs = array.new<EarlyResult>()
for channel = 0 to 1
    array.push(earlyOutputs, f_stepEarly(array.get(earlyReferences, channel), array.get(earlyStates, channel), array.get(earlyBuyKeys, channel), array.get(earlySellKeys, channel), channel == 0 ? earlyBuyWave : true, channel == 0 ? earlySellWave : true, channel == 0 ? crtResult.hit : false, channel == 0, channel == 0 and higherAtKey ? higher.dir : biasModel.dir, channel == 0 ? higherAtKey or biasAtKey : biasAtKey, channel == 0 and higherAtKey ? higher.confirmed : biasModel.confirmed))
EarlyResult earlyResult = array.get(earlyOutputs, 0)
EarlyResult higherObservation = array.get(earlyOutputs, 1)
if earlyResult.hit and earlyResult.dir == 1
    lastBuyTime := time
    lastBuyBar := bar_index
if earlyResult.hit and earlyResult.dir == -1
    lastSellTime := time
    lastSellBar := bar_index


array<ChannelResult> channelResults = array.from(crtResult)
array<ChannelResult> markerResults = array.from(crtResult, higherResult)
bool entryEvent = crtResult.hit
bool entryLong = (entryEvent and crtResult.dir == 1) or (higherResult.hit and higherResult.dir == 1)
bool entryShort = (entryEvent and crtResult.dir == -1) or (higherResult.hit and higherResult.dir == -1)
bool focusSignal = entryEvent
string auditSummary = "CRT: " + crtResult.status + " | " + crtState.chainRole + " | " + crtState.biasRole + (not na(crtState.nextObjective) ? " | Barrier " + str.tostring(crtState.nextObjective, format.mintick) + " | type " + str.tostring(crtState.forwardKey.kind) + "/" + crtState.forwardKey.tf + (crtState.objectiveReached ? " TOUCHED " + str.format_time(crtState.objectiveAt, "dd/MM HH:mm", NY) + " NY (observation only)" : " NOT TOUCHED") : " | No intermediate key") + (sEqTouched ? " | EQ touched (not TP)" : "") + " | CRT attempt " + str.tostring(sId)
string signalStatus = crtResult.status
float target = sCp
float executionSl = sInv
bool localTargetTaken = crtState.localTargetTaken
bool alreadyEmitted = crtState.sent

// Drawing focus and the single signal context always refer to the same CRT.
var string selectedKey = ""
string visualKey = f_contextKey(sId, sResolved, sDir)
bool changedModel = visualKey != selectedKey
if changedModel
    selectedKey := visualKey
int drawSpan = int(math.ceil(drawHtfBars * htfSeconds / chartSeconds))
int labelLaneBars = chartTextSize == "Huge" ? 48 : chartTextSize == "Large" ? 36 : chartTextSize == "Small" ? 18 : 26
int clusterStartIndex = bar_index + (showLevels or showConfirm ? math.max(clusterOffset, labelLaneBars + 12) : clusterOffset)
int drawingClipIndex = showCluster ? clusterStartIndex - labelLaneBars - 2 : bar_index + 498
var array<label> eventLabels = array.new<label>()
var array<int> eventBuckets = array.new<int>()
var array<box> clusterBodies = array.new<box>()
var array<line> clusterWicks = array.new<line>()
var array<label> groupLabels = array.new<label>()
var array<line> levelLines = array.new<line>()
var array<label> levelLabels = array.new<label>()
var array<line> labelLeaders = array.new<line>()
var table panel = table.new(position.top_right, 2, 11, bgcolor=color.new(#111820, 12), border_width=0)
if barstate.isfirst
    for i = 0 to 4
        array.push(levelLines, line.new(time, close, time, close, xloc=xloc.bar_time, force_overlay=true))
        array.push(levelLabels, label.new(bar_index, close, "", style=label.style_label_left, color=color.new(color.black, 100), force_overlay=true))
        array.push(labelLeaders, line.new(bar_index, close, bar_index, close, style=line.style_dotted, force_overlay=true))
    for i = 0 to 5
        array.push(groupLabels, label.new(bar_index, close, "", style=label.style_none, color=color.new(color.black, 100), force_overlay=true))
f_tfName(string tf) =>
    tf == "60" ? "H1" : tf == "120" ? "H2" : tf == "240" ? "H4" : tf == "1D" ? "D1" : tf == "1W" ? "W1" : tf
f_countdown(int closesAt, int nowAt) =>
    int secondsLeft = na(closesAt) ? 0 : math.max(0, int(math.ceil((closesAt - nowAt) / 1000.0)))
    int daysLeft = int(secondsLeft / 86400)
    int hoursLeft = int(secondsLeft % 86400 / 3600)
    int minutesLeft = int(secondsLeft % 3600 / 60)
    na(closesAt) ? "-" : secondsLeft == 0 ? "Closed" : (daysLeft > 0 ? str.tostring(daysLeft) + "d " : "") + str.tostring(hoursLeft, "00") + ":" + str.tostring(minutesLeft, "00") + ":" + str.tostring(secondsLeft % 60, "00")
f_tag(int flags, int kind, int phase) =>
    "CRT/TS"
f_dropMark(int index) =>
    label.delete(array.remove(eventLabels, index))
    array.remove(eventBuckets, index)

f_note(bool up, string hint) =>
    color markerColor = up ? color.lime : color.red
    string markerLocation = up ? yloc.belowbar : yloc.abovebar
    if markLimit > 0
        array.push(eventLabels, label.new(bar_index, na, "", xloc=xloc.bar_index, yloc=markerLocation, style=up ? label.style_triangleup : label.style_triangledown, color=markerColor, size=4, force_overlay=true, tooltip=hint))
        array.push(eventBuckets, bucketCounter)
    while array.size(eventLabels) > markLimit
        f_dropMark(0)
f_keyTag(CrtKey key) =>
    na(key) or key.kind == 0 ? "-" : (key.kind == 1 ? "FVG" : key.kind == 2 ? "OB" : key.kind == 3 ? (key.dir == 1 ? "SWL" : "SWH") : key.kind == 4 ? "OPEN" : key.kind == 5 ? "CLOSE" : key.kind == 6 ? (key.dir == 1 ? "WW-L50" : "WW-H50") : "-") + "/" + f_tfName(key.tf)

f_barrierNote(ReactionState state) =>
    not na(state.forwardKey) and state.forwardKey.kind > 0 ? "Intermediate " + f_keyTag(state.forwardKey) + " " + str.tostring(state.nextObjective, format.mintick) + " | known " + str.format_time(state.forwardKey.knownAt, "dd/MM HH:mm", NY) + " NY | " + (state.objectiveReached ? "touched " + str.format_time(state.objectiveAt, "dd/MM HH:mm", NY) + " NY" : "not touched after TS close") + " | observation only; CRT TGT/INV and branch budget still apply" : "No frozen intermediate key"

f_keyProofHint(CrtKey key, int reclaimedAt) =>
    string detail = "P3 KEY: none (diagnostic key filter off)"
    if not na(key) and key.kind > 0
        detail := "P3 KEY " + f_keyTag(key) + " " + str.tostring(key.lo, format.mintick) + "-" + str.tostring(key.hi, format.mintick) + " | Known " + str.format_time(key.knownAt, "dd/MM HH:mm", NY) + " NY | before raid " + str.format_time(key.beforeTime, "dd/MM HH:mm", NY) + " NY | Reclaim " + str.format_time(reclaimedAt, "dd/MM HH:mm", "Asia/Ho_Chi_Minh") + " UTC+7"
    detail

string buyHint = ""
string sellHint = ""
// Latest means the latest EVENT BAR: keep both directions if sources conflict.
// Early + one independent higher signal can also share that bar (max two marks).
// MPS is a structural level: source pivot -> confirmation candle, as in the
// user's examples 4/7. The text sits in a gap at that price, not above the candle.
f_mpsSegment(int sourceAt, int brokenAt, int barMs) =>
    int span = brokenAt - sourceAt
    int middle = sourceAt + int(span / 2)
    int halfGap = math.max(1, math.min(int(barMs * 2.0), int(span * 0.35)))
    [middle, middle - halfGap, middle + halfGap]
// Display-only density adaptation. Visible bar timestamps trigger a redraw on
// horizontal zoom/scroll; no execution gate reads this viewport information.
f_mpsFont(int visibleBars) =>
    int(math.round(math.max(8.0, math.min(12.0, 12.0 * math.sqrt(160.0 / math.max(1, visibleBars))))))
var int mpsVisibleBars = 0
if time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
    mpsVisibleBars += 1
var array<label> mpsLabels = array.new<label>()
var array<line> mpsLeftLines = array.new<line>()
var array<line> mpsRightLines = array.new<line>()
if historyMarks > 0 and (crtState.mpsEvent or higherState.mpsEvent)
    if not retainHistory
        while array.size(mpsLabels) > 0
            label.delete(array.shift(mpsLabels))
            line.delete(array.shift(mpsLeftLines))
            line.delete(array.shift(mpsRightLines))
    bool sharedMps = crtState.mpsEvent and higherState.mpsEvent and sDir == higher.dir and math.abs(crtState.mpsRef - higherState.mpsRef) < syminfo.mintick * 0.5
    for pass = 0 to 1
        bool event = pass == 0 ? crtState.mpsEvent : higherState.mpsEvent
        int direction = pass == 0 ? sDir : higher.dir
        float price = pass == 0 ? crtState.mpsRef : higherState.mpsRef
        int sourceAt = sharedMps ? math.min(crtState.mpsRefAt, higherState.mpsRefAt) : pass == 0 ? crtState.mpsRefAt : higherState.mpsRefAt
        if event and not (sharedMps and pass == 1) and not na(sourceAt) and sourceAt < time and not na(price)
            [middle, gapLeft, gapRight] = f_mpsSegment(sourceAt, time, int(chartSeconds * 1000))
            string sourceName = sharedMps ? f_tfName(htf) + " / " + f_tfName(largerTf) : f_tfName(pass == 0 ? htf : largerTf)
            string hint = "MPS " + sourceName + " | Structure " + (useM15Structure ? "M15" : timeframe.period) + " | P2 " + str.tostring(price, format.mintick) + " | Pivot " + str.format_time(sourceAt, "dd/MM HH:mm", NY) + " NY | Break close " + str.format_time(time_close, "dd/MM HH:mm", NY) + " NY. Required for OTE only; not an entry."
            ReactionState proofState = pass == 0 ? crtState : higherState
            hint += "\nP1 " + str.tostring(proofState.p1Ref, format.mintick) + " @ " + str.format_time(proofState.p1At, "dd/MM HH:mm", NY) + " NY | P3 " + str.tostring(proofState.localExtreme, format.mintick) + " @ " + str.format_time(proofState.p3At, "dd/MM HH:mm", NY) + " NY | P1 < P2 < P3 (time)"
            hint += "\n" + f_keyProofHint(proofState.p3Key, proofState.p3KeyAt)
            array.push(mpsLeftLines, line.new(sourceAt, price, gapLeft, price, xloc=xloc.bar_time, extend=extend.none, color=color.orange, width=1, force_overlay=true))
            array.push(mpsRightLines, line.new(gapRight, price, time, price, xloc=xloc.bar_time, extend=extend.none, color=color.orange, width=1, force_overlay=true))
            array.push(mpsLabels, label.new(middle, price, direction == 1 ? "+MPS" : "-MPS", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textalign=text.align_center, textcolor=direction == 1 ? color.teal : color.red, size=size.small, force_overlay=true, tooltip=hint))

int mpsLimit = historyMarks == 0 ? 0 : retainHistory ? math.min(historyMarks, 40) : 2
while array.size(mpsLabels) > mpsLimit
    label.delete(array.shift(mpsLabels))
    line.delete(array.shift(mpsLeftLines))
    line.delete(array.shift(mpsRightLines))
if barstate.islast and array.size(mpsLabels) > 0
    int fontPoints = f_mpsFont(mpsVisibleBars)
    int gapScale = math.max(1, int(math.ceil(mpsVisibleBars * fontPoints / 1300.0)))
    for i = 0 to array.size(mpsLabels) - 1
        label textLabel = array.get(mpsLabels, i)
        line leftLine = array.get(mpsLeftLines, i)
        line rightLine = array.get(mpsRightLines, i)
        [center, leftEdge, rightEdge] = f_mpsSegment(line.get_x1(leftLine), line.get_x2(rightLine), int(chartSeconds * 1000) * gapScale)
        label.set_size(textLabel, fontPoints)
        line.set_x2(leftLine, leftEdge)
        line.set_x1(rightLine, rightEdge)
if not retainHistory and markLimit > 0 and (entryLong or entryShort or earlyResult.hit)
    while array.size(eventLabels) > 0
