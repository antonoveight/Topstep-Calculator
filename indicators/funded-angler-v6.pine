    if hit.hit
        string sourceTf = i == 0 ? htf : largerTf
        ReactionState proofState = i == 0 ? crtState : higherState
        string hint = "HTF " + f_tfName(sourceTf) + " | " + (hit.dir == 1 ? "BUY" : "SELL") + " | " + f_tag(hit.flags, hit.kind, hit.phase) + " / " + hit.tag + " / " + signalTiming + ((i == 0 ? mainSmt : higherSmt) == hit.dir ? " / SMT" : "") + "\nConfirm bar " + str.format_time(hit.confirmTime, "dd/MM HH:mm", NY) + " NY | Trigger bar " + str.format_time(time, "dd/MM HH:mm", NY) + " NY | Signal CLOSE " + str.format_time(time_close, "dd/MM HH:mm:ss", NY) + " NY | Bias " + str.tostring(biasDir) + " | Close " + str.tostring(close, format.mintick) + " | CP " + str.tostring(hit.cp, format.mintick) + " | INV " + str.tostring(hit.inv, format.mintick)
        if hit.tag != "TS_CLOSE"
            hint += "\nZone known " + str.tostring(hit.zoneKnownAt) + " | " + str.tostring(hit.zoneLow, format.mintick) + "–" + str.tostring(hit.zoneHigh, format.mintick)

        int sourceC1 = i == 0 ? sAT : higher.aT
        int sourceConfirmed = i == 0 ? sConfirmed : higher.confirmed
        hint += "\nCRT #" + str.tostring(hit.id) + " | C1 " + str.format_time(sourceC1, "dd/MM HH:mm", NY) + " NY | HTF confirmed " + str.format_time(sourceConfirmed, "dd/MM HH:mm", NY) + " NY | Closed entry bar; reference levels are not fills"
        hint += "\n" + f_barrierNote(proofState) + " | CRT target " + str.tostring(hit.cp, format.mintick)
        hint += "\nChain " + proofState.chainRole + " | " + proofState.biasRole + " | source C2 " + str.format_time(proofState.sourceC2, "dd/MM HH:mm", NY) + " NY"
        hint += "\nSource C1 " + str.format_time(sourceC1, "dd/MM HH:mm", "Asia/Ho_Chi_Minh") + " UTC+7 | Signal close " + str.format_time(time_close, "dd/MM HH:mm", "Asia/Ho_Chi_Minh") + " UTC+7"
        hint += "\n" + f_keyProofHint(hit.keyRef, proofState.p3KeyAt)
        hint += "\nHistorical source at signal time; the panel may now follow a newer opposite setup."
        if hit.counterBias
            CrtKey contextKey = i == 0 ? kCrtKey : higher.key
            hint += "\nCT vs bias | Context " + f_keyTag(contextKey) + " " + str.tostring(contextKey.lo, format.mintick) + "-" + str.tostring(contextKey.hi, format.mintick)
        if hit.dir == 1
            buyHint += (buyHint == "" ? "BUY\n" : "\n") + hint
        else
            sellHint += (sellHint == "" ? "SELL\n" : "\n") + hint
if entryLong and showEntryTriangles
