clusterFollowCount = input.int(6, "Follow candles to show", minval=2, maxval=12, group=G_VIEW, tooltip="Cụm MODEL giữ nến gốc; cụm FOLLOW hiển thị số nến diễn biến gần nhất, mặc định 6. Nến cũ bị lược hiển thị được báo bằng dấu … và số lượng. Không đổi timeout hoặc tín hiệu.")
showArchive = input.bool(false, "Last ended model cluster", group=G_VIEW, tooltip="Cụm LAST giữ nến nguồn của model vừa kết thúc và mã TG/INV/TO/AMB/HIST. Chỉ để tham khảo lịch sử, không khôi phục hiệu lực hoặc phát tín hiệu. Mặc định tắt.")
clusterOffset = input.int(30, "Cluster offset (bars)", minval=3, maxval=80, group=G_VIEW, tooltip="Khoảng cách từ bar chart cuối đến cụm HTF, theo số bar chart. Mặc định 30 bar để cách xa cột chú thích.")
clusterWidth = input.int(4, "Cluster body width (bars)", minval=2, maxval=16, group=G_VIEW, tooltip="Độ rộng thân nến HTF, mặc định 4 bar. Số lẻ được làm tròn xuống số chẵn để râu luôn đúng tâm thân. Không ảnh hưởng OHLC; râu đồng bộ line mảnh 1 px.")
showLevels = input.bool(true, "Model range / ERL / CP", group=G_VIEW, tooltip="Các mức nối từ nến tạo cực trị/swing tương ứng, không từ nến tín hiệu. EQ 50% dùng neo tổng quan. Nếu nguồn không có trong dữ liệu chart hoặc chưa có ERL hợp lệ thì không ghim giả. Tắt chỉ ẩn line, không đổi tín hiệu.")
showIrl = input.bool(true, "HTF internal liquidity", group=G_VIEW, tooltip="IRL: swing high/low đã xác nhận nằm trong range C1, chưa bị lấy. ERL nằm ngoài range. Không dùng EQ thay IRL và không tự suy diễn vùng giá thiếu nguồn.")
