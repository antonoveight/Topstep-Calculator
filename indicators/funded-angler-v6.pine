    earlyHint += "\n" + f_keyProofHint(earlyResult.keyRef, earlyResult.reclaimedAt)
    array.push(eventLabels, label.new(bar_index, na, "E", xloc=xloc.bar_index, yloc=earlyResult.dir == 1 ? yloc.belowbar : yloc.abovebar, style=earlyResult.dir == 1 ? label.style_label_up : label.style_label_down, color=color.new(earlyResult.dir == 1 ? color.lime : color.red, 88), textcolor=earlyResult.dir == 1 ? color.lime : color.red, size=size.small, force_overlay=true, tooltip=earlyHint))
