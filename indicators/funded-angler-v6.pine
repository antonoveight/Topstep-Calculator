f_higherSnapshot() =>
    [q0, q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, q11, q12, q13, q14, q15, q16, q17, q18, q19, q20, q21, q22, q23, q24, q25, q26, q27, q28, q29, q30, q31, q32, q33, q34, q35, q36, q37, q38, q39, q40, q41, q42, q43, q44, q45, q46, q47, q48, q49, q50, q51, q52, q53, q54, q55, q56, q57, q58, q59, q60, q61, q62, q63] = f_engine(largerTf)
    HigherSnapshot.new(id=q0[1], flags=q1[1], phase=q3[1], dir=q4[1], hi=q5[1], lo=q6[1], inv=q7[1], cp=q8[1], confirmed=q15[1], resolved=q16[1], age=q37[1], aT=q22[1], aEnd=q61[1], bT=q27[1], bEnd=q63[1], reason=q34[1], key=q59[1])
bool higherSignalTfValid = isLtf and timeframe.in_seconds(largerTf) > htfSeconds and timeframe.in_seconds(largerTf) % chartSeconds == 0 and timeframe.in_seconds(biasTf) >= timeframe.in_seconds(largerTf)
HigherSnapshot higher = if enableLargerSignals and higherSignalTfValid
    request.security(syminfo.tickerid, largerTf, f_higherSnapshot(), lookahead=barmerge.lookahead_on, calc_bars_count=CONTEXT_BARS)
