showPanel = input.bool(true, "Compact panel", group=G_VIEW, tooltip="Bảng tổng quan cố định góc trên phải. TF=khung, #1=model ưu tiên, B=bias, REF=loại vùng/mức đang theo dõi, T=thời gian, S=trạng thái.")
