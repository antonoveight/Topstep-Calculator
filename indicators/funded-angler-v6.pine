    float price = na
    int side = 0
    int born = na

f_refreshIrl(Model m, array<Liquidity> swings) =>
    m.innerHi := na
    m.innerLo := na
    m.innerHiT := na
    m.innerLoT := na
    if array.size(swings) > 0
        for j = 0 to array.size(swings) - 1
            Liquidity q = array.get(swings, j)
            bool internalSwing = q.price < m.hi and q.price > m.lo
            if internalSwing and q.side == 1 and (na(m.innerHi) or q.price > m.innerHi)
                m.innerHi := q.price
                m.innerHiT := q.born
            if internalSwing and q.side == -1 and (na(m.innerLo) or q.price < m.innerLo)
                m.innerLo := q.price
                m.innerLoT := q.born
    float selectedPrice = m.dir == 1 ? m.innerLo : m.innerHi
    int selectedTime = m.dir == 1 ? m.innerLoT : m.innerHiT
    m.irlH := selectedPrice
    m.irlL := selectedPrice
    m.irlT := selectedTime
    m.irlKind := na(selectedTime) ? 0 : 3
    m.irlDir := m.dir

f_archive(Model m, int reason, int endedAt) =>
    ModelArchive.new(confirmedAt=m.confirmedAt, aEnd=m.aEnd, bEnd=m.bEnd, cEnd=m.cEnd, uid=m.uid, flags=m.flags, kind=m.kind, phase=m.phase, aO=m.aO, aH=m.aH, aL=m.aL, aC=m.aC, aT=m.aT, bO=m.bO, bH=m.bH, bL=m.bL, bC=m.bC, bT=m.bT, cO=m.cO, cH=m.cH, cL=m.cL, cC=m.cC, cT=m.cT, endReason=reason, endedAt=endedAt)
f_archiveAllowed(int kind) =>
    kind == 1

// Context outcomes, not executed trade outcomes. OHLC cannot order both barriers.
f_crtEnd(int direction, float invalidation, float targetLevel, float barHigh, float barLow, float closing, bool older, bool outsideHistory, bool timedOut, bool entryExpired = false) =>
    bool bad = older and (direction == 1 ? barLow <= invalidation : barHigh >= invalidation)
    bool reached = older and (direction == 1 ? barHigh >= targetLevel : barLow <= targetLevel)
    bad and reached ? 4 : bad ? 1 : reached ? 2 : entryExpired ? 7 : outsideHistory ? 5 : timedOut ? 3 : 0

// References are matched BEFORE current-bar pool consumption/creation.
f_keyReact(CrtKey k, int beforeTime, int direction, float barHigh, float barLow, float barClose) =>
    bool preexisting = k.kind > 0 and not na(k.knownAt) and k.knownAt <= beforeTime
    bool sameSide = k.dir == direction
    bool sweepReaction = direction == 1 ? barLow <= k.lo - sweepSize and barClose > k.hi : barHigh >= k.hi + sweepSize and barClose < k.lo
    preexisting and sameSide and k.kind == 3 and sweepReaction

f_findCrtKey(array<Liquidity> swings, int beforeTime, int direction, float barHigh, float barLow, float barClose, string sourceTf) =>
    CrtKey found = CrtKey.new()
    if array.size(swings) > 0
        for offset = 0 to array.size(swings) - 1
            Liquidity q = array.get(swings, array.size(swings) - 1 - offset)
            CrtKey candidate = CrtKey.new(kind=3, dir=-q.side, hi=q.price, lo=q.price, born=q.born, leftTime=q.born, knownAt=q.knownAt, beforeTime=beforeTime, tf=sourceTf)
            if found.kind == 0 and f_keyReact(candidate, beforeTime, direction, barHigh, barLow, barClose)
                found := candidate
    found

f_keyIdentity(CrtKey key) =>
    key.tf + ":" + str.tostring(key.kind) + ":" + str.tostring(key.dir) + ":" + str.tostring(key.knownAt)

f_matchKeyMap(KeyMap keyMap, array<string> usedKeys, int beforeTime, int direction, float barHigh, float barLow, float barClose) =>
    CrtKey found = CrtKey.new()
    for pass = 1 to 3
        if array.size(keyMap.levels) > 0
            for j = 0 to array.size(keyMap.levels) - 1
                CrtKey candidate = array.get(keyMap.levels, j)
                if found.kind == 0 and candidate.kind == pass and not array.includes(usedKeys, f_keyIdentity(candidate)) and f_keyReact(candidate, beforeTime, direction, barHigh, barLow, barClose)
                    found := candidate.copy()
                    found.beforeTime := beforeTime
    found

f_markHigherUsed(KeyMap keyMap, array<string> usedKeys, int barStart, float barHigh, float barLow) =>
    if array.size(keyMap.levels) > 0
        for j = 0 to array.size(keyMap.levels) - 1
            CrtKey key = array.get(keyMap.levels, j)
            bool consumed = key.dir == 1 ? barLow <= key.lo : barHigh >= key.hi
            string identity = f_keyIdentity(key)
            if barStart >= key.knownAt and consumed and not array.includes(usedKeys, identity)
                array.push(usedKeys, identity)
    while array.size(usedKeys) > 160
        array.shift(usedKeys)

f_updateKeyPools(array<Liquidity> swings, int scanStart, bool inScan, float ph, float pl) =>
    // Remove consumed or out-of-window references, before looking for new CP levels.
    int si = array.size(swings) - 1
    while si >= 0
        Liquidity q = array.get(swings, si)
        if q.born < scanStart or (q.side == 1 ? high >= q.price : low <= q.price)
            array.remove(swings, si)
        si -= 1
    if inScan and not na(ph) and time[htfPivotLength] >= scanStart and high < ph
        array.push(swings, Liquidity.new(knownAt=time_close, price=ph, side=1, born=time[htfPivotLength]))
    if inScan and not na(pl) and time[htfPivotLength] >= scanStart and low > pl
        array.push(swings, Liquidity.new(knownAt=time_close, price=pl, side=-1, born=time[htfPivotLength]))
    if array.size(swings) > 80
        array.shift(swings)
f_collectKeyMap(array<Liquidity> swings, string sourceTf) =>
    array<CrtKey> levels = array.new<CrtKey>()
    for direction = -1 to 1 by 2
        int collected = 0
        if array.size(swings) > 0
            for offset = 0 to array.size(swings) - 1
                Liquidity q = array.get(swings, array.size(swings) - 1 - offset)
                if -q.side == direction and collected < 2
                    array.push(levels, CrtKey.new(kind=3, dir=direction, hi=q.price, lo=q.price, born=q.born, leftTime=q.born, knownAt=q.knownAt, tf=sourceTf))
                    collected += 1
    KeyMap.new(levels)

// A compact, immutable snapshot: two recent references per kind/direction (max 12).
f_higherKeyMap(string sourceTf) =>
    var array<Liquidity> swings = array.new<Liquidity>()
    int scanStart = last_bar_time - int(timeframe.in_seconds() * 1000) * scanDepth
    float ph = ta.pivothigh(high, htfPivotLength, htfPivotLength)
    float pl = ta.pivotlow(low, htfPivotLength, htfPivotLength)
    f_updateKeyPools(swings, scanStart, time >= scanStart, ph, pl)
    f_collectKeyMap(swings, sourceTf)

f_biasBundle() =>
    [direction, age, swingHigh, swingLow, guardHigh, guardLow] = f_biasSnapshot(true)
    KeyMap keyMap = f_higherKeyMap(biasTf)
    [direction, age, swingHigh, swingLow, guardHigh, guardLow, keyMap[1]]

// Freeze the references that existed before C1. They are evidence for this parent,
// not a claim that liquidity can be traded repeatedly without a new raid/reclaim.
f_parentKeys(array<Liquidity> swings, KeyMap higherMap, array<string> consumed, int beforeTime, string sourceTf) =>
    array<CrtKey> levels = array.new<CrtKey>()
    if array.size(swings) > 0
        for i = 0 to array.size(swings) - 1
            Liquidity q = array.get(swings, i)
            if q.knownAt <= beforeTime
                array.push(levels, CrtKey.new(kind=3, dir=-q.side, hi=q.price, lo=q.price, born=q.born, leftTime=q.born, knownAt=q.knownAt, beforeTime=beforeTime, tf=sourceTf))
    if not na(higherMap) and not na(higherMap.levels)
        if array.size(higherMap.levels) > 0
            for i = 0 to array.size(higherMap.levels) - 1
                CrtKey k = array.get(higherMap.levels, i)
                if k.knownAt <= beforeTime and not array.includes(consumed, f_keyIdentity(k))
                    CrtKey copy = k.copy()
                    copy.beforeTime := beforeTime
                    array.push(levels, copy)
    KeyMap.new(levels)

f_rangeReaction(KeyMap references, int beforeTime, int direction, float raidHigh, float raidLow, float closing) =>
    CrtKey found = CrtKey.new()
    if not na(references) and not na(references.levels)
        if array.size(references.levels) > 0
            for i = 0 to array.size(references.levels) - 1
                CrtKey k = array.get(references.levels, i)
                if found.kind == 0 and f_keyReact(k, beforeTime, direction, raidHigh, raidLow, closing)
                    found := k.copy()
    found

// Price-based attempt failure is sticky. Revalidation below creates a new attempt,
// with a new confirmation token, and never rewrites the previous archive or SL.
f_revalidateRange(Model m, float opening, float barHigh, float barLow, float closing, int barTime, int barEnd, int currentIndex) =>
    // Only the ORIGINAL C3 may replace the original C2 raid. Never pair a stale
    // C1 with an unrelated raid hours/days later or chain renewals indefinitely.
    bool originalC3 = m.flags == 1 and currentIndex == m.bornIndex + 1 and barTime >= m.bEnd
    bool extended = m.dir == 1 ? barLow <= m.inv - sweepSize : barHigh >= m.inv + sweepSize
    bool inside = closing > m.lo and closing < m.hi
    CrtKey key = originalC3 and extended and inside ? f_rangeReaction(m.rangeKeys, m.aT, m.dir, barHigh, barLow, closing) : CrtKey.new()
    bool pathOpen = m.dir == 1 ? barHigh < m.cp : barLow > m.cp
    bool renewed = m.phase == 0 and originalC3 and extended and inside and pathOpen and key.kind == 3
    if renewed
        m.flags += 2
        m.phase := 1
        m.bornIndex := currentIndex
        m.confirmedAt := barEnd
        m.resolvedAt := barEnd
        m.resolvedIndex := currentIndex
        m.inv := m.dir == 1 ? barLow : barHigh
        m.invT := barTime
        m.crtKey := key
        m.bO := opening
        m.bH := barHigh
        m.bL := barLow
        m.bC := closing
        m.bT := barTime
        m.bEnd := barEnd
        m.cT := na
        m.cEnd := na
        m.cO := na
        m.cH := na
        m.cL := na
        m.cC := na
    renewed

f_preferCrt(int candidateBorn, int candidateRoot, int selectedBorn, int selectedRoot, int currentIndex) =>
    na(selectedRoot) or (candidateBorn == currentIndex and selectedBorn != currentIndex) or ((candidateBorn == currentIndex) == (selectedBorn == currentIndex) and candidateRoot > selectedRoot)

f_engine() =>
    [higherBias, higherBiasAge, higherBiasHigh, higherBiasLow, higherGuardHigh, higherGuardLow, higherKeyMap] = request.security(syminfo.tickerid, biasTf, f_biasBundle(), lookahead=barmerge.lookahead_on, calc_bars_count=5000)
    var array<Model> models = array.new<Model>()
    var array<Liquidity> swings = array.new<Liquidity>()
    var ModelArchive lastEnded = ModelArchive.new()
    var array<string> usedHigherKeys = array.new<string>()
    var int priorFocusId = na
    bool archivedThisBar = false
    var int lastRetired = na
    var int retiredReason = 0
    var int dropped = 0
    var int firstSeen = time
    int scanStart = last_bar_time - int(timeframe.in_seconds() * 1000) * scanDepth
    bool inScan = time >= scanStart
    float ph = ta.pivothigh(high, htfPivotLength, htfPivotLength)
    float pl = ta.pivotlow(low, htfPivotLength, htfPivotLength)
    KeyMap parentReferences = f_parentKeys(swings, higherKeyMap, usedHigherKeys, time[1], htf)
    CrtKey priorBuyKey = f_findCrtKey(swings, time[1], 1, high, low, close, htf)
    CrtKey priorSellKey = f_findCrtKey(swings, time[1], -1, high, low, close, htf)
    if biasTf != htf and not na(higherKeyMap) and not na(higherKeyMap.levels)
        if priorBuyKey.kind == 0
            priorBuyKey := f_matchKeyMap(higherKeyMap, usedHigherKeys, time[1], 1, high, low, close)
        if priorSellKey.kind == 0
            priorSellKey := f_matchKeyMap(higherKeyMap, usedHigherKeys, time[1], -1, high, low, close)
        f_markHigherUsed(higherKeyMap, usedHigherKeys, time, high, low)
    f_updateKeyPools(swings, scanStart, inScan, ph, pl)

    // A parent C1 outlives any individual attempt. Goal completion ends the parent.
    int mi = array.size(models) - 1
    while mi >= 0
        Model m = array.get(models, mi)
        bool older = time_close > m.confirmedAt
        if na(m.cT) and time >= m.confirmedAt and m.dir != 0
            m.cO := open
            m.cH := high
            m.cL := low
            m.cC := close
            m.cT := time
            m.cEnd := time_close
        float equilibrium = (m.hi + m.lo) / 2
        if older and (m.dir == 1 ? high >= equilibrium : low <= equilibrium)
            m.eqTouched := true
        int endingReason = m.phase == 1 ? f_crtEnd(m.dir, m.inv, m.cp, high, low, close, older, false, false) : 0
        bool goalTaken = older and (m.dir == 1 ? high >= m.cp : low <= m.cp)
        bool outsideHistory = m.aT < scanStart
        if endingReason != 0
            lastRetired := m.uid
            retiredReason := endingReason
            if f_archiveAllowed(m.kind) and (m.uid == priorFocusId or not archivedThisBar)
                lastEnded := f_archive(m, endingReason, time_close)
                archivedThisBar := true
            m.phase := 0
        if goalTaken or outsideHistory
            lastRetired := m.uid
            retiredReason := goalTaken ? 2 : 5
            array.remove(models, mi)
        else
            // A wick beyond the old SL may become a NEW raid; it never repairs the old attempt.
            bool renewed = older and f_revalidateRange(m, open, high, low, close, time, time_close, bar_index)
            // A failed attempt without a valid immediate C3 replacement is over.
            // Do not retain it as a parent waiting for an unrelated future raid.
            if m.phase == 0
                array.remove(models, mi)
        mi -= 1

    [tsBull, tsBear] = f_patterns(open[1], high[1], low[1], close[1], open, high, low, close)
    bool crt = tsBull or tsBear
    if inScan and not na(time[1]) and crt
        // With timeout disabled, old context-only records must not starve a new C3.
        bool freshPath = tsBull ? high < high[1] : low > low[1]
        if array.size(models) >= queueLimit and freshPath
            Model oldest = array.shift(models)
            lastRetired := oldest.uid
            retiredReason := 6
            if oldest.uid == priorFocusId or not archivedThisBar
                lastEnded := f_archive(oldest, 6, time_close)
                archivedThisBar := true
        if array.size(models) < queueLimit
            int direction = tsBull ? 1 : -1
            float rh = high[1]
            float rl = low[1]
            Model fresh = Model.new(rangeKeys=parentReferences, bEnd=time_close, aEnd=time_close[1], uid=time[1], flags=1, kind=1, phase=1, dir=direction, bornIndex=bar_index, confirmedAt=time_close, resolvedAt=time_close, hi=rh, lo=rl, inv=direction == 1 ? low : high, cp=direction == 1 ? rh : rl, aO=open[1], aH=high[1], aL=low[1], aC=close[1], aT=time[1], bO=open, bH=high, bL=low, bC=close, bT=time)
            fresh.crtKey := direction == 1 ? priorBuyKey : priorSellKey
            fresh.hiT := time[1]
            fresh.loT := time[1]
            fresh.invT := time
            fresh.cpT := time[1]
            bool targetAtBirth = direction == 1 ? high >= fresh.cp : low <= fresh.cp
            if targetAtBirth
                lastRetired := fresh.uid
                retiredReason := 4
                if not archivedThisBar and f_archiveAllowed(fresh.kind)
                    lastEnded := f_archive(fresh, 4, time_close)
                    archivedThisBar := true
            else
                array.push(models, fresh)
        else
            dropped += 1

    // Search genuine, unconsumed HTF references. No EQ-as-IRL or invented measured targets.
    if array.size(models) > 0
        for i = 0 to array.size(models) - 1
            Model m = array.get(models, i)
            float up = na
            float dn = na
            int upT = na
            int dnT = na
            if array.size(swings) > 0
                for j = 0 to array.size(swings) - 1
                    Liquidity q = array.get(swings, j)
                    if q.side == 1 and q.price > m.hi and (na(up) or q.price < up)
                        up := q.price
                        upT := q.born
                    if q.side == -1 and q.price < m.lo and (na(dn) or q.price > dn)
                        dn := q.price
                        dnT := q.born
            m.erlU := up
            m.erlL := dn
            m.erlUT := upT
            m.erlLT := dnT
            if m.dir != 0 and na(m.cp)
                m.cp := m.dir == 1 ? up : dn
                m.cpT := m.dir == 1 ? upT : dnT
            if not na(m.irlT) and m.dir != 0 and m.irlDir != m.dir
                m.irlT := na
                m.irlH := na
                m.irlL := na
                m.irlKind := 0
            f_refreshIrl(m, swings)
    // Entry-open CRT first; otherwise the nearest still-valid C1 for tracking.
    Model selected = Model.new()
    if array.size(models) > 0
        for i = 0 to array.size(models) - 1
            Model candidate = array.get(models, i)
            if candidate.phase == 1 and f_preferCrt(candidate.bornIndex, candidate.aT, selected.bornIndex, selected.aT, bar_index)
                selected := candidate
    priorFocusId := selected.uid
    bool historyReady = firstSeen <= scanStart
    [selected.uid, selected.flags, selected.kind, selected.phase, selected.dir, selected.hi, selected.lo, selected.inv, selected.cp, selected.erlU, selected.erlL, selected.irlH, selected.irlL, selected.irlT, selected.irlKind, selected.confirmedAt, selected.resolvedAt, array.size(models), selected.aO, selected.aH, selected.aL, selected.aC, selected.aT, selected.bO, selected.bH, selected.bL, selected.bC, selected.bT, selected.cO, selected.cH, selected.cL, selected.cC, selected.cT, lastRetired, retiredReason, dropped, historyReady, bar_index - selected.bornIndex, selected.hiT, selected.loT, selected.invT, selected.cpT, selected.erlUT, selected.erlLT, selected.bullIrlH, selected.bullIrlL, selected.bullIrlT, selected.bullIrlKind, selected.bearIrlH, selected.bearIrlL, selected.bearIrlT, selected.bearIrlKind, selected.bullIrlLeft, selected.bearIrlLeft, selected.innerHi, selected.innerLo, selected.innerHiT, selected.innerLoT, lastEnded, selected.crtKey, selected.eqTouched, selected.aEnd, selected.cEnd, selected.bEnd]

// Every snapshot field is individually offset; live OHLC is display-only.
// C3 receives the previous confirmed C2 snapshot (age 0); C4 receives age 1.
f_snapshot(bool previous) =>
    [v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20, v21, v22, v23, v24, v25, v26, v27, v28, v29, v30, v31, v32, v33, v34, v35, v36, v37, v38, v39, v40, v41, v42, v43, v44, v45, v46, v47, v48, v49, v50, v51, v52, v53, v54, v55, v56, v57, v58, v59, v60, v61, v62, v63] = f_engine()
    [previous ? v0[1] : v0, previous ? v1[1] : v1, previous ? v2[1] : v2, previous ? v3[1] : v3, previous ? v4[1] : v4, previous ? v5[1] : v5, previous ? v6[1] : v6, previous ? v7[1] : v7, previous ? v8[1] : v8, previous ? v9[1] : v9, previous ? v10[1] : v10, previous ? v11[1] : v11, previous ? v12[1] : v12, previous ? v13[1] : v13, previous ? v14[1] : v14, previous ? v15[1] : v15, previous ? v16[1] : v16, previous ? v17[1] : v17, previous ? v18[1] : v18, previous ? v19[1] : v19, previous ? v20[1] : v20, previous ? v21[1] : v21, previous ? v22[1] : v22, previous ? v23[1] : v23, previous ? v24[1] : v24, previous ? v25[1] : v25, previous ? v26[1] : v26, previous ? v27[1] : v27, previous ? v28[1] : v28, previous ? v29[1] : v29, previous ? v30[1] : v30, previous ? v31[1] : v31, previous ? v32[1] : v32, previous ? v33[1] : v33, previous ? v34[1] : v34, previous ? v35[1] : v35, previous ? v36[1] : v36, previous ? v37[1] : v37, previous ? v38[1] : v38, previous ? v39[1] : v39, previous ? v40[1] : v40, previous ? v41[1] : v41, previous ? v42[1] : v42, previous ? v43[1] : v43, previous ? v44[1] : v44, previous ? v45[1] : v45, previous ? v46[1] : v46, previous ? v47[1] : v47, previous ? v48[1] : v48, previous ? v49[1] : v49, previous ? v50[1] : v50, previous ? v51[1] : v51, previous ? v52[1] : v52, previous ? v53[1] : v53, previous ? v54[1] : v54, previous ? v55[1] : v55, previous ? v56[1] : v56, previous ? v57[1] : v57, previous ? v58[1] : v58, previous ? v59[1] : v59, previous ? v60[1] : v60, previous ? v61[1] : v61, previous ? v62[1] : v62, previous ? v63[1] : v63]

[sId, sFlags, sKind, sPhase, sDir, sHi, sLo, sInv, sCp, sErlU, sErlL, sIrlH, sIrlL, sIrlT, sIrlKind, sConfirmed, sResolved, sCount, sAO, sAH, sAL, sAC, sAT, sBO, sBH, sBL, sBC, sBT, sCO, sCH, sCL, sCC, sCT, sRetired, sReason, sDropped, sReady, sModelAge, sHiT, sLoT, sInvT, sCpT, sErlUT, sErlLT, sBullIrlH, sBullIrlL, sBullIrlT, sBullIrlKind, sBearIrlH, sBearIrlL, sBearIrlT, sBearIrlKind, sBullIrlLeft, sBearIrlLeft, sInnerHi, sInnerLo, sInnerHiT, sInnerLoT, sArchived, kCrtKey, sEqTouched, sAEnd, sCEnd, sBEnd] = if onHtf
    f_snapshot(not barstate.isconfirmed)
else
    request.security(syminfo.tickerid, htf, f_snapshot(true), lookahead=barmerge.lookahead_on, calc_bars_count=5000)

// Independent bias from the chosen reference TF: confirmed reclaim or range close-through.
[autoBias, autoBiasAge, autoBiasHigh, autoBiasLow, autoGuardHigh, autoGuardLow] = if chartSeconds == timeframe.in_seconds(biasTf)
    f_biasSnapshot(not barstate.isconfirmed)
else
    request.security(syminfo.tickerid, biasTf, f_biasSnapshot(true), lookahead=barmerge.lookahead_on, calc_bars_count=5000)
int structureBias = biasMode == "Auto" ? nz(autoBias) : biasMode == "Long" ? 1 : biasMode == "Short" ? -1 : 0
float biasCheckClose = barstate.isconfirmed ? close : close[1]
bool biasPaused = biasMode == "Auto" and chartSeconds < timeframe.in_seconds(biasTf) and (structureBias == 1 ? not na(autoGuardLow) and biasCheckClose < autoGuardLow : structureBias == -1 ? not na(autoGuardHigh) and biasCheckClose > autoGuardHigh : false)
int biasDir = biasPaused ? 0 : structureBias

// Preview is aggregated from THIS chart's actual bars, including the live bar.
// Incomplete first buckets are not presented as complete OHLC candles.
int bucketTime = time(htf)
int bucketEnd = time_close(htf)
var float liveO = na
var float liveH = na
var float liveL = na
var float liveC = na
var int liveT = na
var int liveEnd = na
var int liveHighTime = na
var int liveLowTime = na
var bool liveComplete = false
var int bucketCounter = 0
var array<int> candleTimes = array.new<int>()
var array<int> candleEndTimes = array.new<int>()
var array<float> candleOpens = array.new<float>()
var array<float> candleHighs = array.new<float>()
var array<float> candleLows = array.new<float>()
var array<float> candleCloses = array.new<float>()
var array<int> candleHighTimes = array.new<int>()
var array<int> candleLowTimes = array.new<int>()
bool newBucket = na(liveT) or bucketTime != liveT
if newBucket
    if not na(liveT) and liveComplete
        array.push(candleTimes, liveT)
        array.push(candleEndTimes, liveEnd)
        array.push(candleOpens, liveO)
        array.push(candleHighs, liveH)
        array.push(candleLows, liveL)
        array.push(candleCloses, liveC)
        array.push(candleHighTimes, liveHighTime)
        array.push(candleLowTimes, liveLowTime)
        if array.size(candleTimes) > 1000
            array.shift(candleTimes)
            array.shift(candleEndTimes)
            array.shift(candleOpens)
            array.shift(candleHighs)
            array.shift(candleLows)
            array.shift(candleCloses)
            array.shift(candleHighTimes)
            array.shift(candleLowTimes)
    bucketCounter += 1
    liveT := bucketTime
    liveEnd := bucketEnd
    liveO := open
    liveH := high
    liveL := low
    liveC := close
    liveHighTime := time
    liveLowTime := time
    liveComplete := time == bucketTime
else
    if high > liveH
        liveHighTime := time
    if low < liveL
        liveLowTime := time
    liveH := math.max(liveH, high)
    liveL := math.min(liveL, low)
    liveC := close

// Confirmed larger-TF bars use explicit history offsets. The forming bar is
// aggregated from this chart only; an incomplete first bucket is omitted.
f_largerClosed() =>
    [time[3], open[3], high[3], low[3], close[3], time_close[3], time[2], open[2], high[2], low[2], close[2], time_close[2], time[1], open[1], high[1], low[1], close[1], time_close[1]]
[h3T, h3O, h3H, h3L, h3C, h3End, h2T, h2O, h2H, h2L, h2C, h2End, h1T, h1O, h1H, h1L, h1C, h1End] = request.security(syminfo.tickerid, largerTf, f_largerClosed(), lookahead=barmerge.lookahead_on, calc_bars_count=5000)
int largerBucket = time(largerTf)
int largerEnd = time_close(largerTf)
var int largerLiveT = na
var float largerLiveO = na
var float largerLiveH = na
var float largerLiveL = na
var float largerLiveC = na
var bool largerComplete = false
if na(largerLiveT) or largerLiveT != largerBucket
    largerLiveT := largerBucket
    largerLiveO := open
    largerLiveH := high
    largerLiveL := low
    largerLiveC := close
    largerComplete := time == largerBucket
else
    largerLiveH := math.max(largerLiveH, high)
    largerLiveL := math.min(largerLiveL, low)
    largerLiveC := close


// The HTF snapshot is immutable. A chart-side latch retires it on CLOSED LTF
// evidence without waiting for the forming HTF candle to close or rewriting history.
type FocusLifecycle
    int uid = na
    int reason = 0
    int confirmation = na
    bool rangeDone = false
    int endedAt = na
    ModelArchive archived = na

f_stepFocus(FocusLifecycle state, int uid, int direction, int confirmedAt, float invalidation, float targetLevel, int age, int barOpen, int barClose, float barHigh, float barLow, bool closedBar, bool attemptOpen = true) =>
    int endedNow = 0
    if not na(uid) and (na(state.uid) or state.uid != uid)
        state.uid := uid
        state.rangeDone := false
        state.confirmation := na
    if not na(uid) and (na(state.confirmation) or state.confirmation != confirmedAt)
        state.confirmation := confirmedAt
        state.reason := 0
        state.endedAt := na
    if not na(uid) and closedBar and barOpen >= confirmedAt and (direction == 1 ? barHigh >= targetLevel : barLow <= targetLevel)
        state.rangeDone := true
    if not na(uid) and state.reason == 0 and closedBar and attemptOpen
        bool older = barOpen >= confirmedAt
        int reason = f_crtEnd(direction, invalidation, targetLevel, barHigh, barLow, na, older, false, false, false)
        if reason != 0
            state.reason := reason
            state.endedAt := barClose
            endedNow := reason
    endedNow

f_visibleArchive(ModelArchive localArchive, ModelArchive htfArchive) =>
    bool localReady = not na(localArchive) and not na(localArchive.uid)
    bool htfReady = not na(htfArchive) and not na(htfArchive.uid)
    bool preferLocal = localReady and (not htfReady or (localArchive.uid == htfArchive.uid and localArchive.confirmedAt == htfArchive.confirmedAt) or localArchive.endedAt >= htfArchive.endedAt)
    preferLocal ? localArchive : htfArchive

var FocusLifecycle focusLife = FocusLifecycle.new()
int focusEndedNow = f_stepFocus(focusLife, sId, sDir, sConfirmed, sInv, sCp, sModelAge, time, time_close, high, low, barstate.isconfirmed, sPhase == 1)
if focusEndedNow != 0
    // The local event may be mid-HTF: preserve C1/C2, never fabricate a closed C3.
    focusLife.archived := ModelArchive.new(confirmedAt=sConfirmed, aEnd=sAEnd, bEnd=sBEnd, uid=sId, flags=sFlags, kind=sKind, phase=sPhase, aO=sAO, aH=sAH, aL=sAL, aC=sAC, aT=sAT, bO=sBO, bH=sBH, bL=sBL, bC=sBC, bT=sBT, endReason=focusEndedNow, endedAt=time_close)
bool rangeAvailable = not na(sId) and not (focusLife.uid == sId and focusLife.rangeDone)
bool focusAvailable = rangeAvailable and sPhase == 1 and focusLife.uid == sId and focusLife.confirmation == sConfirmed and focusLife.reason == 0
ModelArchive visibleArchive = f_visibleArchive(focusLife.archived, sArchived)
int lastSetupEnd = not na(visibleArchive) and not na(visibleArchive.uid) ? visibleArchive.endReason : sReason


// CRT time follows the actual feed candle boundaries, including session gaps.
