requireKey = input.bool(true, "Require prior HTF key reaction", group=G_KEY, tooltip="Default: each LTF TS/P3 must react at a completed H1/main/larger/bias HTF key known BEFORE its raid. Swing needs sweep + reclaim; zones need contact + reclaim. Old CRT context alone is insufficient. Off diagnoses aligned TS/FVG only; MPS/OTE and counter-bias still need a local key. SMT never replaces a price key.", display=display.none)
