// Packed UDT avoids exceeding Pine's combined 127 request tuple elements.
type HigherSnapshot
    int id = na
    int flags = 0
    int phase = 0
    int dir = 0
    float hi = na
    float lo = na
    float inv = na
    float cp = na
    int confirmed = na
    int resolved = na
    int age = 0
    int aT = na
    int aEnd = na
    int bT = na
    int bEnd = na
    int reason = 0
