showLargerCluster = input.bool(true, "Larger HTF candle cluster", group=G_VIEW, tooltip="Thêm cụm OHLC HTF lớn hơn bên cạnh cụm chính; chỉ quan sát, không tự lọc tín hiệu hay đổi bias. Wick và body lấy đúng nguồn giá.")
