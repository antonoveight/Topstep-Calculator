biasMode = input.string("Auto", "Bias", options=["Auto", "Long", "Short", "Neutral"], group=G_BIAS, tooltip="Auto dùng close phá swing xác nhận trên Bias TF; giữ hướng đến khi cấu trúc đổi. B0! tạm chặn theo close chart xuyên guard ngược hướng, không tự coi là bias đối diện. Long/Short/Neutral là ý kiến chủ động của bạn; reset khi bối cảnh thay đổi.", display=display.none)
filterBias = true
allowCrtCounter = input.bool(true, "CRT reversal at prior HTF key", group=G_ENTRY, tooltip="Counter bias/parent requires a prior context key, a local HTF key reaction AND an ordered P1-P2-P3 swing sweep/reclaim. A two-candle adjacent TS alone is insufficient. MPS is still required only for OTE. B0 stays blocked.", display=display.none)
structureMode = input.string("Chart", "Structure timeframe", options=["Chart", "M15"], group=G_ENTRY, tooltip="Chart keeps existing swing/close timing. M15 uses independently confirmed M15 swings and M15 closes for MPS while TS/FVG/OTE execution stays on M1/M3/M5. A direct M15 chart is also supported. No fixed M15-to-H4 identity is assumed.", display=display.none)
signalCadence = input.string(DEFAULT_SIGNAL_CADENCE, "Signal cadence", options=["Fresh reaction", "One per model"], group=G_ENTRY, tooltip="Fresh reaction: mỗi nhịp TS có tối đa một dấu cho từng nhánh TS/FVG/OTE. One per model chỉ phát một lần cho mỗi setup.", display=display.none)
