// Legacy tuple liquidity slots are intentionally empty; CRT keys are separate.

f_archive(Model m, int reason, int endedAt) =>
    ModelArchive.new(aEnd=m.aEnd, bEnd=m.bEnd, cEnd=m.cEnd, aO=m.aO, aH=m.aH, aL=m.aL, aC=m.aC, aT=m.aT, bO=m.bO, bH=m.bH, bL=m.bL, bC=m.bC, bT=m.bT, cO=m.cO, cH=m.cH, cL=m.cL, cC=m.cC, cT=m.cT, endReason=reason, endedAt=endedAt)
f_archiveAllowed(int kind) =>
    kind == 1

// rangeKeys belong to the registry only; no chart consumer reads that pool.
// Sending it through request.security copies the entire frozen collection.
f_exportModel(Model source) =>
    ModelView.new(flags=source.flags, dir=source.dir, hi=source.hi, lo=source.lo, inv=source.inv, cp=source.cp, confirmedAt=source.confirmedAt, aO=source.aO, aC=source.aC, aT=source.aT, bO=source.bO, bH=source.bH, bL=source.bL, bC=source.bC, bT=source.bT, cO=source.cO, cH=source.cH, cL=source.cL, cC=source.cC, cT=source.cT, crtKey=source.crtKey, eqTouched=source.eqTouched, aEnd=source.aEnd, cEnd=source.cEnd, bEnd=source.bEnd)

// Context outcomes, not executed trade outcomes. OHLC cannot order both barriers.
f_crtEnd(int direction, float invalidation, float targetLevel, float barHigh, float barLow, float closing, bool older, bool outsideHistory, bool timedOut, bool entryExpired = false) =>
    bool bad = older and (direction == 1 ? barLow <= invalidation : barHigh >= invalidation)
    bool reached = older and (direction == 1 ? barHigh >= targetLevel : barLow <= targetLevel)
    bad and reached ? 4 : bad ? 1 : reached ? 2 : entryExpired ? 7 : outsideHistory ? 5 : timedOut ? 3 : 0

// References are matched BEFORE current-bar pool consumption/creation.
f_keyReact(CrtKey k, int beforeTime, int direction, float barHigh, float barLow, float barClose) =>
    bool preexisting = k.kind > 0 and not na(k.knownAt) and k.knownAt <= beforeTime
    bool sameSide = k.dir == direction
    bool sweepReaction = direction == 1 ? barLow <= k.lo - sweepSize and barClose > k.hi : barHigh >= k.hi + sweepSize and barClose < k.lo
    bool enabled = keyTypes == "All" or keyTypes == "Swing" and k.kind == 3 or keyTypes == "Swing + FVG" and (k.kind == 3 or k.kind == 1) or keyTypes == "Swing + OB" and (k.kind == 3 or k.kind == 2) or keyTypes == "Open / Close" and (k.kind == 4 or k.kind == 5) or keyTypes == "Weekly wick" and k.kind == 6
    bool zoneReaction = barHigh >= k.lo and barLow <= k.hi and (direction == 1 ? barClose > k.hi : barClose < k.lo)
    preexisting and sameSide and enabled and (k.kind == 3 ? sweepReaction : zoneReaction)

f_findCrtKey(array<Liquidity> swings, int beforeTime, int direction, float barHigh, float barLow, float barClose, string sourceTf) =>
    CrtKey found = CrtKey.new()
    if array.size(swings) > 0
        for offset = 0 to array.size(swings) - 1
            Liquidity q = array.get(swings, array.size(swings) - 1 - offset)
            CrtKey candidate = CrtKey.new(kind=3, dir=-q.side, hi=q.price, lo=q.price, born=q.born, leftTime=q.born, knownAt=q.knownAt, beforeTime=beforeTime, tf=sourceTf)
            if found.kind == 0 and f_keyReact(candidate, beforeTime, direction, barHigh, barLow, barClose)
                found := candidate
    found

f_keyIdentity(CrtKey key) =>
    key.tf + ":" + str.tostring(key.kind) + ":" + str.tostring(key.dir) + ":" + str.tostring(key.knownAt)

f_matchKeyMap(KeyMap keyMap, array<string> usedKeys, int beforeTime, int direction, float barHigh, float barLow, float barClose) =>
    CrtKey found = CrtKey.new()
    if array.size(keyMap.levels) > 0
        for j = 0 to array.size(keyMap.levels) - 1
            CrtKey candidate = array.get(keyMap.levels, j)
            if (found.kind == 0 or candidate.kind < found.kind) and not array.includes(usedKeys, f_keyIdentity(candidate)) and f_keyReact(candidate, beforeTime, direction, barHigh, barLow, barClose)
                found := candidate.copy()
                found.beforeTime := beforeTime
    found

f_markHigherUsed(KeyMap keyMap, array<string> usedKeys, int barStart, float barHigh, float barLow) =>
    if array.size(keyMap.levels) > 0
        for j = 0 to array.size(keyMap.levels) - 1
            CrtKey key = array.get(keyMap.levels, j)
            bool consumed = key.kind == 3 and (key.dir == 1 ? barLow <= key.lo : barHigh >= key.hi)
            string identity = f_keyIdentity(key)
            if barStart >= key.knownAt and consumed and not array.includes(usedKeys, identity)
                array.push(usedKeys, identity)
    while array.size(usedKeys) > 160
        array.shift(usedKeys)

f_updateKeyPoolsAt(array<Liquidity> swings, int scanStart, bool inScan, float ph, float pl, int pivotAt, float barHigh, float barLow, int knownAt) =>
    // Remove consumed or out-of-window references, before looking for new CP levels.
    int si = array.size(swings) - 1
    while si >= 0
        Liquidity q = array.get(swings, si)
        if q.born < scanStart or (q.side == 1 ? barHigh >= q.price : barLow <= q.price)
            array.remove(swings, si)
        si -= 1
    if inScan and not na(ph) and pivotAt >= scanStart and barHigh < ph
        array.push(swings, Liquidity.new(knownAt=knownAt, price=ph, side=1, born=pivotAt))
    if inScan and not na(pl) and pivotAt >= scanStart and barLow > pl
        array.push(swings, Liquidity.new(knownAt=knownAt, price=pl, side=-1, born=pivotAt))
    if array.size(swings) > 80
        array.shift(swings)
f_updateKeyPools(array<Liquidity> swings, int scanStart, bool inScan, float ph, float pl) =>
    f_updateKeyPoolsAt(swings, scanStart, inScan, ph, pl, time[htfPivotLength], high, low, time_close)
f_collectKeyMap(array<Liquidity> swings, string sourceTf) =>
    array<CrtKey> levels = array.new<CrtKey>()
    for direction = -1 to 1 by 2
        int collected = 0
        if array.size(swings) > 0
            for offset = 0 to array.size(swings) - 1
                Liquidity q = array.get(swings, array.size(swings) - 1 - offset)
                if -q.side == direction and collected < 2
                    array.push(levels, CrtKey.new(kind=3, dir=direction, hi=q.price, lo=q.price, born=q.born, leftTime=q.born, knownAt=q.knownAt, tf=sourceTf))
                    collected += 1
    KeyMap.new(levels)

// Key provenance is HTF-only. All newly created keys become usable NEXT bar.
// FVG = wick gap of three closed candles; OB = last opposite candle (<=5)
// before a close breaks its full wick and the preceding bar, not an LTF entry OB.
f_pushKey(array<CrtKey> zones, int kind, int direction, float hi, float lo, int left, string sourceTf) =>
    array.push(zones, CrtKey.new(kind=kind, dir=direction, hi=hi, lo=lo, born=left, leftTime=left, knownAt=time_close, tf=sourceTf))
    while array.size(zones) > 40
        array.shift(zones)
f_zoneKeys(array<CrtKey> zones, string sourceTf) =>
    int i = array.size(zones) - 1
    while i >= 0
        CrtKey k = array.get(zones, i)
        bool broken = k.dir == 1 ? close < k.lo : close > k.hi
        bool old = time - k.knownAt > int(timeframe.in_seconds() * 1000) * 48
        if broken or old
            array.remove(zones, i)
        i -= 1
    if not na(high[2]) and low > high[2]
        f_pushKey(zones, 1, 1, low, high[2], time[2], sourceTf)
    if not na(low[2]) and high < low[2]
        f_pushKey(zones, 1, -1, low[2], high, time[2], sourceTf)
    bool up = close > open and close > high[1]
    bool down = close < open and close < low[1]
    if up or down
        bool found = false
        for back = 1 to 5
            bool opposite = up ? close[back] < open[back] : close[back] > open[back]
            bool displaced = up ? close > high[back] and close[1] <= high[back] : close < low[back] and close[1] >= low[back]
            if not found and opposite
                found := true
                if displaced
                    int direction = up ? 1 : -1
                    f_pushKey(zones, 2, direction, high[back], low[back], time[back], sourceTf)
                    f_pushKey(zones, 4, direction, open[back], open[back], time[back], sourceTf)
                    f_pushKey(zones, 5, direction, close[back], close[back], time[back], sourceTf)
    zones
// Mechanical personal reference: midpoint of each real wick, not candle EQ.
// Created in W1 and exposed only through its previous completed snapshot.
f_weeklyWickMap(float opening, float barHigh, float barLow, float closing, int openedAt, int closedAt) =>
    array<CrtKey> levels = array.new<CrtKey>()
    float bodyLow = math.min(opening, closing)
    float bodyHigh = math.max(opening, closing)
    if not na(closedAt) and bodyLow - barLow > sweepSize
        float lowerMid = (barLow + bodyLow) / 2
        array.push(levels, CrtKey.new(kind=6, dir=1, lo=lowerMid, hi=lowerMid, born=openedAt, leftTime=openedAt, knownAt=closedAt, tf="1W"))
    if not na(closedAt) and barHigh - bodyHigh > sweepSize
        float upperMid = (barHigh + bodyHigh) / 2
        array.push(levels, CrtKey.new(kind=6, dir=-1, lo=upperMid, hi=upperMid, born=openedAt, leftTime=openedAt, knownAt=closedAt, tf="1W"))
    KeyMap result = KeyMap.new(levels)
    result.sourceClose := closing
    result.sourceEnd := closedAt
    result.sourceTf := "1W"
    result
f_weeklyWickSnapshot() =>
    KeyMap result = f_weeklyWickMap(open, high, low, close, time, time_close)
    result[1]
// One shared completed-week request, never re-requested inside an HTF engine.
KeyMap completedWeeklyKeys = request.security(syminfo.tickerid, "1W", f_weeklyWickSnapshot(), lookahead=barmerge.lookahead_on, calc_bars_count=requestDepth)

// One scan replaces eight scans of the same zone pool. Preserve kind/direction
// priority and newest-two order exactly; do not change which key wins.
f_appendZoneKeys(array<CrtKey> levels, array<CrtKey> zones) =>
    array<CrtKey> slots = array.new<CrtKey>()
    for i = 0 to 19
        array.push(slots, na)
    if array.size(zones) > 0
        for back = 0 to array.size(zones) - 1
            CrtKey k = array.get(zones, array.size(zones) - 1 - back)
            int slot = (k.kind - 1) * 4 + (k.dir == 1 ? 2 : 0)
            if na(array.get(slots, slot))
                array.set(slots, slot, k)
            else if na(array.get(slots, slot + 1))
                array.set(slots, slot + 1, k)
    for i = 0 to 19
        CrtKey k = array.get(slots, i)
        if not na(k)
            array.push(levels, k.copy())
    levels

f_higherKeyMap(string sourceTf) =>
    var array<Liquidity> swings = array.new<Liquidity>()
    var array<CrtKey> zones = array.new<CrtKey>()
    int scanStart = last_bar_time - int(timeframe.in_seconds() * 1000) * scanDepth
    float ph = ta.pivothigh(high, htfPivotLength, htfPivotLength)
    float pl = ta.pivotlow(low, htfPivotLength, htfPivotLength)
    f_updateKeyPools(swings, scanStart, time >= scanStart, ph, pl)
    f_zoneKeys(zones, sourceTf)
    KeyMap result = f_collectKeyMap(swings, sourceTf)
    result.sourceClose := close
    result.sourceEnd := time_close
    result.sourceTf := sourceTf
    f_appendZoneKeys(result.levels, zones)
    result

type ClockCandle
    int t = na
    int e = na
    float o = na
    float h = na
    float l = na
    float c = na
type AlignedTape
    array<ClockCandle> bars = na
    int t = na
    int e = na
    float o = na
    float h = na
    float l = na
    float c = na
    int seq = -1
    int lastHour = na
    int coveredEnd = na
    int formingStart = na
    bool complete = false
    bool changed = false
f_ingestAligned(AlignedTape state, ClockCandle part, int start, int finish, bool strict = true) =>
    bool changed = false
    if not na(part.t) and not na(start) and part.e <= finish and (na(state.lastHour) or part.t > state.lastHour)
        int gap = part.t - state.coveredEnd
        bool scheduledBreak = strict and not na(state.coveredEnd) and hour(part.t, CT) == 17 and hour(state.coveredEnd, CT) == 16 and (gap == 3600000 or dayofweek(state.coveredEnd, CT) == dayofweek.friday and dayofweek(part.t, CT) == dayofweek.sunday and gap >= 48 * 3600000 and gap <= 50 * 3600000)
        if strict and not na(state.coveredEnd) and part.t > state.coveredEnd and not scheduledBreak
            // An in-session data gap cannot connect two unrelated CRT candles.
            array.clear(state.bars)
            state.seq += 1
        state.lastHour := part.t
        if na(state.t) or state.t != start
            state.t := start
            state.e := finish
            state.o := part.o
            state.h := part.h
            state.l := part.l
            state.c := part.c
            state.complete := part.t == start
            state.formingStart := start
        else
            state.complete := state.complete and state.coveredEnd == part.t
            state.h := math.max(state.h, part.h)
            state.l := math.min(state.l, part.l)
            state.c := part.c
        state.coveredEnd := part.e
        if part.e == finish
            if state.complete
                array.push(state.bars, ClockCandle.new(t=state.t, e=state.e, o=state.o, h=state.h, l=state.l, c=state.c))
                if array.size(state.bars) > 8
                    array.shift(state.bars)
                state.seq += 1
                changed := true
            else
                array.clear(state.bars)
                state.seq += 1
            state.t := na
    changed
f_alignedTape(simple string sourceTf) =>
    var AlignedTape state = AlignedTape.new(bars=array.new<ClockCandle>())
    // Previous H1 only: immutable at this H1's open, including realtime ticks.
    ClockCandle part = ClockCandle.new(t=time[1], e=time_close[1], o=open[1], h=high[1], l=low[1], c=close[1])
    [start, finish] = f_sessionTimes(sourceTf)
    state.changed := f_ingestAligned(state, part, f_alignedTf(sourceTf) ? start[1] : time[1], f_alignedTf(sourceTf) ? finish[1] : time_close[1], f_alignedTf(sourceTf))
    state
f_tapeBar(array<ClockCandle> bars, int back) =>
    int at = array.size(bars) - 1 - back
    at >= 0 ? array.get(bars, at) : ClockCandle.new()
// Display only: current H1 may evolve. Never pass this preview to the registry.
type ClockPreview
    ClockCandle live = na
    ClockCandle first = na
    ClockCandle second = na
    ClockCandle third = na
    bool complete = false
f_clockPreview(simple string sourceTf) =>
    AlignedTape feed = f_alignedTape(sourceTf)
    [start, finish] = f_sessionTimes(sourceTf)
    ClockCandle partial = ClockCandle.new(t=feed.t, e=feed.e, o=feed.o, h=feed.h, l=feed.l, c=feed.c)
    bool hasPrefix = partial.t == start and feed.complete and feed.coveredEnd == time
    bool complete = not na(start) and (hasPrefix or time == start)
    ClockCandle live = ClockCandle.new(t=start, e=finish, o=hasPrefix ? partial.o : open, h=hasPrefix ? math.max(partial.h, high) : high, l=hasPrefix ? math.min(partial.l, low) : low, c=close)
    ClockPreview.new(live=live, first=f_tapeBar(feed.bars, 0), second=f_tapeBar(feed.bars, 1), third=f_tapeBar(feed.bars, 2), complete=complete)
f_sourceFrame(simple string sourceTf) =>
    if f_alignedTf(sourceTf)
        f_clockPreview(sourceTf)
    else
        ClockCandle live = ClockCandle.new(t=time, e=time_close, o=open, h=high, l=low, c=close)
        ClockCandle first = ClockCandle.new(t=time[1], e=time_close[1], o=open[1], h=high[1], l=low[1], c=close[1])
        ClockCandle previousTwo = ClockCandle.new(t=time[2], e=time_close[2], o=open[2], h=high[2], l=low[2], c=close[2])
        ClockCandle third = ClockCandle.new(t=time[3], e=time_close[3], o=open[3], h=high[3], l=low[3], c=close[3])
        ClockPreview.new(live=live, first=first, second=previousTwo, third=third, complete=true)
// Rightmost equal extreme owns a pivot; confirmation needs two later closes.
f_tapePivots(array<ClockCandle> bars) =>
    ClockCandle candidate = f_tapeBar(bars, 2)
    bool peak = array.size(bars) >= 5
    bool trough = peak
    if peak
        for back = 0 to 4
            if back != 2
                ClockCandle item = f_tapeBar(bars, back)
                peak := peak and (back < 2 ? candidate.h > item.h : candidate.h >= item.h)
                trough := trough and (back < 2 ? candidate.l < item.l : candidate.l <= item.l)
    [peak ? candidate.h : na, trough ? candidate.l : na, candidate.t]
f_pushTapeKey(array<CrtKey> zones, int kind, int direction, float hi, float lo, int left, int knownAt, string sourceTf) =>
    array.push(zones, CrtKey.new(kind=kind, dir=direction, hi=hi, lo=lo, born=left, leftTime=left, knownAt=knownAt, tf=sourceTf))
    while array.size(zones) > 40
        array.shift(zones)
f_tapeZoneKeys(array<CrtKey> zones, array<ClockCandle> bars, simple string sourceTf) =>
    ClockCandle b = f_tapeBar(bars, 0)
    ClockCandle p = f_tapeBar(bars, 1)
    ClockCandle p2 = f_tapeBar(bars, 2)
    int i = array.size(zones) - 1
    while i >= 0
        CrtKey k = array.get(zones, i)
        bool broken = k.dir == 1 ? b.c < k.lo : b.c > k.hi
        bool old = b.t - k.knownAt > int(timeframe.in_seconds(sourceTf) * 1000) * 48
        if broken or old
            array.remove(zones, i)
        i -= 1
    if not na(p2.h) and b.l > p2.h
        f_pushTapeKey(zones, 1, 1, b.l, p2.h, p2.t, b.e, sourceTf)
    if not na(p2.l) and b.h < p2.l
        f_pushTapeKey(zones, 1, -1, p2.l, b.h, p2.t, b.e, sourceTf)
    bool up = b.c > b.o and b.c > p.h
    bool down = b.c < b.o and b.c < p.l
    if up or down
        bool found = false
        for back = 1 to 5
            ClockCandle item = f_tapeBar(bars, back)
            bool opposite = up ? item.c < item.o : item.c > item.o
            bool displaced = up ? b.c > item.h and p.c <= item.h : b.c < item.l and p.c >= item.l
            if not found and opposite
                found := true
                if displaced
                    int direction = up ? 1 : -1
                    f_pushTapeKey(zones, 2, direction, item.h, item.l, item.t, b.e, sourceTf)
                    f_pushTapeKey(zones, 4, direction, item.o, item.o, item.t, b.e, sourceTf)
                    f_pushTapeKey(zones, 5, direction, item.c, item.c, item.t, b.e, sourceTf)
    zones
type SourcePacket
    int t = na
    int e = na
    float o = na
    float h = na
    float l = na
    float c = na
    int prevT = na
    int prevE = na
    float prevO = na
    float prevH = na
    float prevL = na
    float prevC = na
    KeyMap keys = na
    KeyMap priorKeys = na
    int seq = na
    int formingStart = na
    float pivotHigh = na
    float pivotLow = na
    int pivotAt = na
    bool changed = false
f_sourcePacket(simple string sourceTf) =>
    AlignedTape feed = f_alignedTape(sourceTf)
    array<ClockCandle> bars = feed.bars
    int seq = feed.seq
    int formingStart = feed.formingStart
    [ph, pl, pivotAt] = f_tapePivots(bars)
    bool changed = feed.changed
    ClockCandle b = f_tapeBar(bars, 0)
    var array<Liquidity> swings = array.new<Liquidity>()
    var array<CrtKey> zones = array.new<CrtKey>()
    var KeyMap keys = KeyMap.new(array.new<CrtKey>())
    var KeyMap priorKeys = KeyMap.new(array.new<CrtKey>())
    var int processed = na
    bool advance = changed and not na(b.t) and (na(processed) or b.t > processed)
    if advance
        priorKeys := keys
        int scanStart = last_bar_time - int(timeframe.in_seconds(sourceTf) * 1000) * scanDepth
        f_updateKeyPoolsAt(swings, scanStart, b.t >= scanStart, ph, pl, pivotAt, b.h, b.l, b.e)
        f_tapeZoneKeys(zones, bars, sourceTf)
        keys := f_collectKeyMap(swings, sourceTf)
        keys.sourceClose := b.c
        keys.sourceEnd := b.e
        keys.sourceTf := sourceTf
        f_appendZoneKeys(keys.levels, zones)
        processed := b.t
    ClockCandle p = f_tapeBar(bars, 1)
    SourcePacket.new(t=b.t, e=b.e, o=b.o, h=b.h, l=b.l, c=b.c, prevT=p.t, prevE=p.e, prevO=p.o, prevH=p.h, prevL=p.l, prevC=p.c, keys=keys, priorKeys=priorKeys, seq=seq, formingStart=formingStart, pivotHigh=ph, pivotLow=pl, pivotAt=pivotAt, changed=advance)
f_priorBiasKeys() =>
    SourcePacket packet = f_sourcePacket(biasTf)
    packet.keys
KeyMap completedBiasKeys = request.security(syminfo.tickerid, f_transportTf(biasTf), f_priorBiasKeys(), lookahead=f_sourceLookahead(biasTf), calc_bars_count=f_sourceDepth(biasTf))

// Freeze the references that existed before C1. They are evidence for this parent,
// not a claim that liquidity can be traded repeatedly without a new raid/reclaim.
f_parentKeys(array<Liquidity> swings, KeyMap higherMap, array<string> consumed, int beforeTime, string sourceTf) =>
    array<CrtKey> levels = array.new<CrtKey>()
    if array.size(swings) > 0
        for i = 0 to array.size(swings) - 1
            Liquidity q = array.get(swings, i)
            if q.knownAt <= beforeTime
                array.push(levels, CrtKey.new(kind=3, dir=-q.side, hi=q.price, lo=q.price, born=q.born, leftTime=q.born, knownAt=q.knownAt, beforeTime=beforeTime, tf=sourceTf))
    if not na(higherMap) and not na(higherMap.levels)
        if array.size(higherMap.levels) > 0
            for i = 0 to array.size(higherMap.levels) - 1
                CrtKey k = array.get(higherMap.levels, i)
                if k.knownAt <= beforeTime and not array.includes(consumed, f_keyIdentity(k))
                    CrtKey copy = k.copy()
                    copy.beforeTime := beforeTime
                    array.push(levels, copy)
    KeyMap.new(levels)

f_rangeReaction(KeyMap references, int beforeTime, int direction, float raidHigh, float raidLow, float closing) =>
    CrtKey found = CrtKey.new()
    if not na(references) and not na(references.levels)
        if array.size(references.levels) > 0
            for i = 0 to array.size(references.levels) - 1
                CrtKey k = array.get(references.levels, i)
                if found.kind == 0 and f_keyReact(k, beforeTime, direction, raidHigh, raidLow, closing)
                    found := k.copy()
    found

// Execution keys are current, completed HTF references. A model's historical
// key is context; it never proves that a NEW LTF P3 has reacted at a key.
f_executionFromSource(SourcePacket source) =>
    KeyMap previous = source.keys
    KeyMap result = KeyMap.new(array.new<CrtKey>())
    if not na(previous)
        result.sourceClose := previous.sourceClose
        result.sourceEnd := previous.sourceEnd
        result.sourceTf := previous.sourceTf
        for k in previous.levels
            array.push(result.levels, k.copy())
    // W1 already applies its own [1]; append AFTER the local offset to avoid
    // an extra H1/H4 delay at the week boundary (or a second weekly offset).
    KeyMap weekly = completedWeeklyKeys
    if not na(weekly) and not na(weekly.levels)
        for k in weekly.levels
            array.push(result.levels, k.copy())
    result
f_executionSnapshot(simple string tf) =>
    f_executionFromSource(f_sourcePacket(tf))
KeyMap executionH1 = request.security(syminfo.tickerid, f_transportTf("60"), f_executionSnapshot("60"), lookahead=f_sourceLookahead("60"), calc_bars_count=f_sourceDepth("60"))
KeyMap executionBias = request.security(syminfo.tickerid, f_transportTf(biasTf), f_executionSnapshot(biasTf), lookahead=f_sourceLookahead(biasTf), calc_bars_count=f_sourceDepth(biasTf))

// Price-based attempt failure is sticky. Revalidation below creates a new attempt,
// with a new confirmation token, and never rewrites the previous archive or SL.
f_revalidateRange(Model m, float opening, float barHigh, float barLow, float closing, int barTime, int barEnd, int currentIndex) =>
    // Only the ORIGINAL C3 may replace the original C2 raid. Never pair a stale
    // C1 with an unrelated raid hours/days later or chain renewals indefinitely.
    bool originalC3 = m.flags == 1 and currentIndex == m.bornIndex + 1 and barTime >= m.bEnd
    bool extended = m.dir == 1 ? barLow <= m.inv - sweepSize : barHigh >= m.inv + sweepSize
    bool inside = closing > m.lo and closing < m.hi
    CrtKey key = originalC3 and extended and inside ? f_rangeReaction(m.rangeKeys, m.bT, m.dir, barHigh, barLow, closing) : CrtKey.new()
    bool pathOpen = m.dir == 1 ? barHigh < m.cp : barLow > m.cp
    bool renewed = m.phase == 0 and originalC3 and extended and inside and pathOpen and key.kind > 0
    if renewed
        m.flags += 2
        m.phase := 1
        m.bornIndex := currentIndex
        m.confirmedAt := barEnd
        m.resolvedAt := barEnd
        m.resolvedIndex := currentIndex
        m.inv := m.dir == 1 ? barLow : barHigh
        m.invT := barTime
        m.crtKey := key
        m.bO := opening
        m.bH := barHigh
        m.bL := barLow
        m.bC := closing
        m.bT := barTime
        m.bEnd := barEnd
        m.cT := na
        m.cEnd := na
        m.cO := na
        m.cH := na
        m.cL := na
        m.cC := na
    renewed

f_preferCrt(int candidateBorn, int candidateRoot, int selectedBorn, int selectedRoot, int currentIndex) =>
    na(selectedRoot) or (candidateBorn == currentIndex and selectedBorn != currentIndex) or ((candidateBorn == currentIndex) == (selectedBorn == currentIndex) and candidateRoot > selectedRoot)

type EngineSnapshot
    ModelView model = na
    ModelArchive archive = na
    int retired = na
    int reason = 0
    int dropped = 0
    bool ready = false
    int count = 0
    int age = na

type RegistrySnapshot
    Model model = na
    ModelArchive archive = na
    int retired = na
    int reason = 0
    int dropped = 0
    bool ready = false
    int count = 0
    int age = na

f_stepRegistry(simple string sourceTf, SourcePacket source, KeyMap higherKeyMap, KeyMap weeklyReferences) =>
    var array<Model> models = array.new<Model>()
    var array<Liquidity> swings = array.new<Liquidity>()
    var ModelArchive lastEnded = ModelArchive.new()
    var array<string> usedHigherKeys = array.new<string>()
    var int priorFocusId = na
    bool archivedThisBar = false
    var int lastRetired = na
    var int retiredReason = 0
    var int dropped = 0
    var int firstSeen = source.t
    int scanStart = last_bar_time - int(timeframe.in_seconds(sourceTf) * 1000) * scanDepth
    bool inScan = source.t >= scanStart
    KeyMap priorLocalMap = source.priorKeys
    [tsBull, tsBear] = f_patterns(source.prevO, source.prevH, source.prevL, source.prevC, source.o, source.h, source.l, source.c)
    bool crt = tsBull or tsBear
    KeyMap parentReferences = KeyMap.new(array.new<CrtKey>())
    CrtKey priorBuyKey = CrtKey.new()
    CrtKey priorSellKey = CrtKey.new()
    // Build/freeze a parent pool only when this bar can create a CRT.
    // Consumption below still runs EVERY bar, before source pool updates.
    if inScan and not na(source.prevT) and crt
        parentReferences := f_parentKeys(swings, higherKeyMap, usedHigherKeys, source.t, sourceTf)
        if not na(weeklyReferences) and not na(weeklyReferences.levels)
            for k in weeklyReferences.levels
                CrtKey frozenWeekly = k.copy()
                frozenWeekly.beforeTime := source.t
                array.push(parentReferences.levels, frozenWeekly)
        if not na(priorLocalMap) and not na(priorLocalMap.levels)
            for k in priorLocalMap.levels
                CrtKey frozen = k.copy()
                frozen.beforeTime := source.t
                array.push(parentReferences.levels, frozen)
        priorBuyKey := f_rangeReaction(parentReferences, source.t, 1, source.h, source.l, source.c)
        priorSellKey := f_rangeReaction(parentReferences, source.t, -1, source.h, source.l, source.c)
        if biasTf != sourceTf and not na(higherKeyMap) and not na(higherKeyMap.levels)
            if priorBuyKey.kind == 0
                priorBuyKey := f_matchKeyMap(higherKeyMap, usedHigherKeys, source.t, 1, source.h, source.l, source.c)
            if priorSellKey.kind == 0
                priorSellKey := f_matchKeyMap(higherKeyMap, usedHigherKeys, source.t, -1, source.h, source.l, source.c)
    if biasTf != sourceTf and not na(higherKeyMap) and not na(higherKeyMap.levels)
        f_markHigherUsed(higherKeyMap, usedHigherKeys, source.t, source.h, source.l)
    f_updateKeyPoolsAt(swings, scanStart, inScan, source.pivotHigh, source.pivotLow, source.pivotAt, source.h, source.l, source.e)

    // A parent C1 outlives any individual attempt. Goal completion ends the parent.
    int mi = array.size(models) - 1
    while mi >= 0
        Model m = array.get(models, mi)
        bool older = source.e > m.confirmedAt
        if na(m.cT) and source.t >= m.confirmedAt and m.dir != 0
            m.cO := source.o
            m.cH := source.h
            m.cL := source.l
            m.cC := source.c
            m.cT := source.t
            m.cEnd := source.e
        float equilibrium = (m.hi + m.lo) / 2
        if older and (m.dir == 1 ? source.h >= equilibrium : source.l <= equilibrium)
            m.eqTouched := true
        int endingReason = m.phase == 1 ? f_crtEnd(m.dir, m.inv, m.cp, source.h, source.l, source.c, older, false, false) : 0
        bool goalTaken = older and (m.dir == 1 ? source.h >= m.cp : source.l <= m.cp)
        bool outsideHistory = m.aT < scanStart
        if endingReason != 0
            lastRetired := m.uid
            retiredReason := endingReason
            if f_archiveAllowed(m.kind) and (m.uid == priorFocusId or not archivedThisBar)
                lastEnded := f_archive(m, endingReason, source.e)
                archivedThisBar := true
            m.phase := 0
        if goalTaken or outsideHistory
            lastRetired := m.uid
            retiredReason := goalTaken ? 2 : 5
            array.remove(models, mi)
        else
            // A wick beyond the old SL may become a NEW raid; it never repairs the old attempt.
            bool renewed = older and f_revalidateRange(m, source.o, source.h, source.l, source.c, source.t, source.e, source.seq)
            // A failed attempt without a valid immediate C3 replacement is over.
            // Do not retain it as a parent waiting for an unrelated future raid.
            if m.phase == 0
                array.remove(models, mi)
        mi -= 1

    if inScan and not na(source.prevT) and crt
        // With timeout disabled, old context-only records must not starve a new C3.
        bool freshPath = tsBull ? source.h < source.prevH : source.l > source.prevL
        if array.size(models) >= queueLimit and freshPath
            Model oldest = array.shift(models)
            lastRetired := oldest.uid
            retiredReason := 6
            if oldest.uid == priorFocusId or not archivedThisBar
                lastEnded := f_archive(oldest, 6, source.e)
                archivedThisBar := true
        if array.size(models) < queueLimit
            int direction = tsBull ? 1 : -1
            float rh = source.prevH
            float rl = source.prevL
            Model fresh = Model.new(rangeKeys=parentReferences, bEnd=source.e, aEnd=source.prevE, uid=source.prevT, flags=1, kind=1, phase=1, dir=direction, bornIndex=source.seq, confirmedAt=source.e, resolvedAt=source.e, hi=rh, lo=rl, inv=direction == 1 ? source.l : source.h, cp=direction == 1 ? rh : rl, aO=source.prevO, aH=source.prevH, aL=source.prevL, aC=source.prevC, aT=source.prevT, bO=source.o, bH=source.h, bL=source.l, bC=source.c, bT=source.t)
            fresh.crtKey := direction == 1 ? priorBuyKey : priorSellKey
            fresh.hiT := source.prevT
            fresh.loT := source.prevT
            fresh.invT := source.t
            fresh.cpT := source.prevT
            bool targetAtBirth = direction == 1 ? source.h >= fresh.cp : source.l <= fresh.cp
            if targetAtBirth
                lastRetired := fresh.uid
                retiredReason := 4
                if not archivedThisBar and f_archiveAllowed(fresh.kind)
                    lastEnded := f_archive(fresh, 4, source.e)
                    archivedThisBar := true
            else
                array.push(models, fresh)
        else
            dropped += 1



    // Entry-open CRT first; otherwise the nearest still-valid C1 for tracking.
    Model selected = Model.new()
    if array.size(models) > 0
        for i = 0 to array.size(models) - 1
            Model candidate = array.get(models, i)
            if candidate.phase == 1 and f_preferCrt(candidate.bornIndex, candidate.aT, selected.bornIndex, selected.aT, source.seq)
                selected := candidate
    priorFocusId := selected.uid
    bool historyReady = firstSeen <= scanStart
    RegistrySnapshot.new(model=selected, archive=lastEnded.copy(), retired=lastRetired, reason=retiredReason, dropped=dropped, ready=historyReady, count=array.size(models), age=source.seq - selected.bornIndex)

f_engineFromSource(simple string sourceTf, SourcePacket source) =>
    var RegistrySnapshot result = RegistrySnapshot.new(model=Model.new(), archive=ModelArchive.new())
    var int processed = na
    var int capturedStart = na
    var KeyMap frozenBias = na
    var KeyMap frozenWeekly = na
    if f_alignedTf(sourceTf) and not na(source.formingStart) and (na(capturedStart) or capturedStart != source.formingStart)
        capturedStart := source.formingStart
        frozenBias := completedBiasKeys[1]
        frozenWeekly := completedWeeklyKeys[1]
    KeyMap higherKeys = f_alignedTf(sourceTf) ? frozenBias : completedBiasKeys[1]
    KeyMap weeklyKeys = f_alignedTf(sourceTf) ? frozenWeekly : completedWeeklyKeys[1]
    if source.changed and not na(source.t) and (na(processed) or source.t > processed)
        result := f_stepRegistry(sourceTf, source, higherKeys, weeklyKeys)
        processed := source.t
    result

f_engine(simple string sourceTf) =>
    f_engineFromSource(sourceTf, f_sourcePacket(sourceTf))
f_sourceBundle(simple string sourceTf) =>
    SourcePacket source = f_sourcePacket(sourceTf)
    RegistrySnapshot registry = f_engineFromSource(sourceTf, source)
    EngineSnapshot model = EngineSnapshot.new(model=f_exportModel(registry.model), archive=registry.archive, retired=registry.retired, reason=registry.reason, dropped=registry.dropped, ready=registry.ready, count=registry.count, age=registry.age)
    KeyMap keys = f_executionFromSource(source)
    ClockPreview frame = f_sourceFrame(sourceTf)
    [model, keys, frame]
// Source packet owns the single closed-bar offset for both chart and LTF view.

[requestedMain, executionMain, mainPreview] = request.security(syminfo.tickerid, f_transportTf(htf), f_sourceBundle(htf), lookahead=f_sourceLookahead(htf), calc_bars_count=f_sourceDepth(htf))
EngineSnapshot mainSnapshot = requestedMain
ModelView mainSelected = not na(mainSnapshot) ? mainSnapshot.model : ModelView.new()
sId = mainSelected.aT
sFlags = mainSelected.flags
sKind = (not na(mainSelected.aT) ? 1 : 0)
sPhase = (not na(mainSelected.aT) ? 1 : 0)
sDir = mainSelected.dir
sHi = mainSelected.hi
sLo = mainSelected.lo
sInv = mainSelected.inv
sCp = mainSelected.cp
