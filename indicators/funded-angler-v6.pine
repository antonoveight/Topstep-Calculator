indicator("The Funded Angler v6 - CRT Key Reactions", shorttitle="TFA v6", dynamic_requests=false, calc_bars_count=150, overlay=true, scale=scale.none, behind_chart=false, max_bars_back=32, max_lines_count=500, max_boxes_count=500, max_labels_count=300)

// Source history is carried by the tape; indexed series need at most 5 bars.

// Source cap is 600; default chart work is 150 bars for strict runtime limits.
const int CONTEXT_BARS = 600
var int availableChartStart = time
const string NY = "America/New_York"
const string G_HTF = "1. Auto HTF"
const string G_BIAS = "2. Bias"
const string G_ENTRY = "3. LTF"
const string G_KEY = "3b. HTF keys"
const string G_VIEW = "4. Display"
// Pure CRT execution contract: tests/pure-crt.cjs.
// Compatibility fixtures, NOT an XAUUSD profit/drawdown optimization.
const string DEFAULT_SIGNAL_CADENCE = "Fresh reaction"
htfInput = input.timeframe("60", "HTF", options=["60", "120", "240", "1D"], group=G_HTF, tooltip="Khung xác nhận C1/C2 CRT/TS: H1, H2, H4 hoặc D1. Mặc định H1; entry theo setup CRT còn hiệu lực.", display=display.none)
htfClock = input.string("TopstepX", "H2 / H4 clock", options=["TopstepX", "Native"], group=G_HTF, tooltip="TopstepX groups this chart's OANDA H1 prices from 17:00 America/Chicago, with DST and the regular 16:00 session end. Applied to OANDA:XAUUSD only; other feeds stay native. Models, keys, Early C2 and both candle groups use that clock. These remain OANDA candles, not MGC prices. H1/D1 stay native. Holiday schedules may differ.", display=display.none)
calculationBudget = input.string("Light", "Calculation budget", options=["Light", "Full"], group=G_HTF, tooltip="Light loads 24 bars per source timeframe for strict calculation limits; Full loads 600. Calculated bars starts at 150; increase it separately when needed. Older model/key initialization can differ. Entry formulas are identical; Full can exceed a Basic account's runtime allowance.", display=display.none)
int requestDepth = calculationBudget == "Light" ? 24 : CONTEXT_BARS
// CRT Pure TS: independent confirmed main/higher models and causal LTF channels.
