sConfirmed = mainSelected.confirmedAt
sResolved = mainSelected.confirmedAt
sCount = not na(mainSnapshot) ? mainSnapshot.count : 0
sAO = mainSelected.aO
sAH = mainSelected.hi
sAL = mainSelected.lo
sAC = mainSelected.aC
sAT = mainSelected.aT
sBO = mainSelected.bO
