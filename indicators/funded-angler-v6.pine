enableLargerSignals = input.bool(true, "Larger HTF signals", group=G_ENTRY, tooltip="Chạy nhánh CRT độc lập trên Larger HTF; cùng LTF/Signal timing, range/C3/SL/TP và khóa nhịp riêng. Chỉ chạy khi Larger HTF <= Bias TF. Tắt cụm nến không tắt tín hiệu; tắt tại đây.", display=display.none)
clusterFollowCount = input.int(6, "Follow candles to show", minval=2, maxval=12, group=G_VIEW, tooltip="Cụm MODEL giữ nến gốc; cụm FOLLOW hiển thị số nến diễn biến gần nhất, mặc định 6. Nến cũ bị lược hiển thị được báo bằng dấu … và số lượng. Không đổi timeout hoặc tín hiệu.", display=display.none)
showArchive = input.bool(false, "Last ended model cluster", group=G_VIEW, tooltip="Cụm LAST giữ nến nguồn của model vừa kết thúc và mã TG/INV/TO/AMB/HIST. Chỉ để tham khảo lịch sử, không khôi phục hiệu lực hoặc phát tín hiệu. Mặc định tắt.", display=display.none)
clusterOffset = input.int(30, "Cluster offset (bars)", minval=3, maxval=80, group=G_VIEW, tooltip="Khoảng cách từ bar chart cuối đến cụm HTF, theo số bar chart. Mặc định 30 bar để cách xa cột chú thích.", display=display.none)
clusterWidth = input.int(4, "Cluster body width (bars)", minval=2, maxval=16, group=G_VIEW, tooltip="Độ rộng thân nến HTF, mặc định 4 bar. Số lẻ được làm tròn xuống số chẵn để râu luôn đúng tâm thân. Không ảnh hưởng OHLC; râu đồng bộ line mảnh 1 px.", display=display.none)
showLevels = input.bool(true, "CRT range / target / HTF key", group=G_VIEW, tooltip="CRTH/CRTL include wicks. TGT is the opposite C1 boundary; INV is the TS extreme. KEY shows its actual source type and timeframe. Lines start at the cached wick time, or the HTF source open when that wick is outside loaded chart history.", display=display.none)
showSecondary = false
showPanel = input.bool(true, "Compact panel", group=G_VIEW, tooltip="Bảng tổng quan cố định góc trên phải. TF=khung, #1=model ưu tiên, B=bias, REF=loại vùng/mức đang theo dõi, T=thời gian, S=trạng thái.", display=display.none)
historyMode = input.string("History", "Signal display", options=["History", "Latest"], group=G_VIEW, tooltip="History giữ dấu quá khứ theo giới hạn bên dưới, không xóa vì cửa sổ 3 HTF của các line. Latest chỉ giữ dấu gần nhất. Không đổi điều kiện tính toán hoặc alert.", display=display.none)
historyMarks = input.int(100, "Historical signals to keep (0 = hide)", minval=0, maxval=200, group=G_VIEW, tooltip="Mặc định 100, tối đa 200 tam giác lịch sử. 0 ẩn dấu. Các bộ đếm dashboard tính toàn bộ dữ liệu chart đã tải, có thể lớn hơn số dấu được giữ.", display=display.none)
bool retainHistory = historyMode == "History"
int markLimit = historyMarks == 0 ? 0 : retainHistory ? historyMarks : 2
recentOnly = input.bool(true, "Hide drawings without a recent signal", group=G_VIEW, tooltip="Ẩn phần vẽ quá cửa sổ gần nhất. Cụm HTF gần đây có thể hiện trước entry LTF để xem tổng quan; không có nghĩa đã có lệnh.", display=display.none)
drawHtfBars = input.int(3, "Drawing horizon / recency (HTF bars)", minval=1, maxval=12, group=G_VIEW, tooltip="Giới hạn phần chiếu về trước và tuổi hình, mặc định 3 HTF. Đầu line vẫn nối về swing nguồn cũ. Không hủy hiệu lực model.", display=display.none)
showEntryTriangles = true
chartTextSize = input.string("Normal", "Chart text size", options=["Small", "Normal", "Large", "Huge"], group=G_VIEW, tooltip="Normal tăng hai mức so với Tiny trước đây. Áp dụng cho nhãn mức giá, HTF key, caption HTF và đồng hồ; không đổi tọa độ giá.", display=display.none)
dashboardTextSize = input.string("Small", "Dashboard text size", options=["Small", "Normal", "Large"], group=G_VIEW, tooltip="Small lớn hơn một mức so với dashboard cũ. Chọn Normal khi chia đôi màn hình hoặc live.", display=display.none)
string chartFont = chartTextSize == "Small" ? size.small : chartTextSize == "Large" ? size.large : chartTextSize == "Huge" ? size.huge : size.normal
string dashboardFont = dashboardTextSize == "Large" ? size.large : dashboardTextSize == "Normal" ? size.normal : size.small

float chartSeconds = timeframe.in_seconds(timeframe.main_period)
float htfSeconds = timeframe.in_seconds(htf)
bool onHtf = chartSeconds == htfSeconds
bool isLtf = chartSeconds < htfSeconds and (chartSeconds == 60 or chartSeconds == 180 or chartSeconds == 300 or chartSeconds == 900)
float sweepSize = syminfo.mintick * minSweepTicks
float tolerance = syminfo.mintick * retestTicks
const string CT = "America/Chicago"
f_alignedTf(simple string sourceTf) =>
    htfClock == "TopstepX" and ticker.standard(syminfo.main_tickerid) == "OANDA:XAUUSD" and (sourceTf == "120" or sourceTf == "240")
f_transportTf(simple string sourceTf) =>
    f_alignedTf(sourceTf) ? "60" : sourceTf
f_sourceDepth(simple string sourceTf) =>
    requestDepth * (f_alignedTf(sourceTf) ? int(timeframe.in_seconds(sourceTf) / 3600) : 1) + 2
f_sourceLookahead(simple string sourceTf) =>
    f_alignedTf(sourceTf) and chartSeconds > 3600 ? barmerge.lookahead_off : barmerge.lookahead_on
// Pine's session bars use the supplied timezone, including DST and the short tail.
const string CLOCK_SESSION = "1700-1600:23456"
f_sessionTimes(simple string sourceTf) =>
    [time(sourceTf, CLOCK_SESSION, CT), time_close(sourceTf, CLOCK_SESSION, CT)]
if barstate.isfirst and (not chart.is_standard or na(chartSeconds) or chartSeconds > htfSeconds or htfSeconds % chartSeconds != 0 or timeframe.in_seconds(biasTf) < htfSeconds)
    runtime.error("Use a standard chart TF dividing HTF; effective HTF <= Bias TF. Higher charts use their own TF as VIEW.")

f_endTag(int reason) =>
    reason == 1 ? "INV" : reason == 2 ? "TG" : reason == 3 ? "TO" : reason == 4 ? "AMB" : reason == 5 ? "HIST" : reason == 6 ? "CAP" : reason == 7 ? "EXP" : "WAIT"
f_has(int flags, int bit) =>
    int(math.floor(flags / bit)) % 2 == 1
f_patterns(float c1o, float c1h, float c1l, float c1c, float c2o, float c2h, float c2l, float c2c) =>
    float lowRef = tsReference == "C1 range" ? c1l : manualSsl > 0 ? manualSsl : na
    float highRef = tsReference == "C1 range" ? c1h : manualBsl > 0 ? manualBsl : na
    bool tookLow = not na(lowRef) and c2l <= lowRef - sweepSize
    bool tookHigh = not na(highRef) and c2h >= highRef + sweepSize
    bool reclaimed = c2c > c1l and c2c < c1h
    bool sweptBothC1 = c2l <= c1l - sweepSize and c2h >= c1h + sweepSize
    bool doubleSweep = sweptBothC1 or (tookLow and tookHigh)
    bool tsBull = tookLow and not doubleSweep and reclaimed and c2c > lowRef
    bool tsBear = tookHigh and not doubleSweep and reclaimed and c2c < highRef
    [tsBull, tsBear]

type BiasState
    int direction = 0
    int age = 0
    float swingHigh = na
    float swingLow = na
    float protectedHigh = na
    float protectedLow = na

// Only confirmed pivots and closes in the bias timeframe reach this state machine.
f_biasStep(BiasState state, float ph, float pl, float closing, float priorClose) =>
    state.age += 1
    if not na(ph)
        state.swingHigh := ph
    if not na(pl)
        state.swingLow := pl
    bool brokeHigh = not na(state.swingHigh) and closing > state.swingHigh and priorClose <= state.swingHigh
    bool brokeLow = not na(state.swingLow) and closing < state.swingLow and priorClose >= state.swingLow
    bool lostBull = state.direction == 1 and not na(state.protectedLow) and closing < state.protectedLow
    bool lostBear = state.direction == -1 and not na(state.protectedHigh) and closing > state.protectedHigh
    int nextDirection = brokeHigh or lostBear ? 1 : brokeLow or lostBull ? -1 : 0
    if nextDirection != 0 and not (brokeHigh and brokeLow)
        if state.direction != nextDirection
            state.age := 0
        state.direction := nextDirection
        state.protectedLow := nextDirection == 1 ? state.swingLow : na
        state.protectedHigh := nextDirection == -1 ? state.swingHigh : na
    // Trail only with confirmed structural swings; a single opposing candle is insufficient.
    if state.direction == 1 and not na(pl)
        state.protectedLow := na(state.protectedLow) ? pl : math.max(state.protectedLow, pl)
    if state.direction == -1 and not na(ph)
        state.protectedHigh := na(state.protectedHigh) ? ph : math.min(state.protectedHigh, ph)

f_biasCore() =>
    var BiasState state = BiasState.new()
    float ph = ta.pivothigh(high, htfPivotLength, htfPivotLength)
    float pl = ta.pivotlow(low, htfPivotLength, htfPivotLength)
    f_biasStep(state, ph, pl, close, close[1])
    float guardHigh = state.direction == -1 and not na(state.protectedHigh) ? math.min(high, state.protectedHigh) : high
    float guardLow = state.direction == 1 and not na(state.protectedLow) ? math.max(low, state.protectedLow) : low
    [state.direction, state.age, state.swingHigh, state.swingLow, guardHigh, guardLow]
f_biasSnapshot(bool previous) =>
    [direction, age, swingHigh, swingLow, guardHigh, guardLow] = f_biasCore()
    [previous ? direction[1] : direction, previous ? age[1] : age, previous ? swingHigh[1] : swingHigh, previous ? swingLow[1] : swingLow, previous ? guardHigh[1] : guardHigh, previous ? guardLow[1] : guardLow]

// All registry decisions execute IN the selected HTF, never from chart/LTF bars.
