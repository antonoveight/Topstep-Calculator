sCC = mainSelected.cC
sCT = mainSelected.cT
sRetired = not na(mainSnapshot) ? mainSnapshot.retired : na
sReason = not na(mainSnapshot) ? mainSnapshot.reason : 0
sDropped = not na(mainSnapshot) ? mainSnapshot.dropped : 0
sReady = not na(mainSnapshot) ? mainSnapshot.ready : false
sModelAge = not na(mainSnapshot) ? mainSnapshot.age : na
sHiT = mainSelected.aT
sLoT = mainSelected.aT
sInvT = mainSelected.bT
sCpT = mainSelected.aT
int sErlUT = na
int sErlLT = na
