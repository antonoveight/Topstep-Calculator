plot(crtResult.hit ? crtResult.cp : na, "CRT target at signal", display=display.data_window)
plot(crtResult.hit ? crtResult.inv : na, "CRT invalidation at signal", display=display.data_window)
plot(crtResult.hit ? crtResult.id : na, "TFA audit model id", display=display.data_window)
plot(crtResult.hit ? crtResult.confirmTime : na, "TFA audit TS open ms", display=display.data_window)
plot(crtResult.hit ? crtResult.zoneKnownAt : na, "CRT zone known ms", display=display.data_window)
plot(crtResult.hit ? crtResult.zoneLow : na, "CRT zone low", display=display.data_window)
plot(crtResult.hit ? crtResult.zoneHigh : na, "CRT zone high", display=display.data_window)
plot(crtResult.hit ? crtState.branchMask : na, "CRT branch mask TS1 FVG2 OTE4 cumulative", display=display.data_window)
plot(crtResult.hit and not na(crtResult.keyRef) ? crtResult.keyRef.kind : na, "CRT key type FVG1 OB2 Swing3 Open4 Close5 WW6", display=display.data_window)
plot(crtResult.hit and not na(crtResult.keyRef) ? crtResult.keyRef.knownAt : na, "CRT key known ms", display=display.data_window)
