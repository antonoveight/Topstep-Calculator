bool overviewMode = timeframe.in_seconds(timeframe.main_period) > timeframe.in_seconds(htfInput)
string htf = overviewMode ? timeframe.main_period : htfInput
minSweepTicks = 1
scanDepth = CONTEXT_BARS
queueLimit = 12
// INV/TP retire attempts. Source C3 and later fresh reactions remain distinct.
lifeHtf = 0
htfPivotLength = 2
tsReference = "C1 range"
manualSsl = 0.0
manualBsl = 0.0
