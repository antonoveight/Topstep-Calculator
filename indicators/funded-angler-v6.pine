showLargerCluster = input.bool(true, "Larger HTF candle cluster", group=G_VIEW, tooltip="Thêm cụm OHLC HTF lớn hơn bên cạnh cụm chính; bật/tắt hình không đổi nhánh tín hiệu Larger HTF signals hoặc bias. Wick và body lấy đúng nguồn giá.", display=display.none)
largerTfChoice = input.string("Auto", "Larger HTF", options=["Auto", "H2", "H4", "D1", "W1"], group=G_VIEW, tooltip="Auto: H1/H2 → H4; H4 → D1; D1 → W1. Chọn khung lớn hơn HTF chính; nếu khung chọn không lớn hơn thì dùng Auto.", display=display.none)
