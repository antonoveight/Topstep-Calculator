minSweepTicks = 1
scanDepth = 1000
queueLimit = 12
// Setups retire at INV/TP or the end of C3; no stale context timeout/fallback.
lifeHtf = 0
htfPivotLength = 2
tsReference = "C1 range"
manualSsl = 0.0
manualBsl = 0.0
biasTf = input.timeframe("1D", "Bias TF (>= HTF)", options=["60", "120", "240", "1D"], group=G_BIAS, tooltip="Khung bias từ H1 đến D1, phải >= HTF hiệu lực. Mặc định D1; không đồng nghĩa bias cá nhân đọc từ FRVP/day high-low.")
biasMode = input.string("Auto", "Bias", options=["Auto", "Long", "Short", "Neutral"], group=G_BIAS, tooltip="Auto dùng close phá swing xác nhận trên Bias TF; giữ hướng đến khi cấu trúc đổi. B0! tạm chặn theo close chart xuyên guard ngược hướng, không tự coi là bias đối diện. Long/Short/Neutral là ý kiến chủ động của bạn; reset khi bối cảnh thay đổi.")
filterBias = true
allowCrtCounter = input.bool(true, "CRT reversal at prior HTF key", group=G_ENTRY, tooltip="CRT ngược bias cần sweep/reclaim swing HTF đã biết trước C1. Sau đó cần TS LTF và retest trong C3. Không đổi bias tổng thể; B0/B0! vẫn chặn.")
signalCadence = input.string(DEFAULT_SIGNAL_CADENCE, "Signal cadence", options=["Fresh reaction", "One per model"], group=G_ENTRY, tooltip="Fresh reaction cần TS LTF mới sau dấu trước, tiến triển cực trị và pivot hồi mới đã xác nhận. One per model chỉ một dấu trong C3.")
signalTiming = input.string(DEFAULT_SIGNAL_TIMING, "Signal timing", options=["Pullback", "Confirmation close"], group=G_ENTRY, tooltip="Pullback: sau TS LTF đã đóng, đợi nến sau retest biên C1 LTF và đóng đúng phía, giữ cực trị TS. Confirmation close: dấu ngay nến TS đóng. Hai nến TS đều phải nằm trong C3 HTF.")
enableEarlyC2 = input.bool(true, "Early C2 · experimental", group=G_ENTRY, tooltip="Bật thử theo yêu cầu: key swing cùng HTF đã biết trước C1, C2 raid/reclaim thật rồi TS LTF và retest. Chỉ dùng nến LTF đã đóng trước lúc C2 đóng, tối đa một dấu E mỗi C2. Chưa xác nhận CRT HTF; E không đổi thành dấu C3 hồi tố. Tắt để chỉ xem C3.")
