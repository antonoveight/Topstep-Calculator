clusterWidth = input.int(4, "Cluster body width (bars)", minval=2, maxval=16, group=G_VIEW, tooltip="Độ rộng thân nến HTF, mặc định 4 bar. Số lẻ được làm tròn xuống số chẵn để râu luôn đúng tâm thân. Không ảnh hưởng OHLC; râu đồng bộ line mảnh 1 px.")
showLevels = input.bool(true, "Model range / ERL / CP", group=G_VIEW, tooltip="Các mức nối từ nến tạo cực trị/swing tương ứng, không từ nến tín hiệu. EQ 50% dùng neo tổng quan. Nếu nguồn không có trong dữ liệu chart hoặc chưa có ERL hợp lệ thì không ghim giả. Tắt chỉ ẩn line, không đổi tín hiệu.")
showIrl = input.bool(true, "HTF internal references", group=G_VIEW, tooltip="FVG, OB và swing nội bộ C1 được hiển thị khi có nguồn HTF hợp lệ. FVG neo nến đầu bộ ba, chỉ biết sau close nến thứ ba. OB neo nến nguồn nhưng chỉ xuất hiện sau xác nhận cấu trúc. Đây là tham chiếu, không tự tạo entry hay đổi hướng CRT.")
